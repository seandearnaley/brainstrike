{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["tsconfig.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^build"],
			"cache": true,
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.tsx", "test/**/*.ts", "__tests__/**/*.tsx", "__tests__/**/*.ts"]
		},
		"test:coverage": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"],
			"inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.tsx", "test/**/*.ts", "__tests__/**/*.tsx", "__tests__/**/*.ts"]
		},
		"test:e2e": {
			"dependsOn": ["build"],
			"outputs": ["test-results/**", "playwright-report/**"],
			"inputs": ["e2e/**/*.ts", "src/**/*.tsx", "src/**/*.ts"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"clean": {
			"cache": false
		},
		"type-check": {
			"outputs": [],
			"inputs": ["src/**/*.tsx", "src/**/*.ts"]
		},
		"coverage:merge": {
			"dependsOn": ["^test:coverage"],
			"outputs": ["coverage-merged/**"],
			"cache": false
		},
		"coverage:report": {
			"dependsOn": ["coverage:merge"],
			"outputs": ["coverage-report/**"],
			"cache": false
		}
	}
}
