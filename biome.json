{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "./biome.base.json"
  ],
  "plugins": [
    "node_modules/@jacobwolf/biome-unnecessary-effect/grit/react-effects.grit"
  ],
  "linter": {
    "rules": {
      "nursery": {
        "noFloatingPromises": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "style": {
        "useConsistentEnumValueType": "error",
        "useDomQuerySelector": "off",
        "useNamedCaptureGroup": "off",
        "useThisInClassMethods": "off"
      },
      "suspicious": {
        "noLoopFunc": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/file-explorer-ui/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@brainstrike/file-explorer-ui": "Import the owning module directly; the package barrel is for consumers."
                },
                "patterns": [
                  {
                    "group": ["@brainstrike/file-explorer-ui/**"],
                    "message": "Import the owning module directly; package subpaths are for consumers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/file-explorer-ui/src/context-actions/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Context actions are defined at init in their own Vite chunk; renderer hooks pull the shared UI graph into it."
                },
                "patterns": [
                  {
                    "group": ["@brainstrike/ui", "@brainstrike/ui/**"],
                    "message": "Context actions are defined at init in their own Vite chunk; the UI package pulls the shared UI graph into it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/app-shell/src/assistant-chat-panel.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@brainstrike/assistant-ui": "This panel renders eagerly; the root barrel pulls the lazy assistant panel into the first-paint chunk. Import the narrow subpath."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/e2e/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          },
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      "includes": ["**/__tests__/**", "**/*.test.*", "**/*.stories.*"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/shadcn-theme-fixture/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "scripts/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/workers/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/effect-kit/**",
        "packages/assistant-contract/**",
        "packages/agent-host/**",
        "packages/agent/src/tools/**",
        "packages/agent/src/__tests__/native-tool-input-schema-catalog.spec.ts",
        "packages/agent/src/__tests__/tool-model-output.spec.ts",
