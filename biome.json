{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/react",
    "ultracite/biome/core",
    "ultracite/biome/react"
  ],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**/src/**/*.{ts,tsx,js,jsx}",
      "packages/**/src/**/*.{ts,tsx,js,jsx}",
      "**/*.config.{ts,mts}",
      "**/*.test.{ts,tsx}",
      "**/e2e/**/*.{ts,tsx}",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/build",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.vite",
      "!**/.nyc_output",
      "!**/blob-report",
      "!**/.stryker-tmp",
      "!**/reports",
      "!**/*.db",
      "!**/*.json",
      "!**/*.jsonc",
      "!**/*.css",
      "!**/*.md",
      "!**/*.html",
      "!.claude",
      "!.pnpm-store",
      "!**/*.bundled_*.mjs"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "filenameCases": ["kebab-case"]
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false
          }
        },
        "noNestedTernary": "off",
        "noParameterProperties": "off",
        "noExportedImports": "off",
        "useConsistentMemberAccessibility": "off",
        "useDefaultSwitchClause": "off",
        "noIncrementDecrement": "off"
      },
      "suspicious": {
        "noConsole": "error",
        "noEmptyBlockStatements": "off",
        "useAwait": "off",
        "noBitwiseOperators": "off",
        "noEvolvingTypes": "off",
        "noLeakedRender": "off",
        "noShadow": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noForEach": "off",
        "noVoid": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    },
    "globals": [
      "React",
      "describe",
      "it",
      "test",
      "expect",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "vi",
      "jest",
      "Electron"
    ]
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**", "**/*.test.*", "**/*.stories.*"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "filenameCases": ["kebab-case"]
              }
            },
            "useNamingConvention": "off",
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noNonNullAssertedOptionalChain": "off",
            "noExplicitAny": "off",
            "noConsole": "off",
            "noMisplacedAssertion": "off"
          },
          "correctness": {
            "noUnusedVariables": "error",
            "useUniqueElementIds": "off",
            "useParseIntRadix": "error"
          },
          "complexity": {
            "useLiteralKeys": "off",
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "filenameCases": ["kebab-case"]
              }
            }
          },
          "correctness": {
            "noUnusedVariables": "error",
            "noEmptyPattern": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off",
            "noSkippedTests": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "**/global.d.ts", "**/env.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off",
            "useNodejsImportProtocol": "off",
            "noNamespace": "off"
          },
          "correctness": {
            "noUnusedVariables": "warn"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/**",
        "packages/ui/**",
        "packages/file-explorer-ui/**",
        "packages/file-explorer-hooks/**",
        "packages/app-shell/**",
        "packages/preferences/**",
        "packages/db-explorer/**",
        "packages/vector-management/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off",
            "useUniqueElementIds": "off",
            "noNestedComponentDefinitions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/constants/**",
        "**/use-toast.ts",
        "**/logger.ts",
        "**/setup-security.ts",
        "**/vitest.setup.ts",
        "**/use-tab-manager.ts",
        "**/migration-runner.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          },
          "suspicious": {
            "noConsole": "off"
          },
          "correctness": {
            "useHookAtTopLevel": "off"
          },
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/**",
        "packages/file-explorer-ui/src/loading-overlay.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noParameterAssign": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/e2e/performance/**",
        "**/e2e/**/performance-*",
        "**/e2e/ipc-communication.test.ts",
        "**/e2e/report-folder-summary.test.ts",
        "**/e2e/layout-persistence.test.ts",
        "**/e2e/utils/performance-config.ts",
        "**/e2e/real-world-performance.test.ts",
        "**/e2e/utils/layout-helpers.ts",
        "**/e2e/**/layout-helpers.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noAssignInExpressions": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/types/**"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/db/**",
        "packages/token-cache/**",
        "**/db-main.ts",
        "**/ipc-handlers.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/tailwind.config.js",
        "**/tailwind.config.ts",
        "packages/tailwind-config/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/vitest.setup.ts", "**/vitest.setup.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useReactFunctionComponents": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "scripts/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/workers/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/queue-telemetry-collector/test/**",
        "packages/embedding-worker/test/**",
        "packages/queue/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ],
  "plugins": [
    "node_modules/@jacobwolf/biome-unnecessary-effect/grit/react-effects.grit"
  ],
  "vcs": {
    "enabled": false
  }
}
