{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**/src/**/*.{ts,tsx,js,jsx}",
      "packages/**/src/**/*.{ts,tsx,js,jsx}",
      "**/*.config.{ts,mts}",
      "**/*.test.{ts,tsx}",
      "**/e2e/**/*.{ts,tsx}",
      "!!spikes/m0-a1-qualification/original",
      "!!.muse/worktrees",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/build",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.vite",
      "!**/.nyc_output",
      "!**/blob-report",
      "!**/.stryker-tmp",
      "!**/reports",
      "!**/*.db",
      "!**/*.json",
      "!**/*.jsonc",
      "packages/assistant-contract/src/provider-catalog.json",
      "!**/*.css",
      "!**/*.md",
      "!**/*.html",
      "!.claude",
      "!.pnpm-store",
      "!**/*.bundled_*.mjs"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 1000
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "filenameCases": ["kebab-case"]
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false
          }
        },
        "noNestedTernary": "off",
        "noParameterProperties": "off",
        "noExportedImports": "off",
        "useConsistentMemberAccessibility": "off",
        "useDefaultSwitchClause": "off",
        "noIncrementDecrement": "off",
        "useConsistentMethodSignatures": "off",
        "useDestructuring": "off",
        "useErrorCause": "off",
        "useForOf": "off"
      },
      "suspicious": {
        "noConsole": "error",
        "noEmptyBlockStatements": "off",
        "useAwait": "off",
        "noBitwiseOperators": "off",
        "noEvolvingTypes": "off",
        "noLeakedRender": "off",
        "noNestedPromises": "off",
        "noReturnAssign": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "useArraySortCompare": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noForEach": "off",
        "noVoid": "off",
        "noRedundantDefaultExport": "off",
        "noStaticOnlyClass": "off",
        "noUselessReturn": "off",
        "useArrayFind": "off"
      },
      "correctness": {
        "noUnusedInstantiation": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noBarrelFile": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    },
    "globals": [
      "React",
      "describe",
      "it",
      "test",
      "expect",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "vi",
      "jest",
      "Electron",
      "__BRAINSTRIKE_BUILD_ID__"
    ]
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**", "**/*.test.*", "**/*.stories.*"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "filenameCases": ["kebab-case"]
              }
            },
            "useNamingConvention": "off",
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noNonNullAssertedOptionalChain": "off",
            "noExplicitAny": "off",
            "noConsole": "off",
            "noMisplacedAssertion": "off"
          },
          "correctness": {
            "noUnusedVariables": "error",
            "useUniqueElementIds": "off",
            "useParseIntRadix": "error"
          },
          "complexity": {
            "useLiteralKeys": "off",
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "filenameCases": ["kebab-case"]
              }
            }
          },
          "correctness": {
            "noUnusedVariables": "error",
            "noEmptyPattern": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off",
            "noSkippedTests": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "**/global.d.ts", "**/env.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off",
            "useNodejsImportProtocol": "off",
            "noNamespace": "off"
          },
          "correctness": {
            "noUnusedVariables": "warn"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/host-capabilities/src/hooks/**",
        "packages/host-capabilities/__tests__/hooks/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
