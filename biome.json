          "suspicious": {
            "noExplicitAny": "off",
            "noAssignInExpressions": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/types/**"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/db/**",
        "packages/token-cache/**",
        "**/db-main.ts",
        "**/ipc-handlers.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/vitest.setup.ts", "**/vitest.setup.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useReactFunctionComponents": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "scripts/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/workers/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/embedding-worker/test/**",
        "packages/queue/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
