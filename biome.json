{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "extends": ["./packages/config/biome/biome.json"],
  "files": {
    "include": [
      "apps/**/src/**/*",
      "packages/**/src/**/*",
      // top‑level configs and tests
      "**/*.config.{ts,mts}",
      "**/*.test.{ts,tsx}"
    ],
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.turbo/**",
      "**/build/**",
      "**/coverage/**"
    ]
  }
}
