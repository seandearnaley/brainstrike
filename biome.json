        "apps/desktop/src/__tests__/assistant-server/manage-task-list-tool.test.ts",
        "scripts/__tests__/agent-quality-lint*",
        "scripts/__tests__/isolated/agent-quality-lint*"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "error",
            "noMisusedPromises": "error",
            "useExhaustiveSwitchCases": "error"
          },
          "correctness": {
            "noPrivateImports": "error"
          }
        }
      }
    },
    {
      "includes": [
        "packages/effect-kit/**",
        "packages/assistant-contract/src/native-tools/schemas/**"
