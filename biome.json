{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "files": {
    "includes": [
      "apps/**/src/**/*",
      "packages/**/src/**/*",
      "**/*.config.{ts,mts}",
      "**/*.test.{ts,tsx}",
      "!**/e2e",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/build",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.vite",
      "!**/.nyc_output",
      "!**/blob-report",
      "!**/*.db"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUndeclaredVariables": "error",
        "noUnusedFunctionParameters": "error",
        "useValidForDirection": "error",
        "useYield": "error",
        "noUnreachable": "error",
        "useHookAtTopLevel": "error",
        "noReactPropAssignments": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDebugger": "error",
        "noDuplicateParameters": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["log", "error", "warn", "info", "debug"]
          }
        }
      },
      "style": {
        "useConst": "error",
        "noInferrableTypes": "error",
        "useNodejsImportProtocol": "error",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noUselessElse": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "useLiteralKeys": "off"
      },
      "performance": {
        "noDelete": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    },
    "globals": [
      "React",
      "describe",
      "it",
      "test",
      "expect",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "vi",
      "jest",
      "Electron"
    ]
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**", "**/*.test.*", "**/*.stories.*"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "filenameCases": ["kebab-case"]
              }
            },
            "useNamingConvention": "off"
          },
          "correctness": {
            "noUnusedVariables": "error",
            "useUniqueElementIds": "off",
            "useParseIntRadix": "error"
          },
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "filenameCases": ["kebab-case"]
              }
            }
          },
          "correctness": {
            "noUnusedVariables": "error"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "**/global.d.ts", "**/env.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off",
            "useNodejsImportProtocol": "off",
            "noNamespace": "off"
          },
          "correctness": {
            "noUnusedVariables": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/**",
        "packages/ui/**",
        "packages/file-explorer-ui/**",
        "packages/file-explorer-hooks/**",
        "packages/app-shell/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off",
            "useUniqueElementIds": "off",
            "noNestedComponentDefinitions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/constants/**",
        "**/use-toast.ts",
        "**/logger.ts",
        "**/*.config.js",
        "**/*.config.{ts,mts}",
        "**/setup-security.ts",
        "**/vitest.setup.ts",
        "**/use-tab-manager.ts",
        "**/migration-runner.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          },
          "suspicious": {
            "noConsole": "off"
          },
          "correctness": {
            "useHookAtTopLevel": "off"
          },
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/**", "packages/file-explorer-ui/src/loading-overlay.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noParameterAssign": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/db/**", "**/db-main.ts", "**/ipc-handlers.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": false
  }
}
