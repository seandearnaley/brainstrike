{
  "extends": "./packages/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@brainstrike/*": ["packages/*/src"],
      "@/*": ["apps/web/src/*"]
    },
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": [],
  "exclude": ["node_modules", ".turbo", "dist"],
  "references": [
    {"path": "./apps/web"},
    {"path": "./packages/hooks"},
    {"path": "./packages/types"},
    {"path": "./packages/ui"},
    {"path": "./packages/utils"}
  ]
}