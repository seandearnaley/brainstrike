{
  "extends": "./packages/config/tsconfig/base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "declarationMap": false,
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".turbo",
    "dist"
  ]
}
