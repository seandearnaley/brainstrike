{
  "extends": "./packages/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@brainstrike/types": ["packages/types/src"],
      "@brainstrike/hooks": ["packages/hooks/src"],
      "@brainstrike/ui": ["packages/ui/src"],
      "@brainstrike/utils": ["packages/utils/src"],
      "@brainstrike/file-explorer": ["packages/file-explorer/src"],
      "@brainstrike/file-explorer-hooks": ["packages/file-explorer-hooks/src"],
      "@brainstrike/file-explorer-ui": ["packages/file-explorer-ui/src"],
      "@brainstrike/storage": ["packages/storage/src"],
      "@brainstrike/workers": ["packages/workers"],
      "@web/*": ["apps/web/src/*"],
      "@desktop/*": ["apps/desktop/src/*"]
    },
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": [],
  "exclude": ["node_modules", ".turbo", "dist"],
  "references": [
    {"path": "./apps/web"},
    {"path": "./packages/hooks"},
    {"path": "./packages/types"},
    {"path": "./packages/ui"},
    {"path": "./packages/utils"},
    {"path": "./packages/file-explorer-hooks"},
    {"path": "./packages/file-explorer-ui"},
    {"path": "./packages/storage"}
  ]
}
