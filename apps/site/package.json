{
  "name": "@brainstrike/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "vite build",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "vite --host 127.0.0.1 --port 4174",
    "lint": "pnpm -w lint",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "vitest run --pool=threads --exclude \"**/*.integration.test.*\"",
    "test:coverage": "vitest run --pool=threads --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
