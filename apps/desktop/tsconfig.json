{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "apiStabilityLeak": "error",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingStarInYieldEffectGen": "error",
          "promiseInEffectSuccess": "error",
          "returnEffectInGen": "error",
          "unsafeEffectTypeAssertion": "error",
          "experimentalApiUsage": "error",
          "unstableApiUsage": "error"
        },
        "overrides": [
          {
            "include": [
              "src/__tests__/host-permission-policy.test.ts",
              "src/__tests__/agent-host-desktop-host-tools.test.ts",
              "src/__tests__/effect-transferred-ports.test.ts",
              "src/__tests__/host-thread-debug.test.ts",
              "src/__tests__/use-host-thread-usage.test.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "preferTypedSchemaDecoder": "error"
              }
            }
          }
        ]
      }
    ],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "electron",
      "vite/client"
    ],
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "index.html"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "e2e/**/*",
    "playwright.config.mts",
    "src/**/__tests__/**",
    "src/**/*.test.*",
    "src/**/*.spec.*"
  ]
}
