{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "types": [
      "node",
      "electron",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@brainstrike/agent": [
        "../../packages/agent/dist/index.d.ts"
      ],
      "@brainstrike/agent/client": [
        "../../packages/agent/dist/client.d.ts"
      ],
      "@brainstrike/queue": [
        "../../packages/queue/src/index.ts"
      ],
      "@brainstrike/ui": [
        "../../packages/ui/src"
      ],
      "@brainstrike/types": [
        "../../packages/types/src"
      ],
      "@brainstrike/utils": [
        "../../packages/utils/src"
      ],
      "@brainstrike/db": [
        "../../packages/db/src"
      ],
      "@brainstrike/storage": [
        "../../packages/storage/src"
      ],
      "@brainstrike/file-system": [
        "../../packages/file-system/src"
      ],
      "@brainstrike/file-explorer-ui": [
        "../../packages/file-explorer-ui/src"
      ],
      "@brainstrike/file-explorer-hooks": [
        "../../packages/file-explorer-hooks/src"
      ],
      "@brainstrike/file-import": [
        "../../packages/file-import/src"
      ],
      "@brainstrike/app-shell": [
        "../../packages/app-shell/src"
      ],
      "@brainstrike/preferences": [
        "../../packages/preferences/src"
      ],
      "@brainstrike/embeddings": [
        "../../packages/embeddings/src"
      ],
      "@brainstrike/vector-management": [
        "../../packages/vector-management/src"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "index.html"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "e2e/**/*",
    "playwright.config.ts",
    "src/**/__tests__/**",
    "src/**/*.test.*",
    "src/**/*.spec.*"
  ],
  "references": [
    {
      "path": "../../packages/app-shell"
    },
    {
      "path": "../../packages/db"
    },
    {
      "path": "../../packages/queue"
    }
  ]
}