{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "types": ["node", "electron", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@brainstrike/agent": ["../../packages/agent/dist/index.d.ts"],
      "@brainstrike/agent/client": ["../../packages/agent/dist/client.d.ts"],
      "@brainstrike/queue": ["../../packages/queue/src/index.ts"]
    }
  },
  "include": ["src/**/*", "index.html"],
  "exclude": [
    "node_modules",
    "dist",
    "e2e/**/*",
    "playwright.config.ts",
    "src/**/__tests__/**",
    "src/**/*.test.*",
    "src/**/*.spec.*"
  ],
  "references": [
    { "path": "../../packages/app-shell" },
    { "path": "../../packages/db" },
    { "path": "../../packages/queue" }
  ]
}
