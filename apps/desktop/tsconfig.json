{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "outDir": "dist",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": []
  },
  "include": [
    "src",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.unit.ts",
    "vitest.config.integration.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage"
  ],
  "references": [
    {
      "path": "../../packages/app-shell"
    },
    {
      "path": "../../packages/fonts"
    },
    {
      "path": "../../packages/hooks"
    },
    {
      "path": "../../packages/server-config"
    },
    {
      "path": "../../packages/types"
    },
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/utils"
    },
    {
      "path": "../../packages/file-explorer"
    },
    {
      "path": "../../packages/file-explorer-hooks"
    },
    {
      "path": "../../packages/file-explorer-ui"
    }
  ]
}
