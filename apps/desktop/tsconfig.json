{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "types": [
      "node",
      "electron",
      "vite/client"
    ],
    "paths": {
      "@brainstrike/assistant-service/local-provider-runtime": [
        "../../packages/assistant-service/src/local-provider-runtime.ts"
      ],
      "@brainstrike/assistant-service/memory-model-targets": [
        "../../packages/assistant-service/src/memory-model-targets.ts"
      ],
      "@brainstrike/assistant-service/ports": [
        "../../packages/assistant-service/src/ports.ts"
      ],
      "@brainstrike/assistant-service/request": [
        "../../packages/assistant-service/src/request.ts"
      ],
      "@brainstrike/assistant-service/run-turn": [
        "../../packages/assistant-service/src/run-turn.ts"
      ],
      "@brainstrike/assistant-service/secret-errors": [
        "../../packages/assistant-service/src/secret-errors.ts"
      ],
      "@brainstrike/assistant-service/steering": [
        "../../packages/assistant-service/src/steering.ts"
      ],
      "@brainstrike/assistant-service/types": [
        "../../packages/assistant-service/src/types.ts"
      ],
      "@brainstrike/agent": [
        "../../packages/agent/dist/index.d.ts"
      ],
      "@brainstrike/agent/client": [
        "../../packages/agent/dist/client.d.ts"
      ],
      "@brainstrike/agent/mcp-client": [
        "../../packages/agent/dist/mcp-client.d.ts"
      ],
      "@brainstrike/agent/local-llm": [
        "../../packages/agent/dist/local-llm.d.ts"
      ],
      "@brainstrike/queue": [
        "../../packages/queue/src/index.ts"
      ],
      "@brainstrike/queue/browser": [
        "../../packages/queue/src/browser.ts"
      ],
      "@brainstrike/ui": [
        "../../packages/ui/src"
      ],
      "@brainstrike/types": [
        "../../packages/types/src"
      ],
      "@brainstrike/utils": [
        "../../packages/utils/src"
      ],
      "@brainstrike/utils/*": [
        "../../packages/utils/src/*"
      ],
      "@brainstrike/db": [
        "../../packages/db/src"
      ],
      "@brainstrike/storage": [
        "../../packages/storage/src"
      ],
      "@brainstrike/storage/electron": [
        "../../packages/storage/src/electron.ts"
      ],
      "@brainstrike/file-system": [
        "../../packages/file-system/src"
      ],
      "@brainstrike/file-system/electron": [
        "../../packages/file-system/src/electron.ts"
      ],
      "@brainstrike/file-system/path-validation": [
        "../../packages/file-system/src/path-validation.ts"
      ],
      "@brainstrike/file-explorer-ui": [
        "../../packages/file-explorer-ui/src"
      ],
      "@brainstrike/file-explorer-ui/*": [
        "../../packages/file-explorer-ui/src/*"
      ],
      "@brainstrike/file-explorer-hooks": [
        "../../packages/file-explorer-hooks/src"
      ],
      "@brainstrike/file-import": [
        "../../packages/file-import/src"
      ],
      "@brainstrike/file-import/browser-queue-port": [
        "../../packages/file-import/src/browser-queue-port.ts"
      ],
      "@brainstrike/file-import/chunking-worker-context": [
        "../../packages/file-import/src/chunking-worker-context.tsx"
      ],
      "@brainstrike/file-import/enhanced-import": [
        "../../packages/file-import/src/enhanced-import.ts"
      ],
      "@brainstrike/app-shell": [
        "../../packages/app-shell/src"
      ],
      "@brainstrike/app-shell/assistant-memory-repository": [
        "../../packages/app-shell/src/assistant-memory-repository.ts"
      ],
      "@brainstrike/platform-utils": [
        "../../packages/platform-utils/src"
      ],
      "@brainstrike/preferences": [
        "../../packages/preferences/src"
      ],
      "@brainstrike/preferences/*": [
        "../../packages/preferences/src/*"
      ],
      "@brainstrike/embeddings": [
        "../../packages/embeddings/src"
      ],
      "@brainstrike/embeddings/provider-core": [
        "../../packages/embeddings/src/provider-core.ts"
      ],
      "@brainstrike/embeddings/worker": [
        "../../packages/embeddings/src/worker-entry.ts"
      ],
      "@brainstrike/vector-management": [
        "../../packages/vector-management/src"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "index.html"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "e2e/**/*",
    "playwright.config.ts",
    "src/**/__tests__/**",
    "src/**/*.test.*",
    "src/**/*.spec.*"
  ],
  "references": [
    {
      "path": "../../packages/app-shell"
    },
    {
      "path": "../../packages/db"
    },
    {
      "path": "../../packages/queue"
    },
    {
      "path": "../../packages/worker-runtime"
    },
    {
      "path": "../../packages/platform-utils"
    }
  ]
}
