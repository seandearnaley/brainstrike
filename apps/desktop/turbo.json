{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["VITE_*", "EMBED_QUEUE_ENABLED", "NODE_ENV"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/scripts/verify-no-cross-chunk-cycles.mjs"]
    },
    "build:renderer": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/verify-no-cross-chunk-cycles.mjs"]
    },
    "desktop-dev-dependencies": {
      // Synthetic transit task: build the complete desktop dependency graph
      // without a shell-sensitive `^...` filter or the desktop app itself.
      "dependsOn": ["^build"],
      "cache": false
    },
    "type-check": {
      // The E2E fixture types the public built lab entry. Keep this test-only
      // build prerequisite outside the application's package dependency graph.
      "dependsOn": ["$TURBO_EXTENDS$", "@brainstrike/mcp-test-lab#build"],
      // `type-check:test` executes this repository-root verifier. It lives
      // outside the desktop package's default inputs, so hash it explicitly
      // or Turbo can replay stale green diagnostics after verifier changes.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/verify-test-tsconfig-program.mjs"
      ]
    },
    "test": {
      // vitest.config.mts imports @brainstrike/build-utils, which exports only dist.
      "dependsOn": ["$TURBO_EXTENDS$", "@brainstrike/build-utils#build"],
      "env": ["$TURBO_EXTENDS$", "DESKTOP_TEST_SHARD", "DESKTOP_TEST_SHARD_REQUIRED"],
      // vite-config.test.ts asserts desktop/web Vite alias parity by reading
      // apps/web/vite.config.mts — a CROSS-PACKAGE file turbo's default input
      // hash for this package does not cover. Without this, a web-only Vite
      // config change could replay a stale cached green for the parity guard.
      // $TURBO_DEFAULT$ keeps the normal inputs; the extra entry adds the web
      // config to the hash. (Mirror of apps/web/turbo.json, which declares the
      // reverse-direction read of apps/desktop/index.html.)
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/vite.config.mts"]
    },
    "test:e2e": {
      // Pending-input cancellation uses the real emitted SDK fixture.
      "dependsOn": ["$TURBO_EXTENDS$", "@brainstrike/mcp-test-lab#build"]
    },
    "test:integration": {
      // These lanes run built artifacts outside Vitest's source aliases: Electron
      // launches dist/main.js with dist/renderer (`test-built`), spawned processes
      // load workspace packages' dist, and the MCP proofs start
      // packages/mcp-test-lab/dist. This package's `build` emits renderer and main
      // after `^build` (every runtime dependency, build-utils included); the lab
      // is a test-only prerequisite outside the app's dependency graph.
      "dependsOn": ["$TURBO_EXTENDS$", "build", "@brainstrike/mcp-test-lab#build"],
      "env": [
        "$TURBO_EXTENDS$",
        "DESKTOP_TEST_SHARD",
        "DESKTOP_TEST_SHARD_REQUIRED",
        "NATIVE_RETRIEVAL_TEST_EXEC_PATH"
      ]
    },
    "test:coverage": {
      // Coverage runs the integration suite too; same built artifacts.
      "dependsOn": ["$TURBO_EXTENDS$", "build", "@brainstrike/mcp-test-lab#build"],
      // Same cross-package input: the coverage lane runs the full suite
      // including vite-config.test.ts.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/vite.config.mts"]
    }
  }
}
