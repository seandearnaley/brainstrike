{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["VITE_*", "EMBED_QUEUE_ENABLED", "NODE_ENV"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      // Electron loads the native add-ons, and the renderer dev server's config
      // loads compiled workspace packages under Node; Main bundles workspace
      // code from source.
      "dependsOn": ["^build"]
    },
    "type-check": {
      // The E2E fixture types the public built lab entry. Keep this test-only
      // build prerequisite outside the application's package dependency graph.
      "dependsOn": ["$TURBO_EXTENDS$", "@brainstrike/mcp-test-lab#build"]
    },
    "test": {
      // The unit suites load native add-ons. assistant-server/skills-fs-deps
      // imports @brainstrike/secure-fs-native statically, and host-lease-manager's
      // tests read real process start times, which load windows-job-native on
      // Windows. Each add-on's uncached `node-gyp rebuild` first removes build/,
      // so without these edges a run that schedules it beside this task fails
      // with "Could not locate the bindings file" (BST-2243). This is the same
      // edge as state-store's `test`.
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@brainstrike/secure-fs-native#build",
        "@brainstrike/windows-job-native#build"
      ],
      "env": ["$TURBO_EXTENDS$", "DESKTOP_TEST_SHARD", "DESKTOP_TEST_SHARD_REQUIRED"]
    },
    "test:e2e": {
      // Pending-input cancellation uses the real emitted SDK fixture.
      "dependsOn": ["$TURBO_EXTENDS$", "@brainstrike/mcp-test-lab#build"]
    },
    "test:e2e:lane:smoke": {
      // The smoke lane launches the same app and fixtures as test:e2e.
      "dependsOn": ["$TURBO_EXTENDS$", "@brainstrike/mcp-test-lab#build"]
    },
    "test:integration": {
      // These lanes run built artifacts outside Vitest's source aliases: Electron
      // launches dist/main.js with dist/renderer (`test-built`), spawned processes
      // load workspace packages' dist, and the MCP proofs start
      // packages/mcp-test-lab/dist. This package's `build` emits renderer and main
      // after `^build` (every runtime dependency, build-utils included); the lab
      // is a test-only prerequisite outside the app's dependency graph.
      "dependsOn": ["$TURBO_EXTENDS$", "build", "@brainstrike/mcp-test-lab#build"],
      "env": [
        "$TURBO_EXTENDS$",
        "DESKTOP_TEST_SHARD",
        "DESKTOP_TEST_SHARD_REQUIRED",
        "NATIVE_RETRIEVAL_TEST_EXEC_PATH"
      ]
    }
  }
}
