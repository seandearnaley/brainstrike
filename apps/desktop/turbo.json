{
  "extends": ["//"],
  "tasks": {
    "test": {
      // NEVER replay @brainstrike/desktop unit tests from cache: their pass/fail
      // depends on RESULT-AFFECTING inputs turbo does not hash (native/external
      // binaries + real subprocess timing). Named mechanisms in the cached lane:
      //   - terminal-ipc-handlers.test.ts spawns a REAL node-pty; the file's own
      //     header says it "FAIL[s] loudly" if the compiled native addon cannot
      //     load (ABI/native-build mismatch). The .node binary + host ABI are
      //     invisible to turbo's source hash.
      //   - assistant-server/git-service.test.ts drives the REAL `git` binary via
      //     execFile (no git mock); output depends on the installed git version.
      //   - assistant-server/execute-command-tool.test.ts spawns REAL `/bin/sh`
      //     and asserts timeout/abort actually kill the process — wall-clock
      //     timing, not a hashed input.
      // Config already forces maxWorkers:1 + no-file-parallelism (serialized),
      // which is the maintainers acknowledging this lane's env sensitivity.
      "cache": false,
      // cache:false does NOT exempt this task from turbo's strict-env filtering,
      // and package configs REPLACE (not merge) array fields. Redeclare so the
      // vitest child still sees CI/COVERAGE. Keep in sync with root turbo.jsonc.
      "passThroughEnv": ["CI", "COVERAGE"]
    }
  }
}
