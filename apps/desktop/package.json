{
  "name": "@brainstrike/desktop",
  "version": "0.1.0-beta.3",
  "build": {
    "appId": "com.brainstrike.desktop",
    "appImage": {
      "executableArgs": []
    },
    "productName": "Brainstrike",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/third-party-licenses.*.json",
      "!dist/THIRD-PARTY-NOTICES.txt",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "electronFuses": {
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "enableNodeCliInspectArguments": true,
      "enableNodeOptionsEnvironmentVariable": true,
      "grantFileProtocolExtraPrivileges": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true,
      "runAsNode": true
    },
    "npmRebuild": false,
    "asarUnpack": [
      "dist/main-log-transport.js",
      "dist/main-watchdog-worker.js",
      "**/node_modules/node-pty/prebuilds/**",
      "**/node_modules/@brainstrike/secure-fs-native/build/Release/*.node",
      "**/node_modules/@brainstrike/windows-job-native/build/Release/*.node",
      "**/node_modules/better-sqlite3/**/*.node",
      "**/node_modules/sqlite-vec-*/vec0.{dylib,so,dll}",
      "**/node_modules/@typescript/old/**",
      "**/node_modules/typescript-language-server/**",
      "**/node_modules/typescript/**",
      "**/node_modules/vscode-jsonrpc/**",
      "**/node_modules/vscode-languageserver-protocol/**",
      "**/node_modules/vscode-languageserver/**",
      "**/node_modules/vscode-languageserver-textdocument/**"
    ],
    "mac": {
      "artifactName": "Brainstrike-${version}-macos-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleIconName": "Icon"
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.plist",
      "notarize": true,
      "extraResources": [
        {
          "from": "build/Assets.car",
          "to": "Assets.car"
        },
        {
          "from": "resources/python-runtime",
          "to": "python-runtime",
          "filter": [
            "manifest.json"
          ]
        },
        {
          "from": "resources/python-runtime/unpacked/darwin-${arch}",
          "to": "python-runtime"
        }
      ]
    },
    "win": {
      "artifactName": "Brainstrike-${version}-windows-${arch}.${ext}",
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "asarUnpack": [
        "**/node_modules/@anthropic-ai/sandbox-runtime/vendor/seccomp/${arch}/apply-seccomp"
      ],
      "artifactName": "Brainstrike-${version}-linux-x64.${ext}",
      "executableName": "brainstrike-desktop",
      "target": "AppImage",
      "icon": "build/icons",
      "extraResources": [
        {
          "from": "resources/python-runtime",
          "to": "python-runtime",
          "filter": [
            "manifest.json"
          ]
        },
        {
          "from": "resources/python-runtime/unpacked/linux-${arch}",
          "to": "python-runtime"
        },
        {
          "from": "licenses/python-linux-${arch}",
          "to": "python-runtime/licenses",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "allowMissingDependencies": false,
    "beforePack": "./scripts/prepare-python-runtime-before-pack.mjs",
    "publish": [
      {
        "provider": "github",
        "owner": "seandearnaley",
        "repo": "brainstrike-releases"
      }
    ]
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "catalog:",
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/cohere": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/otel": "catalog:",
    "@anthropic-ai/sandbox-runtime": "catalog:",
    "@aws-sdk/credential-providers": "catalog:",
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/agent-host": "workspace:*",
    "@brainstrike/app-shell": "workspace:*",
    "@brainstrike/app-state": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/assistant-data": "workspace:*",
    "@brainstrike/assistant-service": "workspace:*",
    "@brainstrike/assistant-ui": "workspace:*",
    "@brainstrike/canonical-ingestion": "workspace:*",
    "@brainstrike/chunking-worker": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/host-capabilities": "workspace:*",
    "@brainstrike/host-lease": "workspace:*",
    "@brainstrike/indexer": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/mcp-app-host-ui": "workspace:*",
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/secure-fs-native": "workspace:*",
    "@brainstrike/settings-ui": "workspace:*",
    "@brainstrike/sqlite-native": "workspace:*",
    "@brainstrike/sqlite-query": "workspace:*",
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/windows-job-native": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*",
    "@brainstrike/workspace-search": "workspace:*",
    "@eslint-community/regexpp": "catalog:",
    "@fontsource-variable/fira-code": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@mastra/core": "catalog:",
    "@mastra/memory": "catalog:",
    "@mastra/schema-compat": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/core": "catalog:",
    "@napi-rs/keyring": "catalog:",
    "@openrouter/ai-sdk-provider": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@typescript/old": "catalog:",
    "ai": "catalog:",
    "better-sqlite3": "catalog:",
    "effect": "catalog:",
    "electron-store": "^12.0.0",
    "electron-updater": "6.8.11",
    "fastest-levenshtein": "catalog:",
    "ignore": "catalog:",
    "jsonc-parser": "catalog:",
    "lucide-react": "catalog:",
    "minimatch": "catalog:",
    "node-pty": "^1.1.0",
    "oxc-parser": "catalog:",
    "pino": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sqlite-vec": "catalog:",
    "strip-ansi": "catalog:",
    "tiktoken": "catalog:",
    "tree-kill": "catalog:",
    "typescript": "catalog:",
    "typescript-language-server": "catalog:",
    "vscode-jsonrpc": "catalog:",
    "vscode-languageserver-protocol": "catalog:",
    "voyage-ai-provider": "catalog:",
    "web-tree-sitter": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@assistant-ui/react": "catalog:",
    "@assistant-ui/react-streamdown": "catalog:",
    "@brainstrike/build-utils": "workspace:*",
    "@brainstrike/config": "workspace:*",
    "@brainstrike/e2e-test-utils": "workspace:*",
    "@brainstrike/file-explorer": "workspace:*",
    "@brainstrike/mcp-app-host": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@electron/fuses": "1.8.0",
    "@electron/osx-sign": "2.7.2",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@playwright/test": "catalog:",
    "@radix-ui/react-accordion": "catalog:",
    "@radix-ui/react-checkbox": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-scroll-area": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@radix-ui/react-toast": "catalog:",
    "@shikijs/langs": "catalog:",
    "@shikijs/themes": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "catalog:",
    "electron": "catalog:",
    "electron-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "minimatch": "catalog:",
    "oxc-transform-react": "catalog:",
    "pino": "catalog:",
    "playwright": "catalog:",
    "react-hotkeys-hook": "catalog:",
    "react-resizable-panels": "catalog:",
    "react-router-dom": "catalog:",
    "react-shiki": "catalog:",
    "remark-gfm": "catalog:",
    "shiki": "catalog:",
    "tailwindcss": "catalog:",
    "tar": "7.5.22",
    "tiktoken": "catalog:",
    "vite": "catalog:",
    "vite-plugin-static-copy": "catalog:",
    "vite-plugin-wasm": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^9.5.1",
    "xvfb-maybe": "^0.2.1",
    "xxhash-wasm": "catalog:",
    "zustand": "catalog:"
  },
  "engines": {
    "node": ">=26.8.2 <27"
  },
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "concurrently --kill-others-on-fail --names renderer,main \"pnpm build:renderer\" \"pnpm build:main\" && node scripts/write-third-party-notices.mjs",
    "build:cached": "node ../../scripts/run-turbo-command.mjs -- run build --filter=@brainstrike/desktop",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "clean:db": "node ../../scripts/clean-desktop-indexeddb.mjs",
    "fetch:python-runtime": "node scripts/fetch-python-runtime.mjs --all",
    "agent-debug:mcp-config": "node scripts/start-agent-devtools-session.mjs --print-config",
    "dev": "pnpm run dev:runtime",
    "dev:agent-debug": "node scripts/start-agent-devtools-session.mjs",
    "dev:electron": "pnpm dev:main && wait-on http://localhost:38181 && electron . --no-sandbox --brainstrike-desktop-launch-mode=dev-server",
    "dev:main": "node scripts/build-main.mjs && node scripts/write-third-party-notices.mjs --without-renderer",
    "dev:renderer": "vite",
    "dev:runtime": "concurrently --kill-others \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dist": "pnpm build && electron-builder",
    "pack": "pnpm build:cached && electron-builder --dir",
    "postinstall": "node scripts/provision-dev-electron.mjs && node scripts/chmod-pty-spawn-helper.mjs && node scripts/sign-dev-electron.mjs",
    "start": "node scripts/fetch-python-runtime.mjs --platform=host && pnpm build && electron . --no-sandbox --brainstrike-desktop-launch-mode=built",
    "start:dev": "pnpm dev:main && electron . --no-sandbox --brainstrike-desktop-launch-mode=built",
    "test": "vitest run --config vitest.unit.config.mts --exclude \"**/*.integration.test.*\"",
    "test:packaged-python-layout": "node scripts/packaged-python-smoke.mjs --layout-only",
    "test:packaged-python": "node scripts/packaged-python-smoke.mjs",
    "test:provider-cassettes": "vitest run --config vitest.integration.config.mts src/__tests__/provider-cassette",
    "test:integration": "node scripts/run-integration.mjs",
    "test:integration:routine": "vitest run --config vitest.integration.config.mts src/__tests__/ordinary-app-owned-host src/__tests__/main/host-lease-electron.integration.test.ts src/__tests__/factory-reset-quit.integration.test.ts",
    "test:e2e": "node ../../scripts/run-env.mjs NO_COLOR= BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn -- xvfb-maybe pnpm exec playwright test --retries=0 --grep-invert=@packaged",
    "test:e2e:clean": "pnpm clean:db && pnpm test:e2e:main",
    "test:e2e:debug": "node ../../scripts/run-env.mjs NO_COLOR= BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn -- xvfb-maybe pnpm exec playwright test --debug",
    "test:e2e:lane:full-regression": "node ../../scripts/run-env.mjs NO_COLOR= BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn -- xvfb-maybe pnpm exec playwright test --project=regression --retries=0 --max-failures=0 --global-timeout=1800000 --grep-invert=@packaged && pnpm run test:e2e:lane:tools-settings-nightly",
    "test:e2e:lane:full-regression-shard": "node ../../scripts/run-env.mjs NO_COLOR= BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn -- xvfb-maybe pnpm exec playwright test --project=smoke --project=regression --retries=0 --max-failures=0 --global-timeout=1800000 --grep-invert=@packaged",
    "test:e2e:lane:packaged-mcp": "node ../../scripts/run-env.mjs NO_COLOR= BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn -- xvfb-maybe pnpm exec playwright test e2e/mcp-apps-bridge.desktop.test.ts e2e/mcp-task-restart.packaged.desktop.test.ts e2e/mcp-apps-production-lifecycle.desktop.test.ts e2e/electron-fuses.packaged.desktop.test.ts --project=regression --retries=0 --max-failures=0 --global-timeout=360000",
    "test:e2e:lane:packaged-mcp-core": "node ../../scripts/run-env.mjs NO_COLOR= LOG_LEVEL=info -- xvfb-maybe pnpm exec playwright test e2e/mcp-packaged-core.desktop.test.ts e2e/open-source-licenses.packaged.desktop.test.ts e2e/settings-store.packaged.desktop.test.ts --project=regression --retries=0 --max-failures=0 --global-timeout=840000",
    "test:e2e:lane:smoke": "node ../../scripts/run-env.mjs NO_COLOR= BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn -- xvfb-maybe pnpm exec playwright test e2e/add-root-ui.smoke.desktop.test.ts e2e/agent-devtools.desktop.test.ts e2e/app-launch.test.ts e2e/assistant-panel.desktop.test.ts e2e/background-indexing-pause.desktop.test.ts e2e/file-system.test.ts e2e/host-thread-catalog.desktop.test.ts e2e/host-thread-unavailable-root-reopen.desktop.test.ts e2e/secrets-settings.test.ts e2e/subagent-persona-availability.desktop.test.ts e2e/terminal-panel.desktop.test.ts e2e/threads-panel-folders.desktop.test.ts e2e/tools-settings.desktop.test.ts e2e/thread-workspace-close.desktop.test.ts e2e/workspace-bar.desktop.test.ts e2e/worktree-map.desktop.test.ts e2e/worktree-mode.desktop.test.ts e2e/workspace-index-bootstrap.desktop.test.ts --project=smoke --retries=0 --max-failures=0 --global-timeout=900000 --grep=\"@smoke\"",
    "test:e2e:lane:smoke-delegated": "node ../../scripts/run-env.mjs NO_COLOR= BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn -- xvfb-maybe pnpm exec playwright test e2e/delegated-child-control.desktop.test.ts e2e/delegated-child-interactive.desktop.test.ts e2e/delegated-worker-write.desktop.test.ts e2e/delegated-workspace-reload.desktop.test.ts e2e/parent-approval-with-parked-workers.desktop.test.ts e2e/workers-after-canvas-approval.desktop.test.ts --project=smoke --retries=0 --max-failures=0 --global-timeout=900000 --grep=\"@smoke\"",
    "test:e2e:lane:tools-settings-nightly": "node ../../scripts/run-env.mjs NO_COLOR= BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn -- xvfb-maybe pnpm exec playwright test e2e/tools-settings.desktop.test.ts --project=smoke --retries=0 --max-failures=0 --global-timeout=120000 --grep=\"@smoke\"",
    "test:e2e:main": "node ../../scripts/run-env.mjs NO_COLOR= BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn -- xvfb-maybe pnpm exec playwright test --grep-invert=@packaged",
    "test:e2e:mcp-packaged": "pnpm --filter @brainstrike/mcp-test-lab build && pnpm run pack && pnpm run test:e2e:lane:packaged-mcp-core",
    "test:e2e:ui": "node ../../scripts/run-env.mjs NO_COLOR= BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn -- xvfb-maybe pnpm exec playwright test --ui",
    "type-check": "pnpm type-check:main && pnpm type-check:test && pnpm type-check:e2e && effect-tsgo diagnostics --project tsconfig.e2e.json --strict && effect-tsgo diagnostics --project tsconfig.test.json --strict",
    "type-check:e2e": "node ../../node_modules/@typescript/native/bin/tsc --noEmit --project tsconfig.e2e.json",
    "type-check:main": "node ../../node_modules/@typescript/native/bin/tsc --noEmit && node ../../node_modules/@typescript/native/bin/tsc --noEmit --project tsconfig.main.json",
    "type-check:test": "node ../../node_modules/@typescript/native/bin/tsc --noEmit --project tsconfig.test.json"
  },
  "config": {
    "nodeRuntimeMajor": 24
  },
  "type": "module"
}
