{
  "name": "@brainstrike/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:main && wait-on http://localhost:3001 && electron . --no-sandbox",
    "dev:main": "tsc src/main.ts --outDir dist --target es2022 --module commonjs --moduleResolution node --allowSyntheticDefaultImports --esModuleInterop --skipLibCheck && tsc src/preload.ts --outDir dist --target es2022 --module commonjs --moduleResolution node --allowSyntheticDefaultImports --esModuleInterop --skipLibCheck",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc src/main.ts --outDir dist --target es2022 --module commonjs --moduleResolution node --allowSyntheticDefaultImports --esModuleInterop --skipLibCheck --moduleDetection force && tsc src/preload.ts --outDir dist --target es2022 --module commonjs --moduleResolution node --allowSyntheticDefaultImports --esModuleInterop --skipLibCheck --moduleDetection force",
    "start": "electron . --no-sandbox",
    "start:dev": "npm run dev:main && electron . --no-sandbox",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "lint": "pnpm run --filter brainstrike lint",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@brainstrike/app-shell": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "electron-store": "^10.0.1",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@brainstrike/tailwind-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^3.2.2",
    "concurrently": "^9.1.2",
    "electron": "36.4.0",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "^26.0.12",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.brainstrike.desktop",
    "productName": "BrainStrike Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
