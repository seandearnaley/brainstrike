{
  "name": "@brainstrike/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:main && wait-on http://localhost:8081 && electron . --no-sandbox",
    "dev:main": "tsc --project tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc --project tsconfig.main.json",
    "start": "electron . --no-sandbox",
    "start:dev": "npm run dev:main && electron . --no-sandbox",
    "pack": "npm run build && electron-builder",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "type-check": "npm run type-check:main && npm run type-check:e2e",
    "type-check:main": "tsc --noEmit",
    "type-check:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "lint": "cd ../.. && npx biome check apps/desktop/",
    "lint:fix": "cd ../.. && npx biome check apps/desktop/ --write"
  },
  "dependencies": {
    "@brainstrike/app-shell": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "electron-store": "^10.1.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "workspace:*",
    "@brainstrike/tailwind-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.3",
    "@playwright/test": "workspace:*",
    "concurrently": "^9.1.2",
    "electron": "36.4.0",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "^26.0.12",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3",
    "wait-on": "^8.0.3",
    "vite-plugin-wasm": "^3.4.1",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-static-copy": "^3.0.2"
  },
  "build": {
    "appId": "com.brainstrike.desktop",
    "productName": "BrainStrike Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
