{
  "name": "@brainstrike/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "pnpm build:main && wait-on http://localhost:8081 && electron . --no-sandbox",
    "dev:main": "tsc --project tsconfig.main.json",
    "build": "pnpm build:renderer && pnpm build:main",
    "build:renderer": "vite build",
    "build:main": "tsc --project tsconfig.main.json",
    "start": "electron . --no-sandbox",
    "start:dev": "pnpm dev:main && electron . --no-sandbox",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "test": "vitest run",
    "test:coverage": "pnpm -w test:coverage",
    "test:e2e": "BRAINSTRIKE_DISABLE_FILE_LOGS=1 xvfb-maybe pnpm exec playwright test",
    "test:e2e:main": "BRAINSTRIKE_DISABLE_FILE_LOGS=1 xvfb-maybe pnpm exec playwright test --grep-invert=\"Database Persistence\"",
    "test:e2e:persistence": "BRAINSTRIKE_DISABLE_FILE_LOGS=1 xvfb-maybe pnpm exec playwright test --grep=\"Database Persistence\" --workers=1",
    "test:e2e:all": "pnpm test:e2e:main && pnpm test:e2e:persistence",
    "clean:db": "rm -rf \"$HOME/Library/Application Support/@brainstrike/desktop/IndexedDB\" || true",
    "test:e2e:clean": "pnpm clean:db && pnpm test:e2e:all",
    "test:e2e:ui": "BRAINSTRIKE_DISABLE_FILE_LOGS=1 xvfb-maybe pnpm exec playwright test --ui",
    "test:e2e:debug": "BRAINSTRIKE_DISABLE_FILE_LOGS=1 xvfb-maybe pnpm exec playwright test --debug",
    "type-check": "pnpm type-check:main && pnpm type-check:e2e",
    "type-check:main": "tsc --noEmit",
    "type-check:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/app-shell": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-import": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/preferences": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/vector-management": "workspace:*",
    "@electric-sql/pglite": "^0.3.14",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "electron-store": "^11.0.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@brainstrike/build-utils": "workspace:*",
    "@brainstrike/config": "workspace:*",
    "@brainstrike/tailwind-config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "concurrently": "^9.2.1",
    "electron": "39.2.7",
    "electron-builder": "^26.4.0",
    "electron-builder-squirrel-windows": "^26.4.0",
    "jsdom": "27.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.17",
    "wait-on": "^9.0.3",
    "xvfb-maybe": "^0.2.1"
  },
  "build": {
    "appId": "com.brainstrike.desktop",
    "productName": "BrainStrike Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons"
    }
  }
}
