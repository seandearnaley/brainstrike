{
  "name": "@brainstrike/desktop",
  "version": "0.1.0",
  "build": {
    "appId": "com.brainstrike.desktop",
    "productName": "BrainStrike Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons"
    }
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/app-shell": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-import": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/preferences": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*",
    "@electric-sql/pglite": "^0.4.4",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.8.0",
    "oxc-parser": "^0.131.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.12.25",
    "@assistant-ui/react-data-stream": "^0.12.11",
    "@assistant-ui/react-markdown": "^0.12.9",
    "@assistant-ui/styles": "^0.3.7",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/runtime": "^7.29.2",
    "@brainstrike/build-utils": "workspace:*",
    "@brainstrike/config": "workspace:*",
    "@brainstrike/tailwind-config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@playwright/test": "^1.59.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@rolldown/plugin-babel": "^0.2.3",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.2.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-builder-squirrel-windows": "^26.8.1",
    "file-saver": "2.0.5",
    "idb": "^8.0.3",
    "jsdom": "29.0.2",
    "jszip": "^3.10.1",
    "minimatch": "^10.2.5",
    "pino": "^10.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hotkeys-hook": "^5.2.4",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^7.14.1",
    "react-shiki": "^0.9.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "tiktoken": "^1.0.22",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.5",
    "xvfb-maybe": "^0.2.1",
    "xxhash-wasm": "^1.1.0",
    "zustand": "^5.0.12"
  },
  "engines": {
    "node": "22.x"
  },
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:main",
    "build:main": "tsc --project tsconfig.main.json",
    "build:renderer": "vite build",
    "clean:db": "rm -rf \"$HOME/Library/Application Support/@brainstrike/desktop/IndexedDB\" || true",
    "prebuild": "pnpm turbo build --filter=@brainstrike/build-utils --filter=@brainstrike/agent --filter=@brainstrike/ui",
    "predev": "if [ -f ../../packages/build-utils/dist/index.mjs ] && [ -f ../../packages/agent/dist/index.mjs ] && [ -f ../../packages/ui/dist/index.d.ts ]; then true; else pnpm turbo build --filter=@brainstrike/build-utils --filter=@brainstrike/agent --filter=@brainstrike/ui; fi",
    "dev": "concurrently --kill-others \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:electron": "pnpm build:main && wait-on http://localhost:38181 && electron . --no-sandbox --brainstrike-desktop-launch-mode=dev-server",
    "dev:main": "tsc --project tsconfig.main.json",
    "dev:renderer": "vite",
    "dist": "pnpm build && electron-builder",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "pack": "pnpm build && electron-builder --dir",
    "start": "pnpm build && electron . --no-sandbox --brainstrike-desktop-launch-mode=built",
    "start:dev": "pnpm dev:main && electron . --no-sandbox --brainstrike-desktop-launch-mode=built",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:e2e": "unset NO_COLOR; BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn xvfb-maybe pnpm exec playwright test",
    "test:e2e:all": "pnpm test:e2e:main && pnpm test:e2e:persistence",
    "test:e2e:backgrounding": "unset NO_COLOR; BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn BRAINSTRIKE_E2E_ALLOW_BACKGROUNDING=1 xvfb-maybe pnpm exec playwright test e2e/embedding-worker-renderer.test.ts --project=regression --grep=\"crash repro test [23]\"",
    "test:e2e:clean": "pnpm clean:db && pnpm test:e2e:all",
    "test:e2e:debug": "unset NO_COLOR; BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn xvfb-maybe pnpm exec playwright test --debug",
    "test:e2e:main": "unset NO_COLOR; BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn xvfb-maybe pnpm exec playwright test --grep-invert=\"Database Persistence\"",
    "test:e2e:persistence": "unset NO_COLOR; BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn xvfb-maybe pnpm exec playwright test --grep=\"Database Persistence\" --workers=1",
    "test:e2e:ui": "unset NO_COLOR; BRAINSTRIKE_DISABLE_FILE_LOGS=1 LOG_LEVEL=warn xvfb-maybe pnpm exec playwright test --ui",
    "type-check": "pnpm type-check:main && pnpm type-check:e2e",
    "type-check:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "type-check:main": "tsc --noEmit"
  }
}
