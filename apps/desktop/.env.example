# BrainStrike Desktop provider credentials
#
# Copy this file to `.env.local` for local development and set only the
# credentials you use. Existing launch-environment variables take precedence.
# Never commit a populated `.env` or `.env.local`.
#
# Each provider accepts exactly two names, checked in order:
#   1. BRAINSTRIKE_<PROVIDER>_API_KEY  (app-scoped override, wins)
#   2. the vendor-standard name
# Older aliases (BS_*, AI_*, *_V1/_V2, GOOGLE_API_KEY) still parse but are
# deprecated: they never authenticate, and the app reports a rename warning.

# OpenAI (use either name)
OPENAI_API_KEY=
# BRAINSTRIKE_OPENAI_API_KEY=

# Anthropic (use either name)
ANTHROPIC_API_KEY=
# BRAINSTRIKE_ANTHROPIC_API_KEY=

# Google AI Studio (use either name)
GOOGLE_GENERATIVE_AI_API_KEY=
# BRAINSTRIKE_GOOGLE_API_KEY=

# OpenRouter (use either name)
OPENROUTER_API_KEY=
# BRAINSTRIKE_OPENROUTER_API_KEY=

# Cohere embeddings (use either name)
COHERE_API_KEY=
# BRAINSTRIKE_COHERE_API_KEY=

# Voyage AI embeddings (use either name)
VOYAGE_API_KEY=
# BRAINSTRIKE_VOYAGE_API_KEY=

# Tavily web search (use either name)
TAVILY_API_KEY=
# BRAINSTRIKE_TAVILY_API_KEY=
