# BrainStrike Desktop provider credentials
#
# Copy this file to `.env.local` for local development and set only the
# credentials you use. Existing launch-environment variables take precedence.
# Never commit a populated `.env` or `.env.local`.

# OpenAI (use either name)
OPENAI_API_KEY=
# BRAINSTRIKE_OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Google AI Studio (use either name)
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=

# Tavily web search (use either name)
TAVILY_API_KEY=
# BRAINSTRIKE_TAVILY_API_KEY=
