{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": false,
    "allowJs": false,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "types": [
      "node",
      "electron"
    ],
    "baseUrl": ".",
    "paths": {
      "@brainstrike/utils": [
        "../../packages/utils/dist/index.d.ts"
      ],
      "@brainstrike/agent": [
        "../../packages/agent/dist/index.d.ts"
      ],
      "@brainstrike/agent/client": [
        "../../packages/agent/dist/client.d.ts"
      ],
      "@brainstrike/agent/local-llm": [
        "../../packages/agent/dist/local-llm.d.ts"
      ],
      "@brainstrike/agent/pglite-mastra-memory": [
        "../../packages/agent/dist/pglite-mastra-memory/index.d.ts"
      ],
      "@brainstrike/embeddings/provider-core": [
        "../../packages/embeddings/dist/provider-core.d.ts"
      ],
      "@brainstrike/storage/electron": [
        "../../packages/storage/dist/electron.d.ts"
      ],
      "@brainstrike/file-system/electron": [
        "../../packages/file-system/dist/electron.d.ts"
      ],
      "@brainstrike/file-system/path-validation": [
        "../../packages/file-system/dist/path-validation.d.ts"
      ],
      "@brainstrike/utils/logger": [
        "../../packages/utils/dist/logger.d.ts"
      ],
      "@brainstrike/utils/logging-initializer": [
        "../../packages/utils/dist/logging-initializer.d.ts"
      ],
      "@brainstrike/utils/log-buffer": [
        "../../packages/utils/dist/log-buffer.d.ts"
      ],
      "@brainstrike/utils/logging-preferences": [
        "../../packages/utils/dist/logging-preferences.d.ts"
      ],
      "@brainstrike/utils/collator": [
        "../../packages/utils/dist/collator.d.ts"
      ],
      "@brainstrike/utils/crypto": [
        "../../packages/utils/dist/crypto.d.ts"
      ],
      "@brainstrike/utils/safe-storage": [
        "../../packages/utils/dist/safe-storage.d.ts"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "src/main.ts",
    "src/preload.ts",
    "src/db-host-entry.ts",
    "src/db-host-manager.ts",
    "src/db-host-protocol.ts",
    "src/db-main.ts",
    "src/parser-host-entry.ts",
    "src/parser-host-shared.ts",
    "src/parser-host-manager.ts",
    "src/ipc-parser-host.ts",
    "src/ipc-handlers.ts",
    "src/ipc-secrets.ts",
    "src/ipc-agent.ts",
    "src/ipc-mcp.ts",
    "src/assistant-server.ts",
    "src/secrets.ts",
    "src/mcp-loader.ts",
    "src/create-window.ts",
    "src/setup-security.ts",
    "src/agent-client-loader.ts",
    "src/provider-api-key.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/renderer"
  ]
}
