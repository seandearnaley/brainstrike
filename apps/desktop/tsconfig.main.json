{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": false,
    "allowJs": false,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "types": [
      "node",
      "electron"
    ],
    "paths": {
      "@brainstrike/assistant-service/http": [
        "../../packages/assistant-service/dist/http.d.ts"
      ],
      "@brainstrike/assistant-service/local-provider-runtime": [
        "../../packages/assistant-service/dist/local-provider-runtime.d.ts"
      ],
      "@brainstrike/assistant-service/memory-model-targets": [
        "../../packages/assistant-service/dist/memory-model-targets.d.ts"
      ],
      "@brainstrike/assistant-service/ports": [
        "../../packages/assistant-service/dist/ports.d.ts"
      ],
      "@brainstrike/assistant-service/request": [
        "../../packages/assistant-service/dist/request.d.ts"
      ],
      "@brainstrike/assistant-service/run-turn": [
        "../../packages/assistant-service/dist/run-turn.d.ts"
      ],
      "@brainstrike/assistant-service/secret-errors": [
        "../../packages/assistant-service/dist/secret-errors.d.ts"
      ],
      "@brainstrike/assistant-service/steering": [
        "../../packages/assistant-service/dist/steering.d.ts"
      ],
      "@brainstrike/assistant-service/stream-init": [
        "../../packages/assistant-service/dist/stream-init.d.ts"
      ],
      "@brainstrike/assistant-service/types": [
        "../../packages/assistant-service/dist/types.d.ts"
      ],
      "vscode-jsonrpc/node": [
        "./node_modules/vscode-jsonrpc/lib/node/main.d.ts"
      ],
      "vscode-languageserver-protocol/node": [
        "./node_modules/vscode-languageserver-protocol/lib/node/main.d.ts"
      ],
      "@brainstrike/utils": [
        "../../packages/utils/dist/index.d.ts"
      ],
      "@brainstrike/agent": [
        "../../packages/agent/dist/index.d.ts"
      ],
      "@brainstrike/agent/client": [
        "../../packages/agent/dist/client.d.ts"
      ],
      "@brainstrike/agent/mcp-client": [
        "../../packages/agent/dist/mcp-client.d.ts"
      ],
      "@brainstrike/agent/local-llm": [
        "../../packages/agent/dist/local-llm.d.ts"
      ],
      "@brainstrike/agent/pglite-mastra-memory": [
        "../../packages/agent/dist/pglite-mastra-memory/index.d.ts"
      ],
      "@brainstrike/embeddings/provider-core": [
        "../../packages/embeddings/dist/provider-core.d.ts"
      ],
      "@brainstrike/storage/electron": [
        "../../packages/storage/dist/electron.d.ts"
      ],
      "@brainstrike/file-system/electron": [
        "../../packages/file-system/dist/electron.d.ts"
      ],
      "@brainstrike/file-system/path-validation": [
        "../../packages/file-system/dist/path-validation.d.ts"
      ],
      "@brainstrike/notes-vault/core": [
        "../../packages/notes-vault/dist/core/index.d.ts"
      ],
      "@brainstrike/notes-vault/desktop-contract": [
        "../../packages/notes-vault/dist/desktop/bridge-contract.d.ts"
      ],
      "@brainstrike/effect-kit": [
        "../../packages/effect-kit/dist/index.d.ts"
      ],
      "@brainstrike/logging": [
        "../../packages/logging/dist/index.d.ts"
      ],
      "@brainstrike/utils/collator": [
        "../../packages/utils/dist/collator.d.ts"
      ],
      "@brainstrike/utils/string-utils": [
        "../../packages/utils/dist/string-utils.d.ts"
      ],
      "@brainstrike/utils/crypto": [
        "../../packages/utils/dist/crypto.d.ts"
      ],
      "@brainstrike/indexing-contract/workspace-indexing-qos": [
        "../../packages/indexing-contract/dist/workspace-indexing-qos.d.ts"
      ],
      "@brainstrike/indexing-contract/workspace-indexing-power-snapshot": [
        "../../packages/indexing-contract/dist/workspace-indexing-power-snapshot.d.ts"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "src/main-bootstrap.ts",
    "src/main.ts",
    "src/preload.ts",
    "src/hidden-preload.ts",
    "src/diagnostics/main-watchdog-worker.ts",
    "src/db-host-entry.ts",
    "src/db-host-manager.ts",
    "src/db-host-protocol.ts",
    "src/db-main.ts",
    "src/parser-host-entry.ts",
    "src/official-conformance-client-entry.ts",
    "src/official-conformance-client-process.ts",
    "src/parser-host-shared.ts",
    "src/parser-host-manager.ts",
    "src/ipc-parser-host.ts",
    "src/ipc-handlers.ts",
    "src/ipc-secrets.ts",
    "src/ipc-agent.ts",
    "src/ipc-mcp.ts",
    "src/assistant-server.ts",
    "src/secrets.ts",
    "src/mcp-loader.ts",
    "src/mcp/server-actor.ts",
    "src/mcp/host-revision-publisher.ts",
    "src/mcp/host-service.ts",
    "src/create-window.ts",
    "src/setup-security.ts",
    "src/agent-client-loader.ts",
    "src/provider-api-key.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/renderer"
  ]
}
