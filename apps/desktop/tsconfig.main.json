{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "moduleDetection": "force",
    "types": [
      "node",
      "electron"
    ],
    "paths": {
      "vscode-jsonrpc/node": [
        "./node_modules/vscode-jsonrpc/lib/node/main.d.ts"
      ],
      "vscode-languageserver-protocol/node": [
        "./node_modules/vscode-languageserver-protocol/lib/node/main.d.ts"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "src/main-bootstrap.ts",
    "src/main.ts",
    "src/preload.ts",
    "src/host-lease-entry.ts",
    "src/host-lease-manager.ts",
    "src/diagnostics/main-watchdog-worker.ts",
    "src/ipc-handlers.ts",
    "src/ipc-secrets.ts",
    "src/ipc-agent.ts",
    "src/ipc-mcp.ts",
    "src/assistant-server.ts",
    "src/secrets.ts",
    "src/mcp-loader.ts",
    "src/mcp/server-actor.ts",
    "src/mcp/host-revision-publisher.ts",
    "src/mcp/host-service.ts",
    "src/create-window.ts",
    "src/setup-security.ts",
    "src/provider-api-key.ts",
    "src/types/**/*.d.ts",
    "src/indexer-host-entry.ts",
    "src/indexer-host-manager.ts",
    "src/sqlite-query-host-entry.ts",
    "src/sqlite-query-host-manager.ts",
    "src/agent-host-entry.ts",
    "src/agent-host-platform-entry.ts",
    "src/agent-egress-entry.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/renderer"
  ]
}
