{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "types": [
      "node",
      "electron",
      "vite/client",
      "vitest/globals",
      "@brainstrike/test-utils/vitest-matchers"
    ],
    "paths": {},
    "strictNullChecks": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
