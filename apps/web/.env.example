# Search and ranking tunables (optional)

# Server-only assistant credentials for local Vite or a protected Vercel Preview.
# Configure any subset; the status endpoint advertises only providers with a
# non-empty key. Never prefix these with VITE_: production remains disabled
# until the app has authentication plus distributed quota/cost controls.
# BRAINSTRIKE_OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=

# Optional stricter server request limit as a positive safe integer byte count.
# Hosted Web defaults to and cannot exceed 4 MiB (4194304); larger values fail
# configuration visibly.
# BRAINSTRIKE_ASSISTANT_REQUEST_BODY_LIMIT_BYTES=

# Default semantic similarity threshold for search UI (0..1)
# Higher returns fewer, more precise results; lower returns more, noisier results.
VITE_SEARCH_DEFAULT_THRESHOLD=0.5

# Re-ranking weights (advanced). Effective range usually 0..1
# VITE_RERANK_VECTOR=0.75
# VITE_RERANK_FILE_BOOST=0.15
# VITE_RERANK_LEXICAL=0.10
# VITE_RERANK_ADJACENCY=0.05
