{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client",
      "vitest",
      "@testing-library/jest-dom"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {},
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "**/*.test.*",
    "vite.config.mts",
    "vitest.config.mts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}