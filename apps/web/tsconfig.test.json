{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client",
      "vitest",
      "@brainstrike/test-utils/vitest-matchers"
    ],
    "rootDir": "..",
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {},
    "strictNullChecks": true
  },
  "include": [
    "api/**/*.ts",
    "src/**/*",
    "e2e/**/*",
    "config/web-chromium.mjs",
    "**/*.test.*",
    "vite.config.mts",
    "vitest.config.mts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
