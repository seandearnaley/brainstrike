{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@web/*": [
        "./src/*"
      ],
      "@brainstrike/agent": [
        "../../packages/agent/src/index.ts"
      ],
      "@brainstrike/agent/client": [
        "../../packages/agent/src/client.ts"
      ],
      "@brainstrike/agent/local-llm": [
        "../../packages/agent/src/local-llm.ts"
      ],
      "@brainstrike/utils": [
        "../../packages/utils/src/index.ts"
      ],
      "@brainstrike/utils/*": [
        "../../packages/utils/src/*"
      ],
      "@brainstrike/preferences/*": [
        "../../packages/preferences/src/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "strictNullChecks": true
  },
  "include": [
    "src",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "e2e",
    "vite.config.mts",
    "vitest.config.*",
    "vitest.config.unit.ts",
    "vitest.config.integration.ts"
  ],
  "references": [
    {
      "path": "../../packages/app-shell"
    },
    {
      "path": "../../packages/agent/tsconfig.build.json"
    },
    {
      "path": "../../packages/db"
    },
    {
      "path": "../../packages/embeddings"
    },
    {
      "path": "../../packages/file-explorer"
    },
    {
      "path": "../../packages/file-explorer-hooks"
    },
    {
      "path": "../../packages/file-explorer-ui"
    },
    {
      "path": "../../packages/hooks"
    },
    {
      "path": "../../packages/queue"
    },
    {
      "path": "../../packages/server-config"
    },
    {
      "path": "../../packages/types"
    },
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/utils"
    }
  ]
}
