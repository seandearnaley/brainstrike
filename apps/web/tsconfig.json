{
	"extends": "../../packages/config/tsconfig/base.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"allowImportingTsExtensions": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
                "paths": {
                        "@web/*": ["./src/*"]
                },
		"types": ["node", "vitest", "@testing-library/jest-dom", "vite/client"]
	},
        "include": ["src", "vite.config.mts", "vitest.config.ts", "vitest.config.unit.ts", "vitest.config.integration.ts", "playwright.config.ts", "e2e"],
	"exclude": ["node_modules", "dist", "build", "coverage"],
	"references": [
		{"path": "../../packages/app-shell"},
		{"path": "../../packages/fonts"},
		{"path": "../../packages/hooks"},
		{"path": "../../packages/server-config"},
		{"path": "../../packages/types"},
		{"path": "../../packages/ui"},
		{"path": "../../packages/utils"},
		{"path": "../../packages/file-explorer"},
		{"path": "../../packages/file-explorer-hooks"},
		{"path": "../../packages/file-explorer-ui"}
	]
}
