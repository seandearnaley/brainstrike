{
	"extends": "../../packages/config/tsconfig/base.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"outDir": "dist",
		"paths": {
			"@/*": ["./src/*"],
			"@brainstrike/hooks": ["../../packages/hooks"],
			"@brainstrike/hooks/*": ["../../packages/hooks/*"],
			"@brainstrike/types": ["../../packages/types"],
			"@brainstrike/types/*": ["../../packages/types/*"],
			"@brainstrike/ui": ["../../packages/ui"],
			"@brainstrike/ui/*": ["../../packages/ui/*"],
			"@brainstrike/utils": ["../../packages/utils"],
			"@brainstrike/utils/*": ["../../packages/utils/*"]
		},
		"types": ["node", "vitest", "@testing-library/jest-dom", "vite/client"]
	},
	"include": ["src", "vite.config.mts", "vitest.config.ts", "vitest.config.unit.ts", "vitest.config.integration.ts", "vitest.setup.ts"],
	"exclude": ["node_modules", "dist", "build", "coverage"],
	"references": [
		{"path": "../../packages/hooks"},
		{"path": "../../packages/types"},
		{"path": "../../packages/ui"},
		{"path": "../../packages/utils"}
	]
}
