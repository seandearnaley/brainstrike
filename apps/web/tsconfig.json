{
	"extends": "../../packages/config/tsconfig/base.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"outDir": "dist",
		"paths": {
			"@/*": ["./src/*"],
			"@brainstrike/types": ["../../packages/types", "../../packages/types/dist", "../../packages/types/index.ts"],
			"@brainstrike/hooks": ["../../packages/hooks", "../../packages/hooks/dist", "../../packages/hooks/index.ts"],
			"@brainstrike/ui": ["../../packages/ui", "../../packages/ui/dist", "../../packages/ui/index.ts"],
			"@brainstrike/utils": ["../../packages/utils", "../../packages/utils/dist", "../../packages/utils/index.ts"]
		},
		"types": ["node", "vitest", "@testing-library/jest-dom", "vite/client"]
	},
	"include": ["src", "vite.config.mts", "vitest.config.ts", "vitest.config.unit.ts", "vitest.config.integration.ts", "vitest.setup.ts"],
	"exclude": ["node_modules", "dist", "build", "coverage"],
	"references": [
		{"path": "../../packages/hooks"},
		{"path": "../../packages/types"},
		{"path": "../../packages/ui"},
		{"path": "../../packages/utils"}
	]
}
