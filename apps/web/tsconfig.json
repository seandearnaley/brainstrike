{
	"extends": "@brainstrike/tsconfig/base.json",
	"compilerOptions": {
		"forceConsistentCasingInFileNames": true,
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"target": "es2020",
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node", "vitest", "@testing-library/jest-dom", "vite/client"]
	},
	"include": ["**/*.ts", "**/*.tsx", "vite.config.mts"],
	"exclude": ["node_modules", "dist", "build", "coverage"]
}
