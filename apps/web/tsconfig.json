{
	"extends": "../../packages/config/tsconfig/base.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"outDir": "dist",
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node", "vitest", "@testing-library/jest-dom", "vite/client"]
	},
        "include": ["src", "vite.config.mts", "vitest.config.ts", "vitest.config.unit.ts", "vitest.config.integration.ts"],
	"exclude": ["node_modules", "dist", "build", "coverage"],
	"references": [
		{"path": "../../packages/hooks"},
		{"path": "../../packages/types"},
		{"path": "../../packages/ui"},
		{"path": "../../packages/utils"},
		{"path": "../../packages/file-explorer"},
		{"path": "../../packages/file-explorer-hooks"},
		{"path": "../../packages/file-explorer-ui"}
	]
}
