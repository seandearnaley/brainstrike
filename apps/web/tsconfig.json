{
	"extends": "../../packages/config/tsconfig/base.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"outDir": "dist",
                "paths": {
                        "@/*": ["./src/*"],
                        "@brainstrike/file-explorer-app": ["../../packages/file-explorer-app/src"]
                },
		"types": ["node", "vitest", "@testing-library/jest-dom", "vite/client"]
	},
	"include": ["src", "vite.config.mts", "vitest.config.ts", "vitest.config.unit.ts", "vitest.config.integration.ts", "vitest.setup.ts"],
	"exclude": ["node_modules", "dist", "build", "coverage"],
	"references": [
		{"path": "../../packages/hooks"},
		{"path": "../../packages/types"},
		{"path": "../../packages/ui"},
		{"path": "../../packages/utils"},
		{"path": "../../packages/file-explorer"},
		{"path": "../../packages/file-explorer-hooks"},
                {"path": "../../packages/file-explorer-ui"}
                ,{"path": "../../packages/file-explorer-app"}
        ]
}
