{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "Node16",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": false
  },
  "include": [
    "./**/*.ts"
  ]
}
