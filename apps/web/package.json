    "remark-gfm": "^4.0.1",
    "serve": "^14.2.5",
    "shiki": "^3.23.0",
    "tailwindcss": "^4.2.1",
    "terser": "^5.46.0",
    "tiktoken": "^1.0.22",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-static-copy": "^4.0.0",
