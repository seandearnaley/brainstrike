{
  "name": "@brainstrike/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port 8080 --host",
    "build": "vite build",
    "start": "vite preview --port 8080 --host",
    "lint": "pnpm run --filter brainstrike lint",
    "format": "biome format --write .",
    "type-check": "tsc --build --force && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "pnpm -w test:coverage",
    "test:e2e": "npx playwright test --project=functional",
    "test:e2e:functional": "npx playwright test --project=functional",
    "test:e2e:perf": "npx playwright test --project=performance",
    "test:e2e:full-browsers": "PLAYWRIGHT_FULL_BROWSER_COVERAGE=1 npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "serve-static": "serve dist -p 8080"
  },
  "dependencies": {
    "assistant-stream": "^0.2.24",
    "zod": "^3.25.76",
    "@brainstrike/app-shell": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/server-config": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "^3.2.6",
    "monaco-editor": "^0.52.2",
    "playwright": "^1.54.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@biomejs/biome": "2.2.4",
    "@brainstrike/config": "workspace:*",
    "@brainstrike/tailwind-config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@brainstrike/build-utils": "workspace:*",
    "@codecov/vite-plugin": "^1.9.1",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^3.2.4",
    "glob": "^11.0.3",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^26.1.0",
    "knip": "^5.62.0",
    "serve": "^14.2.4",
    "tailwindcss": "^4.1.12",
    "terser": "^5.43.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite": "^7.1.2",
    "vite-plugin-static-copy": "^3.1.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^3.2.4"
  }
}
