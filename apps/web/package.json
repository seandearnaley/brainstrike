{
  "name": "@brainstrike/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 8080 --host",
    "build": "vite build",
    "start": "vite preview --port 8080 --host",
    "lint": "pnpm run --filter brainstrike lint",
    "format": "biome format --write .",
    "type-check": "tsc --build --force && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "serve-static": "serve dist -p 8080"
  },
  "dependencies": {
    "@brainstrike/app-shell": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/server-config": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "^3.2.6",
    "monaco-editor": "^0.52.2",
    "playwright": "^1.53.0",
    "react": "^19",
    "react-dom": "^19",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@biomejs/biome": "1.9.4",
    "@brainstrike/tailwind-config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@codecov/vite-plugin": "^1.9.1",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.3",
    "@vitest/ui": "^3.2.3",
    "glob": "^11.0.3",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^26.1.0",
    "knip": "^5.61.0",
    "serve": "^14.2.4",
    "tailwindcss": "^4.1.10",
    "terser": "^5.42.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^3.0.2",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.2.3"
  }
}