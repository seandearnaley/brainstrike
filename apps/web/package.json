{
  "name": "@brainstrike/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "pnpm turbo build --filter=@brainstrike/file-explorer",
    "dev": "vite --port 8080 --host",
    "build": "vite build",
    "start": "vite preview --port 8080 --host",
    "lint": "pnpm run --filter brainstrike lint",
    "format": "biome format --write .",
    "type-check": "tsc --build --force && tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "pnpm -w test:coverage",
    "test:e2e": "npx playwright test --project=functional",
    "test:e2e:functional": "npx playwright test --project=functional",
    "test:e2e:perf": "npx playwright test --project=performance",
    "test:e2e:full-browsers": "PLAYWRIGHT_FULL_BROWSER_COVERAGE=1 npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "serve-static": "serve dist -p 8080"
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/app-shell": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-import": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/preferences": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/server-config": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/vector-management": "workspace:*",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "^3.3.1",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.12.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@biomejs/biome": "2.3.11",
    "@brainstrike/build-utils": "workspace:*",
    "@brainstrike/config": "workspace:*",
    "@brainstrike/tailwind-config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@codecov/vite-plugin": "^1.9.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.17",
    "glob": "^13.0.0",
    "jsdom": "26.1.0",
    "knip": "^5.80.2",
    "serve": "^14.2.5",
    "tailwindcss": "^4.1.18",
    "terser": "^5.44.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.17"
  }
}
