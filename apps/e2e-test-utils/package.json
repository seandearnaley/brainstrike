{
  "name": "@brainstrike/e2e-test-utils",
  "description": "Shared Playwright helpers for Brainstrike end-to-end tests",
  "version": "0.1.0",
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "exports": {
    "./popup-animations": "./popup-animations.ts",
    "./settings-test-overrides": "./settings-test-overrides.ts"
  },
  "private": true,
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module"
}
