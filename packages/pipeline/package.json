{
  "name": "@brainstrike/pipeline",
  "description": "Indexing pipeline orchestrator for File → Chunk → Embed → Vector flows",
  "version": "0.0.1",
  "dependencies": {
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "lint": "ultracite check src",
    "lint:fix": "ultracite fix src",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
