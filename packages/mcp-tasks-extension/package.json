{
  "name": "@brainstrike/mcp-tasks-extension",
  "description": "Pinned schemas and parsers for the official MCP Tasks extension",
  "version": "0.1.0",
  "dependencies": {
    "@modelcontextprotocol/core": "catalog:",
    "zod": "catalog:",
    "effect": "catalog:",
    "@brainstrike/assistant-contract": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@effect/tsgo": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./task": "./src/task.ts"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "sideEffects": false,
  "type": "module"
}
