{
  "name": "@brainstrike/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated desktop derived SQLite index process (ADR-0018)",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport.ts",
    "./host": "./src/process-core.ts",
    "./metadata": "./src/metadata-reader.ts",
    "./coverage-reader": "./src/coverage-reader.ts",
    "./test-fixtures/state-observation-schema": "./__tests__/fixtures/state-observation-schema.ts"
  },
  "sideEffects": false,
  "dependencies": {
    "@brainstrike/chunking-worker": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/secure-fs-native": "workspace:*",
    "@brainstrike/sqlite-native": "workspace:*",
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "electron": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  }
}
