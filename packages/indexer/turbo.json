{
  "extends": [
    "//"
  ],
  "tasks": {
    "test": {
      "dependsOn": [
        "topo",
        "build"
      ]
    },
    "test:integration": {
      // state-observation-vectors starts the state-store writer worker, which
      // imports agent-host's emitted memory calculator.
      "dependsOn": [
        "topo",
        "build",
        "@brainstrike/agent-host#build"
      ],
      "cache": false
    },
    "test:coverage": {
      // Coverage runs the same integration suites; see test:integration.
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "build",
        "@brainstrike/agent-host#build"
      ],
      "cache": false
    }
  }
}
