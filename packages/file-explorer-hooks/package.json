{
  "name": "@brainstrike/file-explorer-hooks",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:types": "tsc src/index.ts --declaration --emitDeclarationOnly --outDir dist --moduleResolution bundler --module esnext --target es2020 --lib dom,es2020 --skipLibCheck --jsx react-jsx",
    "build:js": "tsup src/index.ts --format esm,cjs --out-dir dist --no-clean",
    "build": "pnpm run build:types && pnpm run build:js",
    "dev": "pnpm run build:types && tsup src/index.ts --format esm,cjs --out-dir dist --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "dependencies": {
    "@brainstrike/file-explorer": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/file-cache": "workspace:*",
    "@brainstrike/hooks": "workspace:*",
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "license": "ISC",
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/react": "^16",
    "@types/react": "^19.1.7",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.3",
    "tsup": "^8",
    "vitest": "^3.2.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}
