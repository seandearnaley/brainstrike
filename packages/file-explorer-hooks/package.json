{
  "name": "@brainstrike/file-explorer-hooks",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build:types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "build:js": "tsup",
    "build": "pnpm run build:types && pnpm run build:js",
    "dev":   "pnpm run build:types && tsup --watch",
    "test":  "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "dependencies": {
    "@brainstrike/file-explorer": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/hooks": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "license": "ISC",
  "devDependencies": {
    "tsup": "^8",
    "@types/react": "^19.0.0",
    "@testing-library/react": "^16",
    "@brainstrike/test-utils": "workspace:*"
  }
}
