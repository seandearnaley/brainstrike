{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist",
    "paths": {
      "@brainstrike/file-explorer": ["../file-explorer/src"],
      "@brainstrike/types": ["../types/src"],
      "@brainstrike/ui": ["../ui/src"],
      "@brainstrike/utils": ["../utils/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    { "path": "../file-explorer" },
    { "path": "../types" },
    { "path": "../ui" },
    { "path": "../utils" }
  ]
}
