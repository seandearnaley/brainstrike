{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist",
    "paths": {
      "@brainstrike/types": ["../types/src"],
      "@brainstrike/types/*": ["../types/src/*"],
      "@brainstrike/hooks": ["../hooks/src"],
      "@brainstrike/hooks/*": ["../hooks/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    { "path": "../types" },
    { "path": "../hooks" }
  ]
}
