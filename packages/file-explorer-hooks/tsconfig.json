{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "paths": {
      "@brainstrike/utils/*": [
        "../utils/dist/*.d.ts"
      ]
    },
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "src",
    "declarationMap": true,
    "types": [
      "node"
    ],
    "strictNullChecks": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../file-explorer"
    },
    {
      "path": "../file-system"
    },
    {
      "path": "../hooks"
    },
    {
      "path": "../platform-utils"
    },
    {
      "path": "../types"
    },
    {
      "path": "../ui"
    },
    {
      "path": "../utils"
    },
    {
      "path": "../workers"
    }
  ]
}
