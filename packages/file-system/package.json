{
  "name": "@brainstrike/file-system",
  "description": "Platform-aware file system adapters for desktop",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "electron": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./electron": "./src/electron.ts",
    "./file-node-handles": "./src/file-node-handles.ts",
    "./path-validation": "./src/path-validation.ts",
    "./directory-tree": "./src/directory-tree.ts",
    "./workspace-root-nodes": "./src/workspace-root-nodes.ts",
    "./config": "./src/config.ts",
    "./secure-file-read": "./src/secure-file-read.ts",
    "./workspace-scan": "./src/workspace-scan.ts",
    "./workspace-scan-paths": "./src/workspace-scan-paths.ts",
    "./workspace-source-content": "./src/workspace-source-content.ts",
    "./workspace-scan-reconciliation": "./src/workspace-scan-reconciliation.ts",
    "./workspace-indexing-coordinator": "./src/workspace-indexing-coordinator.ts",
    "./native-watch": "./src/native-watch.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "type": "module"
}
