{
  "name": "@brainstrike/file-system",
  "description": "Platform-aware file system adapters for desktop",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@parcel/watcher": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "electron": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "esbuild": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./electron": {
      "types": "./src/electron.ts",
      "default": "./dist/electron.js"
    },
    "./file-node-handles": {
      "types": "./src/file-node-handles.ts",
      "default": "./dist/file-node-handles.js"
    },
    "./path-validation": {
      "types": "./src/path-validation.ts",
      "default": "./dist/path-validation.js"
    },
    "./testing/watcher-liveness": {
      "types": "./src/testing/watcher-liveness.ts",
      "default": "./dist/testing/watcher-liveness.js"
    },
    "./testing/parcel-producer": {
      "types": "./src/testing/parcel-producer.ts",
      "default": "./dist/testing/parcel-producer.js"
    },
    "./directory-tree": {
      "types": "./src/directory-tree.ts",
      "default": "./dist/directory-tree.js"
    },
    "./workspace-root-nodes": {
      "types": "./src/workspace-root-nodes.ts",
      "default": "./dist/workspace-root-nodes.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./secure-file-read": {
      "types": "./src/secure-file-read.ts",
      "default": "./dist/secure-file-read.js"
    },
    "./workspace-scan": {
      "types": "./src/workspace-scan.ts",
      "default": "./dist/workspace-scan.js"
    },
    "./workspace-scan-paths": {
      "types": "./src/workspace-scan-paths.ts",
      "default": "./dist/workspace-scan-paths.js"
    },
    "./workspace-source-content": {
      "types": "./src/workspace-source-content.ts",
      "default": "./dist/workspace-source-content.js"
    },
    "./workspace-scan-reconciliation": {
      "types": "./src/workspace-scan-reconciliation.ts",
      "default": "./dist/workspace-scan-reconciliation.js"
    },
    "./workspace-indexing-coordinator": {
      "types": "./src/workspace-indexing-coordinator.ts",
      "default": "./dist/workspace-indexing-coordinator.js"
    },
    "./native-watch": {
      "types": "./src/native-watch.ts",
      "default": "./dist/native-watch.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:packaged": "node ../../scripts/run-env.mjs ELECTRON_RUN_AS_NODE=1 -- pnpm --filter @brainstrike/desktop exec electron ../../packages/file-system/test/parcel-packaged-smoke.cjs",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "validate:parcel-binding": "node scripts/validate-parcel-binding.mjs"
  },
  "type": "module",
  "types": "./src/index.ts"
}
