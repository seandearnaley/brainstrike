{
  "name": "@brainstrike/file-system",
  "description": "Platform-aware file system adapters for web and desktop",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "^43.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "import": "./dist/electron.js",
      "require": "./dist/electron.cjs"
    },
    "./path-validation": {
      "types": "./dist/path-validation.d.ts",
      "import": "./dist/path-validation.js",
      "require": "./dist/path-validation.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "optionalDependencies": {
    "chokidar": "^5.0.0"
  },
  "scripts": {
    "build": "tsc -b . && tsup",
    "build:types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose & tsup --watch",
    "mutation": "npx @stryker-mutator/core run",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
