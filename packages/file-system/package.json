{
  "name": "@brainstrike/file-system",
  "version": "0.1.0",
  "description": "Platform-aware file system adapters for web and desktop",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./path-validation": {
      "types": "./dist/path-validation.d.ts",
      "import": "./dist/path-validation.js",
      "require": "./dist/path-validation.cjs"
    }
  },
  "scripts": {
    "build": "tsc && tsup",
    "build:types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose & tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage",
    "mutation": "npx @stryker-mutator/core run",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "dependencies": {
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "optionalDependencies": {
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/typescript-checker": "^9.4.0",
    "@stryker-mutator/vitest-runner": "^9.4.0",
    "@types/node": "^24.10.7",
    "electron": "^39.2.7",
    "jsdom": "26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
