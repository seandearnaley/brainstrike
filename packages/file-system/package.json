{
  "name": "@brainstrike/file-system",
  "description": "Platform-aware file system adapters for web and desktop",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@parcel/watcher": "catalog:",
    "idb": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "electron": "catalog:",
    "fake-indexeddb": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "import": "./dist/electron.js",
      "require": "./dist/electron.js"
    },
    "./path-validation": {
      "types": "./dist/path-validation.d.ts",
      "import": "./dist/path-validation.js",
      "require": "./dist/path-validation.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --build --watch --preserveWatchOutput",
    "mutation": "npx @stryker-mutator/core run",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:packaged": "node ../../scripts/run-env.mjs ELECTRON_RUN_AS_NODE=1 -- pnpm --filter @brainstrike/desktop exec electron ../../packages/file-system/test/parcel-packaged-smoke.cjs",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "validate:parcel-binding": "node scripts/validate-parcel-binding.mjs"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
