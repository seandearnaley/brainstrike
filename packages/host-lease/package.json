{
  "name": "@brainstrike/host-lease",
  "version": "0.1.0",
  "description": "Shared data-root host discovery and lifecycle lease (BST-1941)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/secure-fs-native": "workspace:*",
    "@brainstrike/state-store": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@brainstrike/windows-job-native": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./lifecycle-delays": "./src/lifecycle-delays.ts"
  },
  "scripts": {
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  }
}
