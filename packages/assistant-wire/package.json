{
  "name": "@brainstrike/assistant-wire",
  "version": "0.1.0",
  "dependencies": {},
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/rimraf.mjs dist && tsc && tsup",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --watch",
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "types": "./src/index.ts"
}
