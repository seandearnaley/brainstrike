{
  "name": "@brainstrike/chunking-worker",
  "description": "Web Worker for off-main-thread file chunking with AST-aware code splitting and token counting.",
  "version": "0.1.0",
  "dependencies": {
    "@babel/parser": "^8.0.0",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "tiktoken": "^1.0.22",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "oxc-parser": "^0.131.0",
    "rimraf": "^6.1.3",
    "tree-sitter-wasms": "^0.1.13",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/chunking.worker.d.ts",
      "import": "./dist/chunking.worker.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "clean": "rimraf dist",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint --filter @brainstrike/chunking-worker",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
