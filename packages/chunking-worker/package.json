{
  "name": "@brainstrike/chunking-worker",
  "description": "Web Worker for off-main-thread file chunking with AST-aware code splitting and token counting.",
  "version": "0.1.0",
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "effect": "catalog:",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxc-parser": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/chunking.worker.d.ts",
      "import": "./dist/chunking.worker.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsup --config ./tsup.config.ts && node ../../scripts/verify-tokenizer-asset-bundle.mjs dist",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --strict",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
