{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "rootDir": ".",
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "@vitest/browser-playwright"
    ]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "bench/*.spec.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
