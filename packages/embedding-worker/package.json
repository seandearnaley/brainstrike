{
  "name": "@brainstrike/embedding-worker",
  "version": "0.1.0",
  "description": "Transformers.js embedding worker for browser and Electron renderer pools.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/embedding.worker.d.ts",
      "import": "./dist/embedding.worker.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup --config ./tsup.config.ts",
    "clean": "rimraf dist",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint --filter @brainstrike/embedding-worker",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@brainstrike/types": "workspace:*",
    "@huggingface/transformers": "^3.8.0",
    "workerpool": "^10.0.1"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
