{
  "name": "@brainstrike/embedding-worker",
  "description": "Transformers.js embedding worker for browser and Electron renderer pools.",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*",
    "@huggingface/transformers": "catalog:",
    "workerpool": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/build-utils": "workspace:*",
    "@brainstrike/config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "playwright": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./dist/embedding.worker.d.ts",
      "import": "./dist/embedding.worker.js",
      "require": "./dist/embedding.worker.cjs"
    },
    "./pipeline-cache-controller": {
      "types": "./dist/pipeline-cache-controller.d.ts",
      "import": "./dist/pipeline-cache-controller.js",
      "require": "./dist/pipeline-cache-controller.cjs"
    },
    "./test-runtime-bootstrap": {
      "types": "./dist/test-runtime-bootstrap.d.ts",
      "import": "./dist/test-runtime-bootstrap.js",
      "require": "./dist/test-runtime-bootstrap.cjs"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup --config ./tsup.config.ts",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:webgpu-memory": "VITEST_RUN_WEBGPU_MEMORY=true vitest run --project browser test/webgpu-memory-growth.browser.test.ts",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": [
    "./dist/embedding.worker.cjs",
    "./dist/embedding.worker.js"
  ],
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
