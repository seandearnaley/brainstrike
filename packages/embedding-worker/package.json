{
  "name": "@brainstrike/embedding-worker",
  "description": "Transformers.js embedding worker for browser and Electron renderer pools.",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*",
    "@huggingface/transformers": "catalog:",
    "workerpool": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/build-utils": "workspace:*",
    "@brainstrike/config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "playwright": "catalog:",
    "@vitest/browser-playwright": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/embedding.worker.ts",
    "./pipeline-cache-controller": "./src/pipeline-cache-controller.ts",
    "./test-runtime-bootstrap": "./src/test-runtime-bootstrap.ts",
    "./testing": "./src/testing.ts",
    "./vite": "./src/vite.ts"
  },
  "private": true,
  "scripts": {
    "lint": "pnpm -w lint",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:webgpu-memory": "node ../../scripts/run-env.mjs VITEST_RUN_WEBGPU_MEMORY=true -- vitest run --project browser test/webgpu-memory-growth.browser.test.ts",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": [
    "./src/embedding.worker.ts"
  ],
  "type": "module"
}
