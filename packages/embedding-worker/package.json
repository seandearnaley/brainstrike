{
  "name": "@brainstrike/embedding-worker",
  "description": "Transformers.js embedding worker for browser and Electron renderer pools.",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "workerpool": "^10.0.3"
  },
  "devDependencies": {
    "@brainstrike/config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./dist/embedding.worker.d.ts",
      "import": "./dist/embedding.worker.js",
      "require": "./dist/embedding.worker.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup --config ./tsup.config.ts",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint --filter @brainstrike/embedding-worker",
    "test": "vitest run",
    "test:webgpu-memory": "VITEST_RUN_WEBGPU_MEMORY=true vitest run --project browser test/webgpu-memory-growth.browser.test.ts",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
