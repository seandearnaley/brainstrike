{
  "name": "@brainstrike/file-cache",
  "version": "0.1.0",
  "description": "Persistent file caching using PGlite database",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b . && tsup",
    "build:types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose & tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@brainstrike/platform-utils": "workspace:*",
    "@electric-sql/pglite": "^0.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "@vitest/coverage-v8": "^3.2.3",
    "electron": "36.4.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.2.3"
  }
}