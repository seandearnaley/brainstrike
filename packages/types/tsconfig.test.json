{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node"
    ],
    "skipLibCheck": true,
    "rootDir": "..",
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "**/*.test.*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}