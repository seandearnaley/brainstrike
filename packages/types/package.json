{
	"name": "@brainstrike/types",
	"version": "0.1.0",
	"description": "Shared TypeScript types for Brainstrike monorepo",
	"private": true,
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p . && tsup",
		"dev": "tsup --watch",
		"clean": "rm -rf dist .tsbuildinfo",
		"lint": "pnpm run --dir=../.. lint",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage --reporter=v8 --outputFile=./coverage/coverage.json",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@swc/core": "^1.11.20",
		"typescript": "^5.8.3",
		"vitest": "^3.1.1"
	}
}
