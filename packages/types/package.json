{
  "name": "@brainstrike/types",
  "description": "Shared TypeScript types for Brainstrike monorepo",
  "version": "0.1.0",
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./agent-color": "./src/agent-color.ts",
    "./catalog-args": "./src/catalog-args/index.ts"
  },
  "license": "ISC",
  "private": true,
  "scripts": {
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "type": "module"
}
