{
	"name": "@brainstrike/types",
	"version": "0.1.0",
	"description": "Shared TypeScript types for Brainstrike monorepo",
	"private": true,
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "pnpm run clean && tsc -p . && tsup index.ts --format esm,cjs --clean=false",
		"dev": "tsup --watch",
		"clean": "rimraf dist .tsbuildinfo",
		"lint": "pnpm run --dir=../.. lint",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@swc/core": "^1.11.20",
		"@vitest/coverage-v8": "^3.1.1",
		"rimraf": "^5.0.10",
		"tsup": "^8.4.0",
		"typescript": "^5.8.3",
		"vitest": "^3.1.1"
	},
	"sideEffects": false,
	"turbo": {
		"outputs": [
			"dist/**"
		]
	}
}
