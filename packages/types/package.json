{
	"name": "@brainstrike/types",
	"version": "0.1.0",
	"description": "Shared TypeScript types for Brainstrike monorepo",
	"private": true,
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.d.ts",
			"require": "./dist/index.d.ts",
			"default": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -b .",
		"dev": "tsup --watch",
		"clean": "rm -rf dist .tsbuildinfo",
		"lint": "pnpm run --dir=../.. lint",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@swc/core": "^1.11.20",
		"@vitest/coverage-v8": "^3.1.1",
		"typescript": "^5.8.3",
		"vitest": "^3.1.1"
	},
	"turbo": {
		"outputs": ["dist/**"]
	}
}
