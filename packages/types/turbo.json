{
  "extends": ["//"],
  "tasks": {
    "topo": {
      // BST-1773 guarded pilot: executable private specs do not affect
      // downstream packages. Only executable test/spec filenames are excluded;
      // helper modules in __tests__ remain hashed. Shared fixtures must live
      // outside these filename patterns and
      // remain in $TURBO_DEFAULT$; verify-private-test-input-locality rejects
      // cross-package imports and filesystem reads before an exclusion is safe.
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*"
      ]
    }
  }
}
