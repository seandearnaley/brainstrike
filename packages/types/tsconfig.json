{
	"extends": "@brainstrike/tsconfig/base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"composite": true,
		"incremental": true,
		"tsBuildInfoFile": "./tsconfig.tsbuildinfo"
	},
	"include": [".", "./**/*.ts"],
	"exclude": ["node_modules", "dist", "__tests__"]
}
