{
  "name": "@brainstrike/test-utils",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/types": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@swc/core": "^1.15.43",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "jsdom": "29.1.1",
    "react": "^19.2.7",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./vitest.setup": "./src/vitest.setup.ts",
    "./vitest.base": {
      "types": "./dist/index.d.ts",
      "import": "./vitest.base.mjs",
      "require": "./dist/index.js"
    },
    "./electron": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./playwright": {
      "types": "./src/playwright/failure-artifacts.ts",
      "import": "./src/playwright/failure-artifacts.ts",
      "require": "./src/playwright/failure-artifacts.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "peerDependencies": {
    "@playwright/test": "^1.58.2"
  },
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsup src/index.ts --format esm,cjs --dts --out-dir dist",
    "clean": "rimraf dist .turbo",
    "dev": "tsup src/index.ts --format esm,cjs --watch --out-dir dist",
    "lint": "pnpm run --dir=../.. lint",
    "mutation": "npx @stryker-mutator/core run",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "types": "./dist/index.d.ts"
}
