{
  "name": "@brainstrike/test-utils",
  "version": "0.1.0",
  "devDependencies": {
    "@mastra/core": "1.78.0",
    "@mastra/memory": "1.38.0",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "^19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    "./fixtures/canonical-provided-chunks.json": "./fixtures/canonical-provided-chunks.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./vitest-matchers": "./vitest-matchers.d.ts",
    "./vitest.setup": "./src/vitest.setup.ts",
    "./vitest.dom-aware.setup": "./src/vitest.dom-aware.setup.ts",
    "./vitest.dom-aware-timeouts.setup": "./src/vitest.dom-aware-timeouts.setup.ts",
    "./vitest.browser.setup": "./src/vitest.browser.setup.ts",
    "./vitest.timeouts.setup": "./src/vitest.timeouts.setup.ts",
    "./vitest-provided-context": "./src/vitest-provided-context.ts",
    "./async-util-timeout-proof": "./src/async-util-timeout-proof.ts",
    "./test-timeouts": "./src/test-timeouts.ts",
    "./fixtures/committed-approved-host-run.json": "./fixtures/committed-approved-host-run.json",
    "./fixtures/committed-approved-host-run-telemetry.json": "./fixtures/committed-approved-host-run-telemetry.json",
    "./fixtures/committed-host-ended-runs.json": "./fixtures/committed-host-ended-runs.json",
    "./fixtures/committed-host-granted-run.json": "./fixtures/committed-host-granted-run.json",
    "./fixtures/committed-host-hook-blocked.json": "./fixtures/committed-host-hook-blocked.json",
    "./fixtures/committed-host-hooks-skipped.json": "./fixtures/committed-host-hooks-skipped.json",
    "./fixtures/committed-host-answerless-runs.json": "./fixtures/committed-host-answerless-runs.json",
    "./fixtures/committed-host-incremental-tool-input.json": "./fixtures/committed-host-incremental-tool-input.json",
    "./fixtures/committed-host-mcp-unavailable.json": "./fixtures/committed-host-mcp-unavailable.json",
    "./fixtures/committed-host-plan.json": "./fixtures/committed-host-plan.json",
    "./fixtures/committed-host-question.json": "./fixtures/committed-host-question.json",
    "./fixtures/committed-host-rewinds.json": "./fixtures/committed-host-rewinds.json",
    "./fixtures/committed-host-run-attempts.json": "./fixtures/committed-host-run-attempts.json",
    "./fixtures/committed-rich-host-runs.json": "./fixtures/committed-rich-host-runs.json",
    "./fixtures/recorded-grep-patterns.json": "./fixtures/recorded-grep-patterns.json",
    "./fixtures/observation-memory": "./fixtures/observation-memory.mjs",
    "./vitest.base": {
      "types": "./src/vitest.base.ts",
      "default": "./vitest.base.mjs"
    },
    "./vitest-lost-file-reporter": "./vitest-lost-file-reporter.mjs",
    "./workspace-src-aliases": "./workspace-src-aliases.mjs",
    "./electron": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./src/playwright/failure-artifacts.ts",
      "default": "./src/playwright/failure-artifacts.ts"
    },
    "./provider-cassette": {
      "types": "./src/provider-cassette.ts",
      "default": "./src/provider-cassette.ts"
    }
  },
  "files": [
    "dist/**",
    "fixtures/*.json",
    "fixtures/observation-memory.mjs"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "@playwright/test": "^1.58.2"
  },
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "types": "./src/index.ts",
  "type": "module"
}
