{
  "name": "@brainstrike/queue-telemetry-collector",
  "description": "HTTP collector for embedding queue telemetry batches.",
  "version": "0.1.0",
  "bin": {
    "brainstrike-queue-telemetry-collector": "./dist/cli.js"
  },
  "dependencies": {
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup --config tsup.config.ts",
    "clean": "rimraf dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "lint": "pnpm -w lint --filter @brainstrike/queue-telemetry-collector",
    "start": "pnpm run build && node --enable-source-maps dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
