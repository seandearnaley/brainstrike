{
  "name": "@brainstrike/queue-telemetry-collector",
  "version": "0.1.0",
  "description": "HTTP collector for embedding queue telemetry batches.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "brainstrike-queue-telemetry-collector": "./dist/cli.cjs"
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup src/index.ts src/cli.ts --format esm,cjs --out-dir dist",
    "clean": "rimraf dist",
    "dev": "tsup src/index.ts src/cli.ts --format esm,cjs --out-dir dist --watch",
    "lint": "pnpm -w lint --filter @brainstrike/queue-telemetry-collector",
    "start": "pnpm run build && node --enable-source-maps dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
