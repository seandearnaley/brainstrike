{
  "name": "@brainstrike/secure-fs-native",
  "version": "0.1.0",
  "description": "Descriptor-relative filesystem capabilities for trusted desktop roots",
  "dependencies": {
    "bindings": "1.5.0"
  },
  "devDependencies": {
    "node-addon-api": "8.9.0",
    "node-gyp": "13.0.1"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    }
  },
  "gypfile": true,
  "main": "./index.cjs",
  "scripts": {
    "build": "node-gyp rebuild",
    "test": "node --test test/*.test.cjs",
    "test:coverage": "pnpm test",
    "test:electron": "pnpm build && pnpm --filter @brainstrike/desktop exec xvfb-maybe electron --no-sandbox ../../packages/secure-fs-native/test/electron-smoke.cjs",
    "test:packaged": "node ../../scripts/run-env.mjs ELECTRON_RUN_AS_NODE=1 -- pnpm --filter @brainstrike/desktop exec electron ../../packages/secure-fs-native/test/packaged-smoke.cjs",
    "type-check": "node --check index.cjs"
  },
  "types": "./index.d.ts"
}
