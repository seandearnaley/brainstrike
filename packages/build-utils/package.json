{
  "name": "@brainstrike/build-utils",
  "version": "0.1.0",
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "^25.9.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "private": true,
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup --config ./tsup.config.ts",
    "clean": "node ../../scripts/rimraf.mjs dist",
    "lint": "pnpm run --dir=../.. lint",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "types": "./dist/index.d.ts"
}
