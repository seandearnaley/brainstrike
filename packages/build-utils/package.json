{
  "name": "@brainstrike/build-utils",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup src/index.ts --format esm,cjs --out-dir dist",
    "clean": "rm -rf dist",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage"
  },
  "dependencies": {
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "^24.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
