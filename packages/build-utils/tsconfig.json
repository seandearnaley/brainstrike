{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*"
  ],
