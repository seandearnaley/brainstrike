{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "src",
    "declarationMap": true,
    "types": ["node"],
    "paths": {
      "@brainstrike/utils": ["../utils/src"],
      "@brainstrike/utils/src/*": ["../utils/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"],
  "references": [{ "path": "../utils" }]
}
