// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`StatusBar > Snapshots > renders empty status bar 1`] = `
<footer
  class="grid h-6 grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center px-2 border-border border-t bg-muted/50 text-muted-foreground text-xs"
  data-testid="status-bar"
>
  <div
    class="col-start-1 flex min-w-0 items-center gap-2 justify-self-start"
    data-testid="status-bar-left"
  />
  <div
    class="col-start-3 flex min-w-0 items-center gap-2 justify-self-end"
    data-testid="status-bar-right"
  />
</footer>
`;

exports[`StatusBar > Snapshots > renders with all slots filled 1`] = `
