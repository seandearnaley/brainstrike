    "react-markdown": "^10.1.0",
    "react-resizable-panels": "catalog:",
    "react-shiki": "catalog:",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "catalog:",
    "remark-math": "^6.0.0",
