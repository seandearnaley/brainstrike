{
  "name": "@brainstrike/ui",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "description": "UI component library with Shadcn UI components",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "icons"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -b . && cp src/globals.css dist/globals.css && cp styles.css dist/styles.css && mkdir -p dist/assistant-ui-panel && cp src/assistant-ui-panel/overrides.css dist/assistant-ui-panel/overrides.css",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./assistant-ui-panel": {
      "import": "./dist/assistant-ui-panel/assistant-ui-panel.js",
      "types": "./dist/assistant-ui-panel/assistant-ui-panel.d.ts"
    },
    "./globals.css": "./dist/globals.css",
    "./styles.css": "./styles.css",
    "./icons": "./icons/index.ts",
    "./icons/*": "./icons/*",
    "./preflight.css": "./dist/preflight.css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@assistant-ui/react": "^0.11.6",
    "@assistant-ui/react-data-stream": "^0.11.0",
    "@assistant-ui/styles": "^0.2.1",
    "@assistant-ui/react-markdown": "^0.11.0",
    "remark-gfm": "^4.0.0",
    "assistant-stream": "^0.2.24",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/hooks": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "react-resizable-panels": "^3.0.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/json-schema": "^7.0.15",
    "@types/react": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "react-router-dom": "^7.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
