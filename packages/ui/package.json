    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-toast": "^1.2.18",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "@tanstack/react-virtual": "^3.14.5",
    "assistant-stream": "0.3.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.0",
    "motion": "^12.42.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.1",
    "react-shiki": "^0.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "catalog:",
    "react-router-dom": "catalog:",
    "tailwindcss": "^4.3.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assistant-ui-panel": {
      "types": "./dist/assistant-ui-panel/index.d.ts",
      "import": "./dist/assistant-ui-panel/index.js"
    },
    "./assistant-ui-panel/context-usage-store": {
      "types": "./dist/assistant-ui-panel/context-usage-store.d.ts",
      "import": "./dist/assistant-ui-panel/context-usage-store.js"
    },
    "./assistant-ui-panel/follow-up-queue-store": {
      "types": "./dist/assistant-ui-panel/follow-up-queue-store.d.ts",
      "import": "./dist/assistant-ui-panel/follow-up-queue-store.js"
    },
    "./markdown-surface": {
      "types": "./dist/markdown-surface/index.d.ts",
      "import": "./dist/markdown-surface/index.js"
    },
    "./globals.css": "./dist/globals.css",
    "./styles.css": "./styles.css",
    "./icons": "./icons/index.ts",
    "./icons/*": "./icons/*"
  },
  "files": [
    "dist",
    "icons"
  ],
  "keywords": [],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "packageManager": "pnpm@10.33.0",
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1"
  },
  "scripts": {
    "build": "pnpm run clean:generated && tsc -b . && node ../../scripts/copy-files.mjs src/globals.css dist/globals.css styles.css dist/styles.css src/assistant-ui-panel/overrides.css dist/assistant-ui-panel/overrides.css",
    "clean": "pnpm run clean:generated && node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "clean:generated": "node ../../scripts/clean-generated-js.mjs src",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "lint": "pnpm -w lint",
    "test": "pnpm run clean:generated && vitest run --project unit",
    "test:browser": "pnpm run clean:generated && vitest run --project browser",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
