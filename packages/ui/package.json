{
  "name": "@brainstrike/ui",
  "description": "UI component library with Shadcn UI components",
  "version": "1.0.0",
  "author": "",
  "dependencies": {
    "@assistant-ui/react": "^0.12.25",
    "@assistant-ui/react-data-stream": "^0.12.11",
    "@assistant-ui/react-markdown": "^0.12.9",
    "@assistant-ui/styles": "^0.3.7",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/hooks": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "react-resizable-panels": "^4.10.0",
    "react-shiki": "^0.9.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "29.0.2",
    "react-router-dom": "^7.14.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assistant-ui-panel": {
      "types": "./dist/assistant-ui-panel/index.d.ts",
      "import": "./dist/assistant-ui-panel/index.js"
    },
    "./globals.css": "./dist/globals.css",
    "./styles.css": "./styles.css",
    "./icons": "./icons/index.ts",
    "./icons/*": "./icons/*",
    "./preflight.css": "./dist/preflight.css"
  },
  "files": [
    "dist",
    "icons"
  ],
  "keywords": [],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "packageManager": "pnpm@10.33.0",
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1"
  },
  "scripts": {
    "build": "pnpm run clean:generated && mkdir -p dist/assistant-ui-panel && tsc -b . && cp src/globals.css dist/globals.css && cp styles.css dist/styles.css && cp src/assistant-ui-panel/overrides.css dist/assistant-ui-panel/overrides.css",
    "clean": "pnpm run clean:generated && rm -rf dist .tsbuildinfo",
    "clean:generated": "find src -type f \\( -name '*.js' -o -name '*.js.map' \\) -delete",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "lint": "pnpm run --dir=../.. lint",
    "test": "pnpm run clean:generated && vitest run --project unit",
    "test:browser": "pnpm run clean:generated && vitest run --project browser",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
