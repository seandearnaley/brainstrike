{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "types": [
      "node"
    ],
    "paths": {
      "@brainstrike/utils/*": [
        "../utils/src/*"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../assistant-contract"
    },
    {
      "path": "../context-actions"
    },
    {
      "path": "../../packages/types"
    },
    {
      "path": "../utils"
    }
  ]
}
