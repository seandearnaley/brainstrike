{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals",
      "@brainstrike/test-utils/vitest-matchers"
    ],
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "**/*.test.*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
