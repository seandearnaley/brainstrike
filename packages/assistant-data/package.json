{
  "name": "@brainstrike/assistant-data",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "fractional-indexing": "^4.0.0"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./assistant-thread-metadata-merge": {
      "types": "./dist/assistant-thread-metadata-merge.d.ts",
      "import": "./dist/assistant-thread-metadata-merge.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cost-tracking": {
      "types": "./dist/cost-tracking/index.d.ts",
      "import": "./dist/cost-tracking/index.js"
    },
    "./assistant-thread-run-reaper": {
      "types": "./dist/assistant-thread-run-reaper.d.ts",
      "import": "./dist/assistant-thread-run-reaper.js"
    },
    "./assistant-memory-repository": {
      "types": "./dist/assistant-memory-repository.d.ts",
      "import": "./dist/assistant-memory-repository.js"
    },
    "./assistant-memory-resource": {
      "types": "./dist/assistant-memory-resource.d.ts",
      "import": "./dist/assistant-memory-resource.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4",
    "zustand": "^5"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "lint": "pnpm -w lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "dist/index.d.ts"
}
