{
  "name": "@brainstrike/assistant-data",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "fractional-indexing": "^4.0.0"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@effect/tsgo": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./assistant-thread-metadata-merge": "./src/assistant-thread-metadata-merge.ts",
    ".": "./src/index.ts",
    "./cost-tracking": "./src/cost-tracking/index.ts",
    "./assistant-memory-repository": "./src/assistant-memory-repository.ts",
    "./assistant-memory-resource": "./src/assistant-memory-resource.ts"
  },
  "license": "ISC",
  "peerDependencies": {
    "react": "^19.3.0",
    "zustand": "^5"
  },
  "private": true,
  "scripts": {
    "lint": "pnpm -w lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "sideEffects": false,
  "type": "module"
