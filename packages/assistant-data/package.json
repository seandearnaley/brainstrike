{
  "name": "@brainstrike/assistant-data",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "fractional-indexing": "^4.0.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@effect/tsgo": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./assistant-thread-metadata-merge": {
      "types": "./src/assistant-thread-metadata-merge.ts",
      "import": "./dist/assistant-thread-metadata-merge.js"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./cost-tracking": {
      "types": "./src/cost-tracking/index.ts",
      "import": "./dist/cost-tracking/index.js"
    },
    "./assistant-memory-repository": {
      "types": "./src/assistant-memory-repository.ts",
      "import": "./dist/assistant-memory-repository.js"
    },
    "./assistant-memory-resource": {
      "types": "./src/assistant-memory-resource.ts",
      "import": "./dist/assistant-memory-resource.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "peerDependencies": {
    "react": "^19.3.0",
    "zustand": "^5"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "pnpm -w lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./src/index.ts"
}
