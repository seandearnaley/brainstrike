{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "paths": {
      "@brainstrike/assistant-contract": [
        "../assistant-contract/dist/index.d.ts"
      ],
      "@brainstrike/assistant-contract/*": [
        "../assistant-contract/dist/*.d.ts"
      ]
    },
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "strictNullChecks": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "apiStabilityLeak": "error",
          "experimentalApiUsage": "error",
          "unstableApiUsage": "error"
        }
      }
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../assistant-contract"
    },
    {
      "path": "../db"
    },
    {
      "path": "../logging"
    },
    {
      "path": "../tokenization"
    },
    {
      "path": "../types"
    }
  ]
}
