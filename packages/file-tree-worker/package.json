{
  "name": "@brainstrike/file-tree-worker",
  "description": "Web Worker for off-main-thread file tree operations with BFS expand-all.",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*",
    "effect": "catalog:",
    "@brainstrike/effect-kit": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@effect/tsgo": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/file-tree.worker.ts"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "sideEffects": false,
  "type": "module"
}
