{
  "name": "@brainstrike/file-tree-worker",
  "description": "Web Worker for off-main-thread file tree operations with BFS expand-all.",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "catalog:",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/file-tree.worker.d.ts",
      "import": "./dist/file-tree.worker.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint --filter @brainstrike/file-tree-worker",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
