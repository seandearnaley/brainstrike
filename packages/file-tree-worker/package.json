{
  "name": "@brainstrike/file-tree-worker",
  "description": "Web Worker for off-main-thread file tree operations with BFS expand-all.",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*",
    "effect": "catalog:",
    "@brainstrike/effect-kit": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@effect/tsgo": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/file-tree.worker.d.ts",
      "import": "./dist/file-tree.worker.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.test.json --strict",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
