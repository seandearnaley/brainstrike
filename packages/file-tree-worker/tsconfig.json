{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "lib": [
      "ES2020",
      "WebWorker"
    ],
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "apiStabilityLeak": "error",
          "experimentalApiUsage": "error",
          "unstableApiUsage": "error"
        }
      }
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts"
  ],
  "references": [
    {
      "path": "../worker-runtime"
    },
    {
      "path": "../effect-kit"
    }
  ]
}
