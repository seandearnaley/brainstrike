{
  "name": "@brainstrike/context-actions",
  "description": "Headless context action system: targets, actions, registry, capability gating",
  "version": "0.1.0",
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./commands": {
      "types": "./src/commands/index.ts",
      "default": "./dist/commands/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "type": "module",
  "types": "./src/index.ts",
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*"
  }
}
