{
  "name": "@brainstrike/text-splitter",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chunking-core": {
      "types": "./dist/chunking-core.d.ts",
      "default": "./dist/chunking-core.js"
    },
    "./token-counting-heuristics": {
      "types": "./dist/token-counting-heuristics.d.ts",
      "default": "./dist/token-counting-heuristics.js"
    },
    "./token-constants": {
      "types": "./dist/token-constants.d.ts",
      "default": "./dist/token-constants.js"
    },
    "./token-utils-accurate-lite": {
      "types": "./dist/token-utils-accurate-lite.d.ts",
      "default": "./dist/token-utils-accurate-lite.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --build --watch --preserveWatchOutput",
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
