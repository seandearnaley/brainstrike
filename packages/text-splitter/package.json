{
  "name": "@brainstrike/text-splitter",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./chunking-core": {
      "types": "./dist/chunking-core.d.ts",
      "import": "./dist/chunking-core.js",
      "require": "./dist/chunking-core.cjs"
    },
    "./token-counting-heuristics": {
      "types": "./dist/token-counting-heuristics.d.ts",
      "import": "./dist/token-counting-heuristics.js",
      "require": "./dist/token-counting-heuristics.cjs"
    },
    "./token-constants": {
      "types": "./dist/token-constants.d.ts",
      "import": "./dist/token-constants.js",
      "require": "./dist/token-constants.cjs"
    },
    "./token-utils-accurate-lite": {
      "types": "./dist/token-utils-accurate-lite.d.ts",
      "import": "./dist/token-utils-accurate-lite.js",
      "require": "./dist/token-utils-accurate-lite.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup --config ./tsup.config.ts",
    "clean": "rimraf dist",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint --filter @brainstrike/text-splitter",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": [
    "dist/chunk-*.js"
  ],
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
