{
  "name": "@brainstrike/text-splitter",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/indexing-contract": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./chunking-core": {
      "types": "./src/chunking-core.ts",
      "default": "./dist/chunking-core.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./src/index.ts"
}
