{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@brainstrike/utils/token-counting-heuristics": [
        "../utils/dist/token-counting-heuristics.d.ts"
      ],
      "@brainstrike/utils/token-constants": [
        "../utils/dist/token-constants.d.ts"
      ],
      "@brainstrike/utils/token-utils-accurate-lite": [
        "../utils/dist/token-utils-accurate-lite.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts"
  ],
  "references": [
    {
      "path": "../utils"
    }
  ]
}
