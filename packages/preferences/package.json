{
  "name": "@brainstrike/preferences",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -b .",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "zustand": "^5"
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "lucide-react": "^0.562.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "jsdom": "27.4.0",
    "vitest": "^4.0.17",
    "zustand": "^5.0.10"
  },
  "license": "ISC"
}
