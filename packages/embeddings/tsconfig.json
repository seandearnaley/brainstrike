{
  "extends": "../../packages/config/tsconfig/node-library.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "apiStabilityLeak": "error",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingStarInYieldEffectGen": "error",
          "promiseInEffectSuccess": "error",
          "returnEffectInGen": "error",
          "unsafeEffectTypeAssertion": "error",
          "experimentalApiUsage": "error",
          "unstableApiUsage": "error"
        }
      }
    ],
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "src",
    "declarationMap": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@brainstrike/assistant-contract": [
        "../assistant-contract/dist/index.d.ts"
      ],
      "@brainstrike/assistant-contract/*": [
        "../assistant-contract/dist/*.d.ts"
      ]
    },
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.*",
    "**/__tests__/**"
  ],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../effect-kit"
    },
    {
      "path": "../logging"
    },
    {
      "path": "../utils"
    },
    {
      "path": "../db"
    },
    {
      "path": "../indexing-contract"
    },
    {
      "path": "../platform-utils"
    },
    {
      "path": "../embedding-worker"
    },
    {
      "path": "../assistant-contract"
    }
  ]
}
