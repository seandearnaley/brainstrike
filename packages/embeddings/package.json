{
  "name": "@brainstrike/embeddings",
  "description": "Hosted embedding providers for brainstrike",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/types": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./provider-core": "./src/provider-core.ts",
    "./factory": "./src/factory-entry.ts"
  },
  "scripts": {
    "bench": "vitest bench",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "type": "module"
}
