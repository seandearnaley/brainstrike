{
  "name": "@brainstrike/embeddings",
  "description": "BGE-M3 embedding service and components for brainstrike",
  "version": "0.1.0",
  "bin": {
    "embed-code": "./bin/embed-code.js"
  },
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/embedding-worker": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "effect": "catalog:",
    "glob": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@huggingface/transformers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./inference-plan": {
      "types": "./src/inference-plan.ts",
      "default": "./dist/inference-plan.js"
    },
    "./pinned-plan": {
      "types": "./src/pinned-plan.ts",
      "default": "./dist/pinned-plan.js"
    },
    "./runtime-config": {
      "types": "./src/runtime-config.ts",
      "default": "./dist/runtime-config.js"
    },
    "./provider-core": {
      "types": "./src/provider-core.ts",
      "default": "./dist/provider-core.js"
    },
    "./backend": {
      "types": "./src/backend-entry.ts",
      "default": "./dist/backend-entry.js"
    },
    "./factory": {
      "types": "./src/factory-entry.ts",
      "default": "./dist/factory-entry.js"
    },
    "./service": {
      "types": "./src/service-entry.ts",
      "default": "./dist/service-entry.js"
    },
    "./worker": {
      "types": "./src/worker-entry.ts",
      "default": "./dist/worker-entry.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:models": "vitest run --config vitest.models.config.mts",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "types": "./src/index.ts",
  "type": "module"
}
