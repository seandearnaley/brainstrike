{
  "name": "@brainstrike/embeddings",
  "description": "BGE-M3 embedding service and components for brainstrike",
  "version": "0.1.0",
  "bin": {
    "embed-code": "./bin/embed-code.js"
  },
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/embedding-worker": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "effect": "catalog:",
    "glob": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@huggingface/transformers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./inference-plan": "./src/inference-plan.ts",
    "./pinned-plan": "./src/pinned-plan.ts",
    "./runtime-config": "./src/runtime-config.ts",
    "./provider-core": "./src/provider-core.ts",
    "./backend": "./src/backend-entry.ts",
    "./factory": "./src/factory-entry.ts",
    "./service": "./src/service-entry.ts",
    "./worker": "./src/worker-entry.ts"
  },
  "files": [
    "bin"
  ],
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "scripts": {
    "bench": "vitest bench",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:models": "vitest run --config vitest.models.config.mts",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "type": "module"
}
