{
  "name": "@brainstrike/embeddings",
  "description": "BGE-M3 embedding service and components for brainstrike",
  "version": "0.1.0",
  "bin": {
    "embed-code": "./bin/embed-code.js"
  },
  "dependencies": {
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embedding-worker": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@huggingface/transformers": "^4.1.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@types/node": "^25.6.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./runtime-config": {
      "types": "./dist/runtime-config.d.ts",
      "import": "./dist/runtime-config.mjs",
      "require": "./dist/runtime-config.js"
    },
    "./provider-core": {
      "types": "./dist/provider-core.d.ts",
      "import": "./dist/provider-core.mjs",
      "require": "./dist/provider-core.js"
    },
    "./backend": {
      "types": "./dist/backend-entry.d.ts",
      "import": "./dist/backend-entry.mjs",
      "require": "./dist/backend-entry.js"
    },
    "./factory": {
      "types": "./dist/factory-entry.d.ts",
      "import": "./dist/factory-entry.mjs",
      "require": "./dist/factory-entry.js"
    },
    "./service": {
      "types": "./dist/service-entry.d.ts",
      "import": "./dist/service-entry.mjs",
      "require": "./dist/service-entry.js"
    },
    "./worker": {
      "types": "./dist/worker-entry.d.ts",
      "import": "./dist/worker-entry.mjs",
      "require": "./dist/worker-entry.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "pnpm run clean && tsc -b . && tsup src/index.ts src/runtime-config.ts src/provider-core.ts src/backend-entry.ts src/factory-entry.ts src/service-entry.ts src/worker-entry.ts src/cli/embed-code.ts --format esm,cjs --out-dir dist",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:integration": "VITEST_RUN_INTEGRATION=true vitest run --testNamePattern=\"integration\"",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "types": "dist/index.d.ts"
}
