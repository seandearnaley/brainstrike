{
  "name": "@brainstrike/embeddings",
  "description": "BGE-M3 embedding service and components for brainstrike",
  "version": "0.1.0",
  "bin": {
    "embed-code": "./bin/embed-code.js"
  },
  "dependencies": {
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embedding-worker": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@huggingface/transformers": "^3.8.1",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@types/node": "^25.3.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "pnpm run clean && tsc -b . && tsup src/index.ts src/cli/embed-code.ts --format esm,cjs --out-dir dist",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:integration": "VITEST_RUN_INTEGRATION=true vitest run --testNamePattern=\"integration\"",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "dist/index.d.ts"
}
