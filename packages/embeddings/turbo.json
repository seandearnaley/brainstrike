{
  "extends": ["//"],
  "tasks": {
    "test": {
      // Do NOT cache: the cached lane constructs REAL PGlite via
      // wasmLoader.createPGlite (e.g. embedding-worker-batch.test.ts — NOT one of
      // the *.integration.test.* files the config excludes for model downloads),
      // and its worker count is machine-relative (maxWorkers '50%' under CI). Same
      // env-sensitive WASM-PGlite-under-parallelism mechanism as db (see
      // packages/db/turbo.json invariant). NOTE: the model-DOWNLOAD integration
      // tests are already excluded from `test`, so real network is NOT the reason
      // here — the reason is the PGlite/timing sensitivity. Extra relevance: the
      // push CI path excludes this package but the PR path can select AND cache
      // it, so an unsafe cache entry here would leak onto every future PR.
      "cache": false,
      "passThroughEnv": ["CI", "COVERAGE"]
    }
  }
}
