{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "paths": {
      "@brainstrike/assistant-contract": [
        "../assistant-contract/dist/index.d.ts"
      ],
      "@brainstrike/assistant-contract/*": [
        "../assistant-contract/dist/*.d.ts"
      ],
      "@brainstrike/utils/*": [
        "../utils/dist/*.d.ts"
      ]
    },
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "strictNullChecks": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../app-state"
    },
    {
      "path": "../assistant-contract"
    },
    {
      "path": "../db"
    },
    {
      "path": "../indexing-contract"
    },
    {
      "path": "../local-runtime"
    },
    {
      "path": "../logging"
    },
    {
      "path": "../types"
    },
    {
      "path": "../ui"
    },
    {
      "path": "../utils"
    }
  ]
}
