{
  "name": "@brainstrike/worker-runtime",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "pnpm run clean && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --build --watch --preserveWatchOutput",
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
