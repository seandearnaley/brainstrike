{
  "extends": "../config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "lib": ["ES2022", "WebWorker"],
    "outDir": "dist",
    "rootDir": "src",
    "strictNullChecks": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "src/**/__tests__/**"],
  "references": [{ "path": "../state-store" }, { "path": "../types" }, { "path": "../utils" }]
}
