{
  "name": "@brainstrike/web-state-store",
  "description": "The browser state DB writer: the shared state schema and run log on official sqlite-wasm in OPFS, one writer per origin under a Web Lock (ADR-0011)",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@sqlite.org/sqlite-wasm": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "better-sqlite3": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite-wasm-database": {
      "types": "./dist/sqlite-wasm-database.d.ts",
      "default": "./dist/sqlite-wasm-database.js"
    },
    "./writer": {
      "types": "./dist/web-state-writer.d.ts",
      "default": "./dist/web-state-writer.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
