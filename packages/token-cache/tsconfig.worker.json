{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.worker.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "src",
    "declarationMap": true,
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "types": [],
    "strictNullChecks": true
  },
  "include": [
    "src/token-cache.worker.ts",
    "src/types.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}