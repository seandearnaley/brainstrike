{
  "name": "@brainstrike/token-cache",
  "version": "0.1.0",
  "description": "Persistent token cache with background worker for file explorer.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/token-cache.worker.d.ts",
      "import": "./dist/token-cache.worker.js"
    },
    "./background-indexer-worker": {
      "types": "./dist/background-indexer.worker.d.ts",
      "import": "./dist/background-indexer.worker.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "clean": "rimraf dist",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint --filter @brainstrike/token-cache",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@brainstrike/utils": "workspace:*",
    "@electric-sql/pglite": "^0.3.14",
    "tiktoken": "^1.0.22",
    "workerpool": "^10.0.1",
    "xxhash-wasm": "^1.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "happy-dom": "20.1.0",
    "react": "^19.2.4",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
