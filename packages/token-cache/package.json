{
  "name": "@brainstrike/token-cache",
  "description": "Persistent token cache with background worker for file explorer.",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/hooks": "workspace:*",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*",
    "@electric-sql/pglite": "0.5.4",
    "tiktoken": "^1.0.22",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cache-runtime": {
      "types": "./dist/cache-runtime.d.ts",
      "import": "./dist/cache-runtime.js"
    },
    "./background-indexer": {
      "types": "./dist/background-indexer.d.ts",
      "import": "./dist/background-indexer.js"
    },
    "./worker": {
      "types": "./dist/token-cache.worker.d.ts",
      "import": "./dist/token-cache.worker.js"
    },
    "./background-indexer-worker": {
      "types": "./dist/background-indexer.worker.d.ts",
      "import": "./dist/background-indexer.worker.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "private": true,
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint --filter @brainstrike/token-cache",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
