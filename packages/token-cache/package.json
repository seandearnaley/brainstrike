{
  "name": "@brainstrike/token-cache",
  "description": "Persistent token cache with background worker for file explorer.",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/hooks": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*",
    "effect": "catalog:",
    "xxhash-wasm": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "react": "^19.3.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./cache-runtime": {
      "types": "./src/cache-runtime.ts",
      "import": "./dist/cache-runtime.js"
    },
    "./background-indexer": {
      "types": "./src/background-indexer.ts",
      "import": "./dist/background-indexer.js"
    },
    "./worker": {
      "types": "./src/token-cache.worker.ts",
      "import": "./dist/token-cache.worker.js"
    },
    "./background-indexer-worker": {
      "types": "./src/background-indexer.worker.ts",
      "import": "./dist/background-indexer.worker.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "private": true,
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "type": "module",
  "types": "./src/index.ts"
}
