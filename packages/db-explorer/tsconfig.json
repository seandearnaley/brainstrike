{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "paths": {
      "@brainstrike/file-explorer-ui": [
        "../file-explorer-ui/src"
      ],
      "@brainstrike/file-explorer-ui/*": [
        "../file-explorer-ui/src/*"
      ],
      "@brainstrike/pipeline": [
        "../pipeline/src"
      ],
      "@brainstrike/utils/*": [
        "../utils/src/*"
      ],
      "@brainstrike/preferences/*": [
        "../preferences/src/*"
      ]
    },
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "strictNullChecks": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../db"
    },
    {
      "path": "../embeddings"
    },
    {
      "path": "../file-explorer-hooks"
    },
    {
      "path": "../file-explorer-ui"
    },
    {
      "path": "../file-import"
    },
    {
      "path": "../file-system"
    },
    {
      "path": "../platform-utils"
    },
    {
      "path": "../preferences"
    },
    {
      "path": "../pipeline"
    },
    {
      "path": "../text-splitter"
    },
    {
      "path": "../vector-management"
    },
    {
      "path": "../types"
    },
    {
      "path": "../ui"
    },
    {
      "path": "../utils"
    }
  ]
}
