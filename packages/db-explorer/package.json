{
  "name": "@brainstrike/db-explorer",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/app-state": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/context-actions": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/file-explorer": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-import": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/local-runtime": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/pipeline": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/vector-management": "workspace:*",
    "jszip": "catalog:",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "vitest": "catalog:",
    "zustand": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context-actions": {
      "types": "./dist/context-actions/index.d.ts",
      "import": "./dist/context-actions/index.js"
    },
    "./embedding-models": {
      "types": "./dist/utils/embedding-models.d.ts",
      "import": "./dist/utils/embedding-models.js"
    },
    "./database-demo-panel": {
      "types": "./dist/database-demo-panel.d.ts",
      "import": "./dist/database-demo-panel.js"
    },
    "./database-demo-store": {
      "types": "./dist/stores/database-demo-store.d.ts",
      "import": "./dist/stores/database-demo-store.js"
    },
    "./explorer-import-action": {
      "types": "./dist/components/explorer-import-action.d.ts",
      "import": "./dist/components/explorer-import-action.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "peerDependencies": {
    "react": "^19.3.0",
    "zustand": "^5"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "lint": "pnpm -w lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "dist/index.d.ts"
}
