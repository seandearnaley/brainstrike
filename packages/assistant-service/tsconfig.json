{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "strictNullChecks": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../agent"
    },
    {
      "path": "../assistant-contract"
    },
    {
      "path": "../assistant-wire"
    },
    {
      "path": "../canonical-ingestion"
    },
    {
      "path": "../db"
    },
    {
      "path": "../effect-kit"
    },
    {
      "path": "../file-system"
    },
    {
      "path": "../host-lease"
    },
    {
      "path": "../indexer"
    },
    {
      "path": "../indexing-contract"
    },
    {
      "path": "../logging"
    },
    {
      "path": "../sqlite-query"
    },
    {
      "path": "../state-store"
    },
    {
      "path": "../storage"
    },
    {
      "path": "../types"
    },
    {
      "path": "../utils"
    }
  ]
}
