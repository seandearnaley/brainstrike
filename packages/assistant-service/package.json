{
  "name": "@brainstrike/assistant-service",
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/canonical-ingestion": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/indexer": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/secure-fs-native": "workspace:*",
    "@brainstrike/sqlite-query": "workspace:*",
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./mcp-content-application-port": "./src/mcp-content-application-port.ts",
    "./memory-model-targets": "./src/memory-model-targets.ts",
    "./node-native-text-services": "./src/node-native-text-services.ts",
    "./node-workspace-services": "./src/node-workspace-services.ts",
    "./ports": "./src/ports.ts",
    "./provider-credential-projection": "./src/provider-credential-projection.ts",
    "./secret-errors": "./src/secret-errors.ts"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "pnpm -w lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "sideEffects": false
}
