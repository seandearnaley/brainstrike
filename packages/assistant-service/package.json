{
  "name": "@brainstrike/assistant-service",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/assistant-wire": "workspace:*",
    "@brainstrike/canonical-ingestion": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/host-lease": "workspace:*",
    "@brainstrike/indexer": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/secure-fs-native": "workspace:*",
    "@brainstrike/sqlite-query": "workspace:*",
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.mjs",
      "require": "./dist/http.js"
    },
    "./local-provider-runtime": {
      "types": "./dist/local-provider-runtime.d.ts",
      "import": "./dist/local-provider-runtime.mjs",
      "require": "./dist/local-provider-runtime.js"
    },
    "./mcp-content-application-port": {
      "types": "./dist/mcp-content-application-port.d.ts",
      "import": "./dist/mcp-content-application-port.mjs",
      "require": "./dist/mcp-content-application-port.js"
    },
    "./memory-model-targets": {
      "types": "./dist/memory-model-targets.d.ts",
      "import": "./dist/memory-model-targets.mjs",
      "require": "./dist/memory-model-targets.js"
    },
    "./node-native-text-services": {
      "types": "./dist/node-native-text-services.d.ts",
      "import": "./dist/node-native-text-services.mjs",
      "require": "./dist/node-native-text-services.js"
    },
    "./node-workspace-services": {
      "types": "./dist/node-workspace-services.d.ts",
      "import": "./dist/node-workspace-services.mjs",
      "require": "./dist/node-workspace-services.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "import": "./dist/ports.mjs",
      "require": "./dist/ports.js"
    },
    "./provider-credential-projection": {
      "types": "./dist/provider-credential-projection.d.ts",
      "import": "./dist/provider-credential-projection.mjs",
      "require": "./dist/provider-credential-projection.js"
    },
    "./request": {
      "types": "./dist/request.d.ts",
      "import": "./dist/request.mjs",
      "require": "./dist/request.js"
    },
    "./run-turn": {
      "types": "./dist/run-turn.d.ts",
      "import": "./dist/run-turn.mjs",
      "require": "./dist/run-turn.js"
    },
    "./secret-errors": {
      "types": "./dist/secret-errors.d.ts",
      "import": "./dist/secret-errors.mjs",
      "require": "./dist/secret-errors.js"
    },
    "./steering": {
      "types": "./dist/steering.d.ts",
      "import": "./dist/steering.mjs",
      "require": "./dist/steering.js"
    },
    "./stream-init": {
      "types": "./dist/stream-init.d.ts",
      "import": "./dist/stream-init.mjs",
      "require": "./dist/stream-init.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/rimraf.mjs dist && tsc -b . && tsup",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "concurrently --kill-others --names types,bundle \"tsc --build --watch --preserveWatchOutput\" \"tsup --watch\"",
    "lint": "pnpm -w lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "sideEffects": false
}
