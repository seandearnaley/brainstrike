{
  "extends": ["//"],
  "tasks": {
    "test": {
      // The unit suites load native add-ons. node-workspace-services.test.ts
      // reaches node-fs-scan-deps, which imports @brainstrike/secure-fs-native
      // statically. Its RootLock.acquire reads a process start time, which
      // loads windows-job-native on Windows. Each add-on's uncached
      // `node-gyp rebuild` first removes build/, so without these edges a run
      // that schedules it beside this task fails with "Could not locate the
      // bindings file" (BST-2243). This is the same edge as state-store's `test`.
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@brainstrike/secure-fs-native#build",
        "@brainstrike/windows-job-native#build"
      ]
    },
    "test:integration": {
      // The node-workspace-services, node-workspace-root-identity and
      // node-native-text-services suites run their fixtures as plain Node
      // children, outside Vitest's source aliases. Those children import
      // @brainstrike/assistant-service/node-workspace-services and
      // /node-native-text-services, plus state-store, indexer and the other
      // @brainstrike/* packages, through package exports that resolve to dist.
      // `build` builds this package's dist and, through `^build`, every dist
      // those children load.
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    },
    "test:coverage": {
      // The coverage lane includes those same real-process suites.
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    }
  }
}
