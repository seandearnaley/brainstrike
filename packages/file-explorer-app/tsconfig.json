{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "declarationDir": "dist",
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "@brainstrike/file-explorer": ["../file-explorer/src"],
      "@brainstrike/file-explorer-hooks": ["../file-explorer-hooks/src"],
      "@brainstrike/file-explorer-ui": ["../file-explorer-ui/src"],
      "@brainstrike/hooks": ["../hooks/src"],
      "@brainstrike/ui": ["../ui/src"],
      "@brainstrike/utils": ["../utils/src"],
      "@brainstrike/types": ["../types/src"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"],
  "references": [
    { "path": "../file-explorer" },
    { "path": "../file-explorer-hooks" },
    { "path": "../file-explorer-ui" },
    { "path": "../hooks" },
    { "path": "../ui" },
    { "path": "../utils" },
    { "path": "../types" }
  ]
}
