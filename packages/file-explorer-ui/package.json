{
  "name": "@brainstrike/file-explorer-ui",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "sideEffects": ["*.css"],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -b .",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=8192' vitest",
    "test:coverage": "pnpm -w test:coverage"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "zustand": "^5"
  },
  "dependencies": {
    "@brainstrike/db": "workspace:*",
    "@brainstrike/file-explorer": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/file-tree-worker": "workspace:*",
    "@brainstrike/hooks": "workspace:*",
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/preferences": "workspace:*",
    "@brainstrike/selection-rules": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/token-cache": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/workers": "workspace:*",
    "react-hotkeys-hook": "^5.2.1"
  },
  "license": "ISC",
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "27.4.0",
    "lucide-react": "^0.562.0"
  }
}
