{
  "name": "@brainstrike/file-explorer-ui",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/app-state": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/context-actions": "workspace:*",
    "@brainstrike/file-explorer": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/file-tree-worker": "workspace:*",
    "@brainstrike/hooks": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/token-cache": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/workers": "workspace:*",
    "react-hotkeys-hook": "catalog:",
    "react-resizable-panels": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "catalog:",
    "@brainstrike/file-tree-test-fixtures": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./context-actions": {
      "types": "./src/context-actions/index.ts",
      "import": "./dist/context-actions/index.js"
    },
    "./indexing": {
      "types": "./src/indexing/index.ts",
      "import": "./dist/indexing/index.js"
    },
    "./thread-folder-scope-store": {
      "types": "./src/thread-folder-scope-store.ts",
      "import": "./dist/thread-folder-scope-store.js"
    },
    "./workspace-tab-selection-store": {
      "types": "./src/workspace-tab-selection-store.ts",
      "import": "./dist/workspace-tab-selection-store.js"
    },
    "./tab-manager-store": {
      "types": "./src/tab-manager-store.ts",
      "import": "./dist/tab-manager-store.js"
    },
    "./shell": {
      "types": "./src/shell/index.ts",
      "import": "./dist/shell/index.js"
    },
    "./shell/file-explorer-provider": {
      "types": "./src/shell/file-explorer-provider.tsx",
      "import": "./dist/shell/file-explorer-provider.js"
    },
    "./shell/file-system-provider": {
      "types": "./src/shell/file-system-provider.tsx",
      "import": "./dist/shell/file-system-provider.js"
    },
    "./shell/root-data-deletion-context": {
      "types": "./src/shell/root-data-deletion-context.tsx",
      "import": "./dist/shell/root-data-deletion-context.js"
    },
    "./styles.css": "./styles.css",
    "./tree": {
      "types": "./src/tree/index.ts",
      "import": "./dist/tree/index.js"
    },
    "./editor-view-state-store": {
      "types": "./src/editor-view-state-store.ts",
      "import": "./dist/editor-view-state-store.js"
    },
    "./file-tab-pane-store": {
      "types": "./src/file-tab-pane-store.ts",
      "import": "./dist/file-tab-pane-store.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "pnpm -w lint",
    "test": "node ../../scripts/run-env.mjs NODE_OPTIONS=--max-old-space-size=8192 -- vitest run --exclude \"**/*.integration.test.*\"",
    "test:watch": "node ../../scripts/run-env.mjs NODE_OPTIONS=--max-old-space-size=8192 -- vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "./src/index.ts"
}
