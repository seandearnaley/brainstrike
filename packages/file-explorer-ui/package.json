{
  "name": "@brainstrike/file-explorer-ui",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/context-actions": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/file-explorer": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/file-tree-worker": "workspace:*",
    "@brainstrike/hooks": "workspace:*",
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/preferences": "workspace:*",
    "@brainstrike/selection-rules": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/token-cache": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/workers": "workspace:*",
    "drizzle-orm": "0.45.2",
    "react-hotkeys-hook": "^5.3.3"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "29.1.1",
    "lucide-react": "^1.23.0"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context-actions": {
      "types": "./dist/context-actions/index.d.ts",
      "import": "./dist/context-actions/index.js"
    },
    "./indexing": {
      "types": "./dist/indexing/index.d.ts",
      "import": "./dist/indexing/index.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "import": "./dist/preview/index.js"
    },
    "./workspace-context-curation-store": {
      "types": "./dist/workspace-context-curation-store.d.ts",
      "import": "./dist/workspace-context-curation-store.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./styles.css": "./styles.css",
    "./tree": {
      "types": "./dist/tree/index.d.ts",
      "import": "./dist/tree/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/rimraf.mjs dist && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "lint": "pnpm run --dir=../.. lint",
    "test": "node ../../scripts/run-env.mjs NODE_OPTIONS=--max-old-space-size=8192 -- vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "node ../../scripts/run-env.mjs NODE_OPTIONS=--max-old-space-size=8192 -- vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "dist/index.d.ts"
}
