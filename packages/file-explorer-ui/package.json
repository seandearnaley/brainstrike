{
  "name": "@brainstrike/file-explorer-ui",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build:types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "build:js": "tsup src/index.ts --format esm,cjs --clean",
    "build": "pnpm run build:types && pnpm run build:js",
    "dev":   "pnpm run build:types && tsup src/index.ts --format esm,cjs --watch",
    "test":  "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "dependencies": {
    "@brainstrike/ui":               "workspace:*",   
    "@brainstrike/file-explorer":    "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/utils":            "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8",
    "lucide-react": "^0.417.0",
    "@types/react": "^19",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@testing-library/jest-dom": "^6"
  }
}
