{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir":  "dist",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "declarationDir": "dist",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "**/__tests__/**"],
  "references": [
    { "path": "../file-explorer" },
    { "path": "../file-explorer-hooks" },
    { "path": "../hooks" },
    { "path": "../platform-utils" },
    { "path": "../ui" },
    { "path": "../utils" },
    { "path": "../types" }
  ]
}
