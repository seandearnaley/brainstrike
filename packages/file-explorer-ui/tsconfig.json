{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "paths": {
      "@brainstrike/utils/crypto": [
        "../utils/dist/crypto.d.ts"
      ],
      "@brainstrike/utils/*": [
        "../utils/dist/*.d.ts"
      ]
    },
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "declarationDir": "dist",
    "types": [
      "node"
    ],
    "strictNullChecks": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/__tests__/**"
  ],
  "references": [
    {
      "path": "../context-actions"
    },
    {
      "path": "../file-explorer"
    },
    {
      "path": "../file-explorer-hooks"
    },
    {
      "path": "../hooks"
    },
    {
      "path": "../platform-utils"
    },
    {
      "path": "../selection-rules"
    },
    {
      "path": "../ui"
    },
    {
      "path": "../preferences"
    },
    {
      "path": "../text-splitter"
    },
    {
      "path": "../utils"
    },
    {
      "path": "../types"
    }
  ]
}
