{
  "name": "@brainstrike/web-writer",
  "description": "The browser's state writer worker as the web app runs it: the state DB with the derived index projecting its run log (BST-1940)",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/agent-host": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/canonical-ingestion": "workspace:*",
    "@brainstrike/chunking-worker": "workspace:*",
    "@brainstrike/embedding-worker": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/indexer": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/web-state-store": "workspace:*",
    "zod": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/build-utils": "workspace:*",
    "@brainstrike/config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ai": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@effect/tsgo": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web-host-client": {
      "types": "./dist/web-host-client.d.ts",
      "default": "./dist/web-host-client.js"
    },
    "./web-run-turn": {
      "types": "./dist/web-run-turn.d.ts",
      "default": "./dist/web-run-turn.js"
    },
    "./test-fixtures/scripted-writer": {
      "types": "./dist/test-fixtures/scripted-writer.d.ts",
      "default": "./dist/test-fixtures/scripted-writer.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
