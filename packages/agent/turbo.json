{
  "extends": ["//"],
  "tasks": {
    "test": {
      // Do NOT cache: @brainstrike/agent specs construct REAL PGlite instances
      // (`new PGlite()` in mastra-tool-suspend-resume / mastra-memory-persistence
      // / mastra-tool-approval-suspend / mastra-subagent-execution, etc.) and run
      // the full Mastra agent loop against them. This is the same env-sensitive
      // WASM-PGlite mechanism db carves out for: the script already serializes
      // with `--no-file-parallelism` and the config uses a 30s testTimeout with
      // the note "Longer timeout for MCP/Mastra integration tests under parallel
      // load" — i.e. the lane's outcome is sensitive to un-hashed CPU
      // parallelism/contention. It also drains a synchronous scripted-model
      // stream via setImmediate (event-loop-starvation fragility); caching a
      // lucky green would mask an intermittent real failure. Carved precautionary
      // per the required-check rule (see packages/db/turbo.json invariant).
      "cache": false,
      "passThroughEnv": ["CI", "COVERAGE"]
    }
  }
}
