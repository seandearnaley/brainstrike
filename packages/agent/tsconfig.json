{
  "extends": "../config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@brainstrike/assistant-contract": [
        "../assistant-contract/dist/index.d.ts"
      ],
      "@brainstrike/assistant-contract/*": [
        "../assistant-contract/dist/*.d.ts"
      ],
      "@brainstrike/mcp-tasks-extension": [
        "../mcp-tasks-extension/dist/index.d.ts"
      ],
      "@brainstrike/tokenization": [
        "../tokenization/dist/index.d.ts"
      ],
      "@brainstrike/tokenization/token-utils-accurate-lite": [
        "../tokenization/dist/token-utils-accurate-lite.d.ts"
      ]
    },
    "strictNullChecks": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "apiStabilityLeak": "error",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingStarInYieldEffectGen": "error",
          "promiseInEffectSuccess": "error",
          "returnEffectInGen": "error",
          "unsafeEffectTypeAssertion": "error",
          "experimentalApiUsage": "error",
          "unstableApiUsage": "error"
        }
      }
    ]
  },
  "include": [
    "src/**/*",
    "src/**/*.json"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../assistant-contract"
    },
    {
      "path": "../db"
    },
    {
      "path": "../tokenization"
    },
    {
      "path": "../logging"
    },
    {
      "path": "../mcp-tasks-extension"
    },
    {
      "path": "../state-store"
    },
    {
      "path": "../utils"
    },
    {
      "path": "../types"
    }
  ]
}
