{
  "name": "@brainstrike/agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --watch --out-dir dist",
    "clean": "rimraf dist",
    "lint": "pnpm -w lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.40",
    "@brainstrike/utils": "workspace:*",
    "@mastra/core": "^0.18.0",
    "@mastra/mcp": "^0.13.1",
    "zod": "^3.25.8"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
