{
  "name": "@brainstrike/agent",
  "version": "0.1.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/openai": "^4.0.8",
    "@ai-sdk/provider": "4.0.2",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@mastra/core": "^1.51.0",
    "@mastra/memory": "1.22.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastest-levenshtein": "^1.0.16",
    "minimatch": "^10.2.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@electric-sql/pglite": "0.5.3",
    "@electric-sql/pglite-pgvector": "0.0.4",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./mcp-client": {
      "types": "./dist/mcp-client.d.ts",
      "import": "./dist/mcp-client.mjs",
      "require": "./dist/mcp-client.js"
    },
    "./local-llm": {
      "types": "./dist/local-llm.d.ts",
      "import": "./dist/local-llm.mjs",
      "require": "./dist/local-llm.js"
    },
    "./browser-safe": {
      "types": "./dist/browser-safe.d.ts",
      "import": "./dist/browser-safe.mjs",
      "require": "./dist/browser-safe.js"
    },
    "./hosted-web": {
      "types": "./dist/hosted-web.d.ts",
      "import": "./dist/hosted-web.mjs",
      "require": "./dist/hosted-web.js"
    },
    "./request-boundary": {
      "types": "./dist/request-boundary.d.ts",
      "import": "./dist/request-boundary.mjs",
      "require": "./dist/request-boundary.js"
    },
    "./tool-metadata": {
      "types": "./dist/tool-metadata.d.ts",
      "import": "./dist/tool-metadata.mjs",
      "require": "./dist/tool-metadata.js"
    },
    "./provider-metadata": {
      "types": "./dist/provider-metadata.d.ts",
      "import": "./dist/provider-metadata.mjs",
      "require": "./dist/provider-metadata.js"
    },
    "./local-runtime": {
      "types": "./dist/local-runtime.d.ts",
      "import": "./dist/local-runtime.mjs",
      "require": "./dist/local-runtime.js"
    },
    "./context-packer": {
      "types": "./dist/context-packer.d.ts",
      "import": "./dist/context-packer.mjs",
      "require": "./dist/context-packer.js"
    },
    "./memory-settings": {
      "types": "./dist/memory-settings.d.ts",
      "import": "./dist/memory-settings.mjs",
      "require": "./dist/memory-settings.js"
    },
    "./run-events": {
      "types": "./dist/run-events.d.ts",
      "import": "./dist/run-events.mjs",
      "require": "./dist/run-events.js"
    },
    "./pglite-mastra-memory": {
      "types": "./dist/pglite-mastra-memory/index.d.ts",
      "import": "./dist/pglite-mastra-memory/index.mjs",
      "require": "./dist/pglite-mastra-memory/index.js"
    },
    "./pglite-mastra-memory/schema": {
      "types": "./dist/pglite-mastra-memory/schema.d.ts",
      "import": "./dist/pglite-mastra-memory/schema.mjs",
      "require": "./dist/pglite-mastra-memory/schema.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "private": true,
  "scripts": {
    "build": "tsup && node scripts/verify-hosted-web-bundle.mjs",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --watch",
    "lint": "pnpm -w lint",
    "test": "vitest run --no-file-parallelism --exclude \"**/*.integration.spec.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts --no-file-parallelism",
    "test:coverage": "vitest run --no-file-parallelism --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "sideEffects": false,
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "types": "./dist/index.d.ts"
}
