{
  "name": "@brainstrike/utils",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup src/index.ts --format esm,cjs --out-dir dist",
    "dev": "tsup src/index.ts --format esm,cjs --watch --out-dir dist",
    "clean": "rimraf dist",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.0.0",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "minimatch": "^10"
  },
  "devDependencies": {
    "@swc/core": "^1.11.31",
    "@types/node": "^22.15.30",
    "@brainstrike/test-utils": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2",
    "rimraf": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "turbo": {
    "outputs": ["dist/**"]
  }
}
