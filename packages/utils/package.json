    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    },
    "./color-utils": {
      "types": "./dist/color-utils.d.ts",
      "default": "./dist/color-utils.js"
    },
    "./browser-download": {
      "types": "./dist/browser-download.d.ts",
      "default": "./dist/browser-download.js"
    },
    "./collator": {
      "types": "./dist/collator.d.ts",
      "default": "./dist/collator.js"
    },
    "./create-debounce": {
      "types": "./dist/create-debounce.d.ts",
      "default": "./dist/create-debounce.js"
    },
    "./error-utils": {
      "types": "./dist/error-utils.d.ts",
