{
  "name": "@brainstrike/utils",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc -p . && tsup src/index.ts --format esm,cjs --clean",
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "lint": "eslint src/",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.1.2"
  },
  "devDependencies": {
    "@swc/core": "^1.11.20",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.1.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}