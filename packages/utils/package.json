  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "pnpm run clean && tsc -b . && tsup",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --watch",
    "lint": "pnpm -w lint",
    "mutation": "npx @stryker-mutator/core run",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": [
    "./dist/chunk-*.mjs",
    "./dist/chunk-*.js"
  ],
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "types": "./dist/index.d.ts"
