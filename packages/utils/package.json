  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "pnpm run clean && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --build --watch --preserveWatchOutput",
    "lint": "pnpm -w lint",
    "mutation": "npx @stryker-mutator/core run",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": [
    "./dist/chunk-*.mjs",
    "./dist/chunk-*.js"
  ],
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "types": "./dist/index.d.ts",
  "type": "module"
