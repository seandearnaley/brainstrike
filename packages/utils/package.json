{
  "name": "@brainstrike/utils",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup src/index.ts --format esm,cjs --out-dir dist",
    "dev": "tsup src/index.ts --format esm,cjs --watch --out-dir dist",
    "clean": "rimraf dist",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.1.2",
    "@brainstrike/types": "workspace:*",
    "minimatch": "^10"
  },
  "devDependencies": {
    "@swc/core": "^1.11.20",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.1.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1",
    "rimraf": "^5.0.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "turbo": {
    "outputs": ["dist/**"]
  }
}