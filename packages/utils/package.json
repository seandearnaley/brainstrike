{
  "name": "@brainstrike/utils",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "minimatch": "^10.2.3",
    "pino": "^10.3.1",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/typescript-checker": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@swc/core": "^1.15.13",
    "@types/node": "^25.3.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./token-counting-runtime": {
      "types": "./dist/token-counting-runtime.d.ts",
      "import": "./dist/token-counting-runtime.mjs",
      "require": "./dist/token-counting-runtime.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.mjs",
      "require": "./dist/logger.js"
    },
    "./logging-preferences": {
      "types": "./dist/logging-preferences.d.ts",
      "import": "./dist/logging-preferences.mjs",
      "require": "./dist/logging-preferences.js"
    },
    "./color-utils": {
      "types": "./dist/color-utils.d.ts",
      "import": "./dist/color-utils.mjs",
      "require": "./dist/color-utils.js"
    },
    "./create-debounce": {
      "types": "./dist/create-debounce.d.ts",
      "import": "./dist/create-debounce.mjs",
      "require": "./dist/create-debounce.js"
    },
    "./error-utils": {
      "types": "./dist/error-utils.d.ts",
      "import": "./dist/error-utils.mjs",
      "require": "./dist/error-utils.js"
    },
    "./file-explorer-utils": {
      "types": "./dist/file-explorer-utils.d.ts",
      "import": "./dist/file-explorer-utils.mjs",
      "require": "./dist/file-explorer-utils.js"
    },
    "./file-utils": {
      "types": "./dist/file-utils.d.ts",
      "import": "./dist/file-utils.mjs",
      "require": "./dist/file-utils.js"
    },
    "./log-buffer": {
      "types": "./dist/log-buffer.d.ts",
      "import": "./dist/log-buffer.mjs",
      "require": "./dist/log-buffer.js"
    },
    "./quick-filter-utils": {
      "types": "./dist/quick-filter-utils.d.ts",
      "import": "./dist/quick-filter-utils.mjs",
      "require": "./dist/quick-filter-utils.js"
    },
    "./report-generator": {
      "types": "./dist/report-generator.d.ts",
      "import": "./dist/report-generator.mjs",
      "require": "./dist/report-generator.js"
    },
    "./safe-storage": {
      "types": "./dist/safe-storage.d.ts",
      "import": "./dist/safe-storage.mjs",
      "require": "./dist/safe-storage.js"
    },
    "./selection-utils": {
      "types": "./dist/selection-utils.d.ts",
      "import": "./dist/selection-utils.mjs",
      "require": "./dist/selection-utils.js"
    },
    "./tree-generator": {
      "types": "./dist/tree-generator.d.ts",
      "import": "./dist/tree-generator.mjs",
      "require": "./dist/tree-generator.js"
    },
    "./tree-operations": {
      "types": "./dist/tree-operations.d.ts",
      "import": "./dist/tree-operations.mjs",
      "require": "./dist/tree-operations.js"
    },
    "./perf-timing": {
      "types": "./dist/perf-timing.d.ts",
      "import": "./dist/perf-timing.mjs",
      "require": "./dist/perf-timing.js"
    },
    "./crypto": {
      "types": "./dist/crypto-utils.d.ts",
      "import": "./dist/crypto-utils.mjs",
      "require": "./dist/crypto-utils.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "pnpm run clean && tsc -b . && tsup src/index.ts src/tree-operations.ts src/perf-timing.ts src/crypto-utils.ts src/token-counting-runtime.ts src/logger.ts src/logging-preferences.ts src/log-buffer.ts src/safe-storage.ts src/color-utils.ts src/create-debounce.ts src/error-utils.ts src/file-explorer-utils.ts src/file-utils.ts src/quick-filter-utils.ts src/report-generator.ts src/selection-utils.ts src/tree-generator.ts --format esm,cjs --out-dir dist",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "pnpm run --dir=../.. lint",
    "mutation": "npx @stryker-mutator/core run",
    "test": "vitest run",
    "test:coverage": "pnpm -w test:coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": [
    "./dist/chunk-*.mjs",
    "./dist/chunk-*.js"
  ],
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  },
  "types": "./dist/index.d.ts"
}
