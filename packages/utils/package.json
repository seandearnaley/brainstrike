{
  "name": "@brainstrike/utils",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup src/index.ts --format esm,cjs --out-dir dist",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage",
    "mutation": "npx @stryker-mutator/core run"
  },
  "dependencies": {
    "@brainstrike/types": "workspace:*",
    "minimatch": "^10.0.3",
    "pino": "^10.0.0",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/core": "^9.2.0",
    "@stryker-mutator/typescript-checker": "^9.2.0",
    "@stryker-mutator/vitest-runner": "^9.2.0",
    "@swc/core": "^1.13.5",
    "@types/node": "^24.7.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
