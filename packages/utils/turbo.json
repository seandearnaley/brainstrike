{
  "extends": ["//"],
  "tasks": {
    "test": {
      // B4 build-edge exception. The root `test` task depends on the no-op
      // `topo` transit node, but this package's TypeScript build-contract test
      // inspects its own emitted `dist` files. `$TURBO_EXTENDS$` preserves the
      // inherited source-hash cascade while appending the required own build.
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    },
    "test:coverage": {
      // Coverage runs the same built-artifact contract and needs the same edge.
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    }
  }
}
