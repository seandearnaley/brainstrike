{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@brainstrike/text-splitter": [
        "../text-splitter/dist/index.d.ts"
      ],
      "@brainstrike/text-splitter/*": [
        "../text-splitter/dist/*.d.ts"
      ]
    },
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "**/*.test.*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
