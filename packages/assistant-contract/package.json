{
  "name": "@brainstrike/assistant-contract",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local-llm": {
      "types": "./dist/local-llm.d.ts",
      "import": "./dist/local-llm.js"
    },
    "./local-llm-artifacts": {
      "types": "./dist/local-llm-artifacts.d.ts",
      "import": "./dist/local-llm-artifacts.js"
    },
    "./local-llm-device": {
      "types": "./dist/local-llm-device.d.ts",
      "import": "./dist/local-llm-device.js"
    },
    "./local-llm-model-specs": {
      "types": "./dist/local-llm-model-specs.d.ts",
      "import": "./dist/local-llm-model-specs.js"
    },
    "./context-packer": {
      "types": "./dist/context-packer.d.ts",
      "import": "./dist/context-packer.js"
    },
    "./local-runtime": {
      "types": "./dist/local-runtime.d.ts",
      "import": "./dist/local-runtime.js"
    },
    "./mastra-memory-schema": {
      "types": "./dist/mastra-memory-schema.d.ts",
      "import": "./dist/mastra-memory-schema.js"
    },
    "./memory-settings": {
      "types": "./dist/memory-settings.d.ts",
      "import": "./dist/memory-settings.js"
    },
    "./provider-metadata": {
      "types": "./dist/provider-metadata.d.ts",
      "import": "./dist/provider-metadata.js"
    },
    "./provider-registry": {
      "types": "./dist/provider-registry.d.ts",
      "import": "./dist/provider-registry.js"
    },
    "./run-events": {
      "types": "./dist/run-events.d.ts",
      "import": "./dist/run-events.js"
    },
    "./runtime-data": {
      "types": "./dist/runtime-data.d.ts",
      "import": "./dist/runtime-data.js"
    },
    "./tool-metadata": {
      "types": "./dist/tool-metadata.d.ts",
      "import": "./dist/tool-metadata.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -b .",
    "clean": "rm -rf dist .tsbuildinfo",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "lint": "pnpm run --dir=../.. lint",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
