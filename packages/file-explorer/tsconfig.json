{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ]
}
