{
  "name": "@brainstrike/file-explorer",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "private": true,
  "scripts": {
    "build": "tsc && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "pnpm -w test:coverage",
    "mutation": "npx @stryker-mutator/core run"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "use-sync-external-store": "^1",
    "zustand": "^5"
  },
  "dependencies": {
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "license": "ISC",
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/api": "^9.4.0",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/typescript-checker": "^9.4.0",
    "@stryker-mutator/vitest-runner": "^9.4.0",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
