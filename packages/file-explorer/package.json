{
  "name": "@brainstrike/file-explorer",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "catalog:",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "peerDependencies": {
    "react": "^19.2.4",
    "use-sync-external-store": "^1",
    "zustand": "^5"
  },
  "private": true,
  "scripts": {
    "build": "tsc --build && tsup",
    "dev": "tsup --watch",
    "mutation": "npx @stryker-mutator/core run",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "dist/index.d.ts"
}
