{
  "name": "@brainstrike/file-explorer",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "private": true,
  "scripts": {
    "build": "tsc && tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:coverage": "pnpm -w test:coverage",
    "mutation": "npx @stryker-mutator/core run"
  },
  "peerDependencies": {
    "zustand": "^5",
    "react": "^19.1.1",
    "use-sync-external-store": "^1"
  },
  "dependencies": {
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/file-system": "workspace:*"
  },
  "license": "ISC",
  "devDependencies": {
    "tsup": "^8",
    "@types/node": "^24",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/core": "^9.0.1",
    "@stryker-mutator/vitest-runner": "^9.0.1",
    "@stryker-mutator/typescript-checker": "^9.0.1"
  }
}
