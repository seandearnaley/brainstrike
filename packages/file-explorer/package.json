{
  "name": "@brainstrike/file-explorer",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "minimatch": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/file-tree-test-fixtures": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./context-generation": {
      "types": "./src/context-generation.ts",
      "import": "./dist/context-generation.mjs",
      "require": "./dist/context-generation.js"
    },
    "./file-tree": {
      "types": "./src/file-tree.ts",
      "import": "./dist/file-tree.mjs",
      "require": "./dist/file-tree.js"
    },
    "./project-tree-text": {
      "types": "./src/project-tree-text.ts",
      "import": "./dist/project-tree-text.mjs",
      "require": "./dist/project-tree-text.js"
    },
    "./selection": {
      "types": "./src/selection.ts",
      "import": "./dist/selection.mjs",
      "require": "./dist/selection.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "peerDependencies": {
    "react": "^19.3.0",
    "zustand": "^5"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc && tsup",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsup --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "./src/index.ts"
}
