{
  "name": "@brainstrike/security",
  "version": "0.1.0",
  "private": true,
  "description": "Security utilities (e.g., CSP helpers) shared across apps",
  "engines": { "node": ">=22" },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist/**"],
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup src/index.ts --format esm,cjs --out-dir dist",
    "clean": "rimraf dist",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@brainstrike/test-utils": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "rimraf": "^6.0.1"
  },
  "publishConfig": { "access": "public" },
  "turbo": { "outputs": ["dist/**"] }
}
