{
  "name": "@brainstrike/queue",
  "description": "Browser/Electron renderer job queue with workerpool for embedding tasks.",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "workerpool": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "private": true,
  "scripts": {
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module"
}
