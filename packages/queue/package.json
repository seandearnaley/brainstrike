{
  "name": "@brainstrike/queue",
  "version": "0.1.0",
  "description": "Browser/Electron renderer job queue with workerpool and p-queue fallback.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -b . && tsup src/index.ts --format esm,cjs --out-dir dist",
    "clean": "rimraf dist",
    "dev": "tsup src/index.ts --format esm,cjs --out-dir dist --watch",
    "lint": "pnpm -w lint --filter @brainstrike/queue",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@brainstrike/embedding-worker": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@huggingface/transformers": "^3.8.0",
    "p-queue": "^9.0.1",
    "workerpool": "^10.0.1"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "^24.10.1",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
