{
  "name": "@brainstrike/vector-management",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/app-state": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/logging": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:",
    "vitest": "catalog:",
    "zustand": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "peerDependencies": {
    "react": "^19.3.0",
    "zustand": "^5"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "pnpm -w lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "./src/index.ts"
}
