{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "strictNullChecks": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../db"
    },
    {
      "path": "../embeddings"
    },
    {
      "path": "../indexing-contract"
    },
    {
      "path": "../preferences"
    },
    {
      "path": "../ui"
    },
    {
      "path": "../utils"
    },
    {
      "path": "../worker-runtime"
    }
  ]
}
