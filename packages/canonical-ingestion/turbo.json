{
  "extends": [
    "//"
  ],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_EXTENDS$",
        "../test-utils/fixtures/canonical-provided-chunks.json"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "@brainstrike/canonical-ingestion#build",
        "@brainstrike/secure-fs-native#build",
        "@brainstrike/indexer#build"
      ]
    },
    "test:browser": {
      // Source-aliased, so no root `build` edge: it would node-gyp state-store's addons in the browser container (BST-2080).
      "dependsOn": [
        "topo"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@brainstrike/canonical-ingestion#build",
        "@brainstrike/secure-fs-native#build",
        "@brainstrike/indexer#build"
      ],
      "cache": false
    }
  }
}
