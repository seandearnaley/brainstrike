{
  "extends": "../config/tsconfig/node-library.json",
  "compilerOptions": {
    "composite": true, "declaration": true, "declarationMap": true,
    "incremental": true, "outDir": "dist", "rootDir": "src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo", "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "__tests__"]
}
