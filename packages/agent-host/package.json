{
  "name": "@brainstrike/agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.20.0 <25 || >=26.8.2 <27" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "default": "./dist/protocol.js" },
    "./hook-trust": { "types": "./dist/hook-trust.d.ts", "default": "./dist/hook-trust.js" },
    "./child-presentation": { "types": "./dist/child-presentation.d.ts", "default": "./dist/child-presentation.js" },
    "./canonical-tool-bindings": {
      "types": "./dist/adapters/canonical-tool-bindings.d.ts",
      "default": "./dist/adapters/canonical-tool-bindings.js"
    },
    "./state-projection": { "types": "./dist/state-projection.d.ts", "default": "./dist/state-projection.js" },
    "./run-verdicts": { "types": "./dist/run-verdicts.d.ts", "default": "./dist/run-verdicts.js" },
    "./memory-storage-calculator": { "types": "./dist/adapters/memory-storage-calculator.d.ts", "default": "./dist/adapters/memory-storage-calculator.js" },
    "./committed-identities": { "types": "./dist/committed-identities.d.ts", "default": "./dist/committed-identities.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./cli": { "types": "./dist/cli.d.ts", "default": "./dist/cli.js" },
    "./credential-contract": {
      "types": "./dist/adapters/credential-contract.d.ts",
      "default": "./dist/adapters/credential-contract.js"
    },
    "./keyring-credentials": {
      "types": "./dist/adapters/keyring-credentials.d.ts",
      "default": "./dist/adapters/keyring-credentials.js"
    },
    "./keyring-native": {
      "types": "./dist/adapters/keyring-native-worker.d.ts",
      "default": "./dist/adapters/keyring-native-worker.js"
    },
    "./file-credentials": {
      "types": "./dist/adapters/file-credentials.d.ts",
      "default": "./dist/adapters/file-credentials.js"
    },
    "./browser": { "types": "./dist/browser-client.d.ts", "default": "./dist/browser-client.js" },
    "./test-fixtures/scripted-model": {
      "types": "./dist/test-fixtures/scripted-model.d.ts",
      "default": "./dist/test-fixtures/scripted-model.js"
    },
    "./test-fixtures/owned-process": "./__tests__/fixtures/owned-fixture-process.ts",
    "./test-fixtures/cooperative-host": "./__tests__/fixtures/cooperative-host-fixture.ts",
    "./test-fixtures/process-platform": "./__tests__/fixtures/process-platform.mjs",
    "./thread-view": { "types": "./dist/thread-view.d.ts", "default": "./dist/thread-view.js" },
    "./ledger-projection": {
      "types": "./dist/ledger-projection.d.ts",
      "default": "./dist/ledger-projection.js"
    },
    "./desktop-run-configuration": {
      "types": "./dist/desktop-run-configuration.d.ts",
      "default": "./dist/desktop-run-configuration.js"
    },
    "./edit-checkpoint-view": {
      "types": "./dist/edit-checkpoint-view.d.ts",
      "default": "./dist/edit-checkpoint-view.js"
    },
    "./standalone-workspace-input": {
      "types": "./dist/standalone-workspace-input.d.ts",
      "default": "./dist/standalone-workspace-input.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:routine": "vitest run --config vitest.integration.config.mts __tests__/host.integration.test.ts __tests__/permission-grant.integration.test.ts",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo"
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/assistant-data": "workspace:*",
    "@brainstrike/assistant-service": "workspace:*",
    "@brainstrike/host-lease": "workspace:*",
    "@brainstrike/indexer": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/secure-fs-native": "workspace:*",
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/windows-job-native": "workspace:*",
    "@mastra/core": "1.71.0",
    "@mastra/memory": "1.32.1",
    "@mastra/schema-compat": "catalog:",
    "@napi-rs/keyring": "2.1.0",
    "ai": "catalog:",
    "vscode-jsonrpc": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
