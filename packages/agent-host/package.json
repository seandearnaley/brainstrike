{
  "name": "@brainstrike/agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": { "brainstrike": "./bin/brainstrike.mjs", "brainstrike-host": "./bin/brainstrike.mjs" },
  "engines": { "node": ">=24.20.0 <25 || >=26.8.2 <27" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "default": "./dist/protocol.js" },
    "./state-projection": { "types": "./dist/state-projection.d.ts", "default": "./dist/state-projection.js" },
    "./committed-identities": { "types": "./dist/committed-identities.d.ts", "default": "./dist/committed-identities.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./credential-contract": {
      "types": "./dist/adapters/credential-contract.d.ts",
      "default": "./dist/adapters/credential-contract.js"
    },
    "./keyring-credentials": {
      "types": "./dist/adapters/keyring-credentials.d.ts",
      "default": "./dist/adapters/keyring-credentials.js"
    },
    "./keyring-native": {
      "types": "./dist/adapters/keyring-native-worker.d.ts",
      "default": "./dist/adapters/keyring-native-worker.js"
    },
    "./browser": { "types": "./dist/browser-client.d.ts", "default": "./dist/browser-client.js" },
    "./test-fixtures/scripted-model": {
      "types": "./dist/test-fixtures/scripted-model.d.ts",
      "default": "./dist/test-fixtures/scripted-model.js"
    },
    "./thread-view": { "types": "./dist/thread-view.d.ts", "default": "./dist/thread-view.js" }
  },
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo"
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/host-lease": "workspace:*",
    "@brainstrike/indexer": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/state-store": "workspace:*",
    "@mastra/core": "1.71.0",
    "@mastra/memory": "1.32.1",
    "@napi-rs/keyring": "2.1.0",
    "ai": "catalog:",
    "vscode-jsonrpc": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
