{
  "extends": ["//"],
  "tasks": {
    "test": {
      // src/adapters/private-credential-file.ts imports
      // @brainstrike/secure-fs-native statically. No unit suite reaches it
      // today: they pass with the binding removed. The edge is preventive. The
      // contract in scripts/__tests__/native-addon-build-uncached-contract.test.mjs
      // requires it for any static import.
      // The add-on's uncached `node-gyp rebuild` first removes build/, so a unit
      // suite that comes to load it would otherwise race that rebuild (BST-2243).
      "dependsOn": ["$TURBO_EXTENDS$", "@brainstrike/secure-fs-native#build"]
    },
    "test:integration": {
      // Spawned CLI and restart proofs resolve emitted public entries in Node.
      // The installed `brainstrike` executables are the composed product bin.
      "dependsOn": ["$TURBO_EXTENDS$", "build", "@brainstrike/host-capabilities#build"]
    },
    "test:coverage": {
      // The full coverage lane includes those same native process proofs.
      "dependsOn": ["$TURBO_EXTENDS$", "build", "@brainstrike/host-capabilities#build"],
      "cache": false
    }
  }
}
