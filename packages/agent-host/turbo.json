{
  "extends": ["//"],
  "tasks": {
    "test": {
      // src/adapters/private-credential-file.ts imports
      // @brainstrike/secure-fs-native statically. No unit suite reaches it
      // today: they pass with the binding removed. The edge is preventive.
      // The add-on's uncached `node-gyp rebuild` first removes build/, so a unit
      // suite that comes to load it would otherwise race that rebuild (BST-2243).
      // On Windows the unit suites open stores, and RootLock reads process start
      // times through @brainstrike/windows-job-native, so that build comes first too.
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@brainstrike/secure-fs-native#build",
        "@brainstrike/windows-job-native#build"
      ]
    },
    "test:integration": {
      // Spawned CLI and restart proofs run source under Node, which loads the
      // native add-ons (`^build`).
      "dependsOn": ["$TURBO_EXTENDS$", "^build"]
    }
  }
}
