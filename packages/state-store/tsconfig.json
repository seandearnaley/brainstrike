{
  "extends": "../config/tsconfig/base.json",
  "compilerOptions": {
    // The writer worker and the modules it imports are plain ESM (`.mjs`):
    // `new Worker(url)` loads them with Node itself, under Vitest and from the
    // desktop bundle alike, so they cannot be TypeScript sources. checkJs type-checks
    // them through their JSDoc.
    "checkJs": true,
    "noEmit": true,
    "strictNullChecks": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.mjs"],
  "exclude": ["node_modules", "__tests__"]
}
