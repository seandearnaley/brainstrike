{
  "name": "@brainstrike/state-store",
  "description": "The SQLite state DB: the run log and the small authoritative tables, written by one worker thread (ADR-0011)",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/secure-fs-native": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/windows-job-native": "workspace:*",
    "better-sqlite3": "catalog:",
    "tree-kill": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./catalog-domains": "./src/catalog-domains.mjs",
    "./deletion-domain": "./src/deletion-domain.mjs",
    "./event-schema": "./src/event-schema.ts",
    "./large-text": "./src/large-text.ts",
    "./native-children": "./src/native-children.ts",
    "./run-log": "./src/run-log.mjs",
    "./run-log-format": "./src/run-log-format.mjs",
    "./schema": "./src/schema.mjs",
    "./sqlite-checkpoint": "./src/sqlite-checkpoint.mjs",
    "./state-deletion": "./src/state-deletion.ts",
    "./state-truth-reader": "./src/state-truth-reader.ts"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:stress": "node ../../scripts/run-env.mjs BRAINSTRIKE_TEST_STRESS=1 -- vitest run __tests__/d5-root-lock.test.ts -t \"8 processes racing\"",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module"
}
