{
  "name": "@brainstrike/state-store",
  "description": "The SQLite state DB: the run log and the small authoritative tables, written by one worker thread (ADR-0011)",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/secure-fs-native": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/windows-job-native": "workspace:*",
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog-domains": {
      "types": "./dist/catalog-domains.d.mts",
      "default": "./dist/catalog-domains.mjs"
    },
    "./deletion-domain": {
      "types": "./dist/deletion-domain.d.mts",
      "default": "./dist/deletion-domain.mjs"
    },
    "./event-schema": {
      "types": "./dist/event-schema.d.ts",
      "default": "./dist/event-schema.js"
    },
    "./native-children": {
      "types": "./dist/native-children.d.ts",
      "default": "./dist/native-children.js"
    },
    "./run-log": {
      "types": "./dist/run-log.d.mts",
      "default": "./dist/run-log.mjs"
    },
    "./run-log-format": {
      "types": "./dist/run-log-format.d.mts",
      "default": "./dist/run-log-format.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "default": "./dist/schema.mjs"
    },
    "./sqlite-checkpoint": {
      "types": "./dist/sqlite-checkpoint.d.mts",
      "default": "./dist/sqlite-checkpoint.mjs"
    },
    "./state-deletion": {
      "types": "./dist/state-deletion.d.ts",
      "default": "./dist/state-deletion.js"
    },
    "./state-truth-reader": {
      "types": "./dist/state-truth-reader.d.ts",
      "default": "./dist/state-truth-reader.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:coverage": "node ../../scripts/run-native-coverage.mjs ../../node_modules/vitest/vitest.mjs run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:stress": "node ../../scripts/run-env.mjs BRAINSTRIKE_TEST_STRESS=1 -- vitest run __tests__/d5-root-lock.test.ts -t \"8 processes racing\"",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
