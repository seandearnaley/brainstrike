{
  "name": "@brainstrike/state-store",
  "description": "The SQLite state DB: the run log and the small authoritative tables, written by one worker thread (ADR-0011)",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/secure-fs-native": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/windows-job-native": "workspace:*",
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./catalog-domains": {
      "types": "./src/catalog-domains.mjs",
      "default": "./dist/catalog-domains.mjs"
    },
    "./deletion-domain": {
      "types": "./src/deletion-domain.mjs",
      "default": "./dist/deletion-domain.mjs"
    },
    "./event-schema": {
      "types": "./src/event-schema.ts",
      "default": "./dist/event-schema.js"
    },
    "./large-text": {
      "types": "./src/large-text.ts",
      "default": "./dist/large-text.js"
    },
    "./native-children": {
      "types": "./src/native-children.ts",
      "default": "./dist/native-children.js"
    },
    "./run-log": {
      "types": "./src/run-log.mjs",
      "default": "./dist/run-log.mjs"
    },
    "./run-log-format": {
      "types": "./src/run-log-format.mjs",
      "default": "./dist/run-log-format.mjs"
    },
    "./schema": {
      "types": "./src/schema.mjs",
      "default": "./dist/schema.mjs"
    },
    "./sqlite-checkpoint": {
      "types": "./src/sqlite-checkpoint.mjs",
      "default": "./dist/sqlite-checkpoint.mjs"
    },
    "./state-deletion": {
      "types": "./src/state-deletion.ts",
      "default": "./dist/state-deletion.js"
    },
    "./state-truth-reader": {
      "types": "./src/state-truth-reader.ts",
      "default": "./dist/state-truth-reader.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:stress": "node ../../scripts/run-env.mjs BRAINSTRIKE_TEST_STRESS=1 -- vitest run __tests__/d5-root-lock.test.ts -t \"8 processes racing\"",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./src/index.ts"
}
