{
  "name": "@brainstrike/config",
  "description": "Shared configuration for Brainstrike monorepo",
  "version": "0.1.0",
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "^4.1.9",
    "playwright": "^1.61.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./biome": "./biome/biome.json",
    "./biome/base": "./biome/biome.json",
    "./tsconfig/*": "./tsconfig/*.json",
    "./playwright-environment": "./src/playwright-environment.ts",
    "./vitest-browser": "./src/vitest-browser.ts"
  },
  "files": [
    "biome/biome.json",
    "tsconfig"
  ],
  "license": "ISC",
  "main": "index.js",
  "private": true,
  "scripts": {
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "lint": "pnpm run --dir=../.. lint",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text"
  },
  "turbo": {
    "outputs": [
      "tsconfig/**",
      "biome/**"
    ]
  }
}
