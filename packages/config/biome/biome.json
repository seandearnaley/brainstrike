{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUndeclaredVariables": "error",
        "noUnusedFunctionParameters": "warn",
        "useValidForDirection": "error",
        "useYield": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noConsoleLog": "warn",
        "noDebugger": "error",
        "noDuplicateParameters": "error",
        "noImplicitAnyLet": "error",
        "noMisleadingInstantiator": "error",
        "noUnsafeDeclarationMerging": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "noVar": "error",
        "useNumberNamespace": "error",
        "useNodejsImportProtocol": "error",
        "useShorthandArrayType": "error",
        "useShorthandAssign": "error",
        "noInferrableTypes": "error",
        "noNamespace": "error",
        "useEnumInitializers": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "enumMemberCase": "CONSTANT_CASE"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noExtraBooleanCast": "error",
        "noMultipleSpacesInRegularExpressionLiterals": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessEmptyExport": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessRename": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessTypeConstraint": "error",
        "useArrowFunction": "error"
      },
      "performance": {
        "noAccumulatingSpread": "warn",
        "noDelete": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    },
    "globals": [
      "React",
      "describe",
      "it",
      "test",
      "expect",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "vi",
      "jest",
      "Electron"
    ]
  },
  "files": {
    "maxSize": 10000000,
    "include": ["**/*.{ts,tsx,js,jsx,json}"],
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/playwright-report/**",
      "**/test-results/**"
    ]
  },
  "overrides": [
    {
      "include": ["**/__tests__/**", "**/*.test.*", "**/*.stories.*", "**/[*]*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "include": ["**/__tests__/**", "**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noExplicitAny": "warn",
            "noConsoleLog": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "include": ["**/constants/**", "**/use-toast.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "include": ["**/env.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off"
          }
        }
      }
    },
    {
      "include": ["**/*.generated.{ts,tsx}", "**/*.ai.{ts,tsx}", "**/generated/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsoleLog": "warn",
            "noExplicitAny": "warn"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "warn"
          },
          "style": {
            "useNamingConvention": "warn"
          }
        }
      }
    },
    {
      "include": [
        "**/lib/utils.ts",
        "**/lib/utils/*.ts",
        "**/tree-generator.ts",
        "**/main.ts",
        "**/file-explorer-persistence.ts",
        "**/worker-storage.ts",
        "**/file-tree-node.tsx",
        "**/loading-overlay.tsx",
        "**/use-file-system-context.ts",
        "**/report-generator.ts",
        "**/worker-storage.worker.ts",
        "**/use-file-filters.ts",
        "**/use-quick-filter.ts",
        "**/use-panel-persistence.ts",
        "**/ide-layout.tsx",
        "**/use-shared-file-content-loading.ts",
        "**/electron-adapter.ts",
        "**/virtualized-preview-panel.tsx",
        "**/virtualized-preview-panel-diceui-v2.tsx",
        "**/file-explorer.tsx",
        "**/use-file-tree-context.ts",
        "**/preview-panel.tsx",
        "**/mock-file-system-adapter.ts",
        "**/virtualized-preview-panel-tabbed.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off",
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": false
  }
}
