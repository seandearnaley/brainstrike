{
  "extends": ["//"],
  "tasks": {
    "test": {
      // exports.test.ts reads the repository's base Biome config directly, and
      // this package's tsconfig.json extends the repo-root tsconfig.json.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.base.json",
        "$TURBO_ROOT$/tsconfig.json"
      ]
    },
    "type-check": {
      // tsconfig.json extends the repo-root tsconfig.json, which no other
      // package reads, so it is this package's input rather than a global one.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
    },
    "build": {
      "outputs": ["tsconfig/**", "biome/**", "tailwind/**"]
    }
  }
}
