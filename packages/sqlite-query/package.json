{
  "name": "@brainstrike/sqlite-query",
  "version": "0.1.0",
  "description": "Read-only SQLite query sandbox owned by a dedicated killable process",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./utility-host": "./src/utility-query-host.ts",
    "./host": "./src/host-core.ts"
  },
  "dependencies": {
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/indexer": "workspace:*",
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "electron": "catalog:"
  },
  "scripts": {
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "node test/run-integration.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  }
}
