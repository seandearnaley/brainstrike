{
  "name": "@brainstrike/sqlite-query",
  "version": "0.1.0",
  "description": "Read-only SQLite query sandbox owned by a dedicated killable process",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./utility-host": {
      "types": "./src/utility-query-host.ts",
      "default": "./dist/utility-query-host.js"
    },
    "./host": {
      "types": "./src/host-core.ts",
      "default": "./dist/host-core.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/indexer": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "electron": "catalog:"
  },
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "node test/run-integration.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  }
}
