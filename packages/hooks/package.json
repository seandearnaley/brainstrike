{
  "name": "@brainstrike/hooks",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc && tsup",
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/workers": "workspace:*",
    "minimatch": "^10.0.3",
    "file-saver": "2.0.5",
    "@types/file-saver": "2.0.7"
  },
  "devDependencies": {
    "@swc/core": "^1.13.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "@brainstrike/test-utils": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
