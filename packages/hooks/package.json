{
  "name": "@brainstrike/hooks",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.json && tsup src/index.ts --format esm,cjs --outDir dist",
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@brainstrike/ui": "workspace:*"
  },
  "devDependencies": {
    "@swc/core": "^1.11.20",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.1.1",
    "jsdom": "^26.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "turbo": {
    "outputs": ["dist/**"]
  }
}
