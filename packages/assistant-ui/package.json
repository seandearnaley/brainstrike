{
  "name": "@brainstrike/assistant-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@assistant-ui/react": "catalog:",
    "@assistant-ui/react-streamdown": "catalog:",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/assistant-wire": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "assistant-stream": "catalog:",
    "cmdk": "^1.1.1",
    "lucide-react": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "catalog:",
    "streamdown": "catalog:",
    "zustand": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/config": "workspace:*",
    "@brainstrike/context-actions": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "react-shiki": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@effect/tsgo": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./activity-trace-model": {
      "types": "./src/activity-trace-model.ts",
      "import": "./dist/activity-trace-model.js"
    },
    "./assistant-link-capabilities": {
      "types": "./src/assistant-link-capabilities.ts",
      "import": "./dist/assistant-link-capabilities.js"
    },
    "./assistant-link-capabilities-provider": {
      "types": "./src/assistant-link-capabilities-provider.tsx",
      "import": "./dist/assistant-link-capabilities-provider.js"
    },
    "./context-usage-store": {
      "types": "./src/context-usage-store.ts",
      "import": "./dist/context-usage-store.js"
    },
    "./thread-context-store": {
      "types": "./src/thread-context-store.ts",
      "import": "./dist/thread-context-store.js"
    },
    "./thread-context-fold": {
      "types": "./src/thread-context-fold.ts",
      "import": "./dist/thread-context-fold.js"
    },
    "./data-stream-runtime": {
      "types": "./src/data-stream-runtime.ts",
      "import": "./dist/data-stream-runtime.js"
    },
    "./follow-up-queue-store": {
      "types": "./src/follow-up-queue-store.ts",
      "import": "./dist/follow-up-queue-store.js"
    },
    "./mcp-task-bridge-context": {
      "types": "./src/mcp-task-bridge-context.tsx",
      "import": "./dist/mcp-task-bridge-context.js"
    },
    "./mcp-task-status-card": {
      "types": "./src/mcp-task-status-card.tsx",
      "import": "./dist/mcp-task-status-card.js"
    },
    "./rewind-composer-store": {
      "types": "./src/rewind-composer-store.ts",
      "import": "./dist/rewind-composer-store.js"
    },
    "./styles.css": "./styles.css",
    "./tool-fallback": {
      "types": "./src/tool-fallback.tsx",
      "import": "./dist/tool-fallback.js"
    },
    "./tool-result-renderer-context": {
      "types": "./src/tool-result-renderer-context.tsx",
      "import": "./dist/tool-result-renderer-context.js"
    },
    "./tool-result-renderers": {
      "types": "./src/use-tool-result-renderers.ts",
      "import": "./dist/use-tool-result-renderers.js"
    },
    "./worktree-archive-confirmation-dialog": {
      "types": "./src/workspace-bar/worktree-archive-confirmation-dialog.tsx",
      "import": "./dist/workspace-bar/worktree-archive-confirmation-dialog.js"
    }
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc && node ../../scripts/copy-files.mjs src/overrides.css dist/overrides.css",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "pnpm -w lint",
    "perf:streaming": "node streaming-perf.mjs",
    "test": "vitest run --project unit --project compiled",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
