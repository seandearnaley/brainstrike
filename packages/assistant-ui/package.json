{
  "name": "@brainstrike/assistant-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@assistant-ui/react": "catalog:",
    "@assistant-ui/react-markdown": "catalog:",
    "@assistant-ui/styles": "catalog:",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/assistant-wire": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-virtual": "catalog:",
    "assistant-stream": "catalog:",
    "lucide-react": "catalog:",
    "remark-gfm": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/config": "workspace:*",
    "@brainstrike/context-actions": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "react-shiki": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assistant-link-capabilities": {
      "types": "./dist/assistant-link-capabilities.d.ts",
      "import": "./dist/assistant-link-capabilities.js"
    },
    "./assistant-link-capabilities-provider": {
      "types": "./dist/assistant-link-capabilities-provider.d.ts",
      "import": "./dist/assistant-link-capabilities-provider.js"
    },
    "./context-usage-store": {
      "types": "./dist/context-usage-store.d.ts",
      "import": "./dist/context-usage-store.js"
    },
    "./data-stream-runtime": {
      "types": "./dist/data-stream-runtime.d.ts",
      "import": "./dist/data-stream-runtime.js"
    },
    "./follow-up-queue-store": {
      "types": "./dist/follow-up-queue-store.d.ts",
      "import": "./dist/follow-up-queue-store.js"
    },
    "./mcp-task-bridge-context": {
      "types": "./dist/mcp-task-bridge-context.d.ts",
      "import": "./dist/mcp-task-bridge-context.js"
    },
    "./mcp-task-status-card": {
      "types": "./dist/mcp-task-status-card.d.ts",
      "import": "./dist/mcp-task-status-card.js"
    },
    "./rewind-composer-store": {
      "types": "./dist/rewind-composer-store.d.ts",
      "import": "./dist/rewind-composer-store.js"
    },
    "./styles.css": "./styles.css",
    "./tool-fallback": {
      "types": "./dist/tool-fallback.d.ts",
      "import": "./dist/tool-fallback.js"
    },
    "./tool-result-renderer-context": {
      "types": "./dist/tool-result-renderer-context.d.ts",
      "import": "./dist/tool-result-renderer-context.js"
    },
    "./tool-result-renderers": {
      "types": "./dist/use-tool-result-renderers.d.ts",
      "import": "./dist/use-tool-result-renderers.js"
    },
    "./worktree-archive-confirmation-dialog": {
      "types": "./dist/workspace-bar/worktree-archive-confirmation-dialog.d.ts",
      "import": "./dist/workspace-bar/worktree-archive-confirmation-dialog.js"
    }
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b . && node ../../scripts/copy-files.mjs src/overrides.css dist/overrides.css",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "lint": "pnpm -w lint",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "turbo": {
    "outputs": [
      "dist/**"
    ]
  }
}
