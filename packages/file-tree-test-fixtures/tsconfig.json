{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strictNullChecks": true,
    "types": [
      "node"
    ]
  },
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
