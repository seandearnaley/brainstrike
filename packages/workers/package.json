{
  "name": "@brainstrike/workers",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/file-tree-test-fixtures": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/api": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    "./file-content-worker": {
      "types": "./dist/file-content-worker.d.ts",
      "import": "./dist/file-content-worker.js",
      "require": "./dist/file-content-worker.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "private": true,
  "scripts": {
    "build": "pnpm run clean && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "mutation": "stryker run",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module"
}
