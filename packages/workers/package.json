{
  "name": "@brainstrike/workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    "./file-content-worker": {
      "types": "./dist/file-content-worker.d.ts",
      "import": "./dist/file-content-worker.js",
      "require": "./dist/file-content-worker.js"
    },
    "./report-generation-worker": {
      "types": "./dist/report-generation-worker.d.ts",
      "import": "./dist/report-generation-worker.js",
      "require": "./dist/report-generation-worker.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsc -b .",
    "prepublishOnly": "pnpm run build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage",
    "mutation": "npx @stryker-mutator/core run"
  },
  "dependencies": {
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/api": "^9.4.0",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/typescript-checker": "^9.4.0",
    "@stryker-mutator/vitest-runner": "^9.4.0",
    "@types/node": "^24.10.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
