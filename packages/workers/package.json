{
  "name": "@brainstrike/workers",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "exports": {
    "./file-content-worker": {
      "types": "./dist/file-content-worker.d.ts",
      "import": "./dist/file-content-worker.js",
      "require": "./dist/file-content-worker.js"
    },
    "./report-generation-worker": {
      "types": "./dist/report-generation-worker.d.ts",
      "import": "./dist/report-generation-worker.js",
      "require": "./dist/report-generation-worker.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "private": true,
  "scripts": {
    "build": "pnpm run clean && tsc -b .",
    "clean": "rimraf dist",
    "mutation": "npx @stryker-mutator/core run",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module"
}
