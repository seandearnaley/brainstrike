{
  "name": "@brainstrike/workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": ["dist/**/*.js", "dist/**/*.d.ts"],
  "exports": {
    "./persistence-worker": "./dist/persistence-worker.js",
    "./file-content-worker": "./dist/file-content-worker.js",
    "./tokenizer-worker": "./dist/tokenizer-worker.js",
    "./watch-worker": "./dist/watch-worker.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsc -b .",
    "prepublishOnly": "pnpm run build",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "rimraf": "^6",
    "typescript": "^5",
    "vitest": "^2"
  }
}
