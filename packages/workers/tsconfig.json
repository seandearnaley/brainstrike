{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "./",
    "outDir": "./dist",
    "declaration": true,
    "types": [
      "node"
    ],
    "paths": {
      "@brainstrike/storage": [
        "../storage/dist/index.d.ts"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "*.ts",
    "!*.test.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "references": [
    {
      "path": "../storage"
    },
    {
      "path": "../types"
    },
    {
      "path": "../file-system"
    },
    {
      "path": "../utils"
    }
  ]
}