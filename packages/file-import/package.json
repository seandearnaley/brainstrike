{
  "name": "@brainstrike/file-import",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/chunking-worker": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embedding-worker": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "28.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./browser-queue-port": {
      "types": "./dist/browser-queue-port.d.ts",
      "import": "./dist/browser-queue-port.js",
      "require": "./dist/browser-queue-port.js"
    },
    "./chunking-worker-context": {
      "types": "./dist/chunking-worker-context.d.ts",
      "import": "./dist/chunking-worker-context.js",
      "require": "./dist/chunking-worker-context.js"
    },
    "./enhanced-import": {
      "types": "./dist/enhanced-import.d.ts",
      "import": "./dist/enhanced-import.js",
      "require": "./dist/enhanced-import.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "private": true,
  "scripts": {
    "build": "tsc -b .",
    "clean": "rimraf dist",
    "lint": "pnpm run --dir=../.. lint",
    "test": "vitest run",
    "test:coverage": "pnpm -w test:coverage",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "dist/index.d.ts"
}
