{
  "name": "@brainstrike/file-import",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/chunking-worker": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./canonical-symbol-inserts": {
      "types": "./src/canonical-symbol-inserts.ts",
      "import": "./dist/canonical-symbol-inserts.js",
      "require": "./dist/canonical-symbol-inserts.js"
    },
    "./canonical-index-publication": {
      "types": "./src/canonical-index-publication.ts",
      "import": "./dist/canonical-index-publication.js",
      "require": "./dist/canonical-index-publication.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "lint": "pnpm -w lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "./src/index.ts"
}
