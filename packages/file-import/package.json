{
  "name": "@brainstrike/file-import",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b .",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "pnpm run --dir=../.. lint",
    "test": "vitest run",
    "test:coverage": "pnpm -w test:coverage"
  },
  "dependencies": {
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
