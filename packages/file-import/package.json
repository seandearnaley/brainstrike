{
  "name": "@brainstrike/file-import",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b .",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "lint": "pnpm run --dir=../.. lint",
    "test": "vitest run",
    "test:coverage": "pnpm -w test:coverage"
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/chunking-worker": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embedding-worker": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.10.7",
    "@types/react": "^19.2.8",
    "jsdom": "26.1.0",
    "react": "^19.2.3",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
