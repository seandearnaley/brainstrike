{
  "name": "@brainstrike/file-import",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/chunking-worker": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/worker-runtime": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@electric-sql/pglite": "0.5.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./browser-queue-port": {
      "types": "./dist/browser-queue-port.d.ts",
      "import": "./dist/browser-queue-port.js",
      "require": "./dist/browser-queue-port.js"
    },
    "./chunking-worker-context": {
      "types": "./dist/chunking-worker-context.d.ts",
      "import": "./dist/chunking-worker-context.js",
      "require": "./dist/chunking-worker-context.js"
    },
    "./enhanced-import": {
      "types": "./dist/enhanced-import.d.ts",
      "import": "./dist/enhanced-import.js",
      "require": "./dist/enhanced-import.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "private": true,
  "scripts": {
    "build": "tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "lint": "pnpm -w lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "dist/index.d.ts"
}
