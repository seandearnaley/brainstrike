{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "strictNullChecks": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../db"
    },
    {
      "path": "../indexing-contract"
    },
    {
      "path": "../text-splitter"
    },
    {
      "path": "../logging"
    },
    {
      "path": "../worker-runtime"
    }
  ]
}
