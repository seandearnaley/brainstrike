{
  "name": "@brainstrike/workspace-search",
  "description": "Workspace search result model and session-lived search store",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/db": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/preferences": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "lucide-react": "^1.23.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "happy-dom": "^20.10.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "scripts": {
    "build": "node ../../scripts/rimraf.mjs dist && tsc -b .",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
