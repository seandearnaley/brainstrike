{
  "name": "@brainstrike/workspace-search",
  "description": "Workspace search result model and session-lived search store",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/file-explorer": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "lucide-react": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "catalog:",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./dist/core/index.js"
    },
    "./styles.css": "./styles.css",
    "./workspace-search-store": {
      "types": "./src/core/workspace-search-store.ts",
      "import": "./dist/core/workspace-search-store.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "type": "module",
  "types": "./src/index.ts"
}
