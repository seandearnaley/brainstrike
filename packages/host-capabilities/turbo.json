{
  "extends": ["//"],
  "tasks": {
    "test": {
      // Every test process loads @brainstrike/secure-fs-native/default-owner as
      // its first setup file (BST-2246), and the Windows executeCommand and hook
      // suites load @brainstrike/windows-job-native. An add-on's uncached
      // `node-gyp rebuild` first removes build/, so the suites need both builds first.
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@brainstrike/secure-fs-native#build",
        "@brainstrike/windows-job-native#build"
      ]
    },
    "test:integration": {
      // Spawned CLI proofs run the bin from source under Node; it loads the
      // native add-ons (`^build`).
      "dependsOn": ["$TURBO_EXTENDS$", "^build"]
    }
  }
}
