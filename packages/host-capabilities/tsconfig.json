{
  "extends": "../config/tsconfig/node-library.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "apiStabilityLeak": "error",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingStarInYieldEffectGen": "error",
          "promiseInEffectSuccess": "error",
          "returnEffectInGen": "error",
          "unsafeEffectTypeAssertion": "error",
          "experimentalApiUsage": "error",
          "unstableApiUsage": "error"
        }
      }
    ]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "__tests__"],
  "references": [
    { "path": "../agent-host" },
    { "path": "../assistant-contract" },
    { "path": "../effect-kit" },
    { "path": "../host-lease" }
  ]
}
