{
  "name": "@brainstrike/host-capabilities",
  "version": "0.1.0",
  "description": "Node capability adapters every agent host composes: credentials, provider auth, tools, MCP and policy",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": { "brainstrike": "./bin/brainstrike.mjs", "brainstrike-host": "./bin/brainstrike.mjs" },
  "engines": { "node": ">=24.20.0 <25 || >=26.8.2 <27" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./credentials": { "types": "./dist/credentials.d.ts", "default": "./dist/credentials.js" },
    "./platform": { "types": "./dist/platform.d.ts", "default": "./dist/platform.js" },
    "./mcp/*": { "types": "./dist/mcp/*.d.ts", "default": "./dist/mcp/*.js" },
    "./openrouter-model-metadata": {
      "types": "./dist/openrouter-model-metadata.d.ts",
      "default": "./dist/openrouter-model-metadata.js"
    },
    "./provider-credentials": {
      "types": "./dist/provider-credentials.d.ts",
      "default": "./dist/provider-credentials.js"
    },
    "./provider-status": {
      "types": "./dist/provider-status.d.ts",
      "default": "./dist/provider-status.js"
    },
    "./provider-verification": {
      "types": "./dist/provider-verification.d.ts",
      "default": "./dist/provider-verification.js"
    }
  },
  "files": ["bin", "dist"],
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo"
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/agent-host": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/assistant-data": "workspace:*",
    "@brainstrike/assistant-service": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/host-lease": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "effect": "catalog:",
    "strip-ansi": "7.2.0",
    "vscode-jsonrpc": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
