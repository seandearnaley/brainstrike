{
  "name": "@brainstrike/host-capabilities",
  "version": "0.1.0",
  "description": "Node capability adapters every agent host composes: credentials, provider auth, tools, MCP and policy",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "brainstrike": "./bin/brainstrike.mjs",
    "brainstrike-host": "./bin/brainstrike.mjs"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27"
  },
  "exports": {
    ".": "./src/index.ts",
    "./canvas-state": "./src/native-tools/canvas-state.ts",
    "./command-sessions": "./src/command-sessions/index.ts",
    "./delegation": "./src/delegation.ts",
    "./credentials": "./src/credentials.ts",
    "./hooks": "./src/hooks/index.ts",
    "./git-workspace": "./src/git-workspace/index.ts",
    "./windows-command-entry": "./bin/windows-command-entry.mjs",
    "./windows-command-process": "./src/windows-command-process.ts",
    "./windows-command-wrapper": "./src/windows-command-wrapper.ts",
    "./native-tools": "./src/native-tools/index.ts",
    "./platform": "./src/platform.ts",
    "./workspace-context": "./src/workspace-context/index.ts",
    "./workspace-files": "./src/workspace-files/index.ts",
    "./workspace-roots": "./src/workspace-roots/index.ts",
    "./agent-ignore-guard": "./src/native-tools/agent-ignore-guard.ts",
    "./extract-url-refusal": "./src/native-tools/extract-url-refusal.ts",
    "./grep-search": "./src/native-tools/grep-search.ts",
    "./grep-search-result-contract": "./src/native-tools/grep-search-result-contract.ts",
    "./workspace-file-walk": "./src/native-tools/workspace-file-walk.ts",
    "./workspace-path": "./src/native-tools/workspace-path.ts",
    "./workspace-root-cwd": "./src/workspace-root-cwd.ts",
    "./workspace-text-file-reader": "./src/native-tools/workspace-text-file-reader.ts",
    "./mcp/*": "./src/mcp/*.ts",
    "./openrouter-model-metadata": "./src/openrouter-model-metadata.ts",
    "./provider-base-url": "./src/provider-base-url.ts",
    "./provider-credentials": "./src/provider-credentials.ts",
    "./provider-status": "./src/provider-status.ts",
    "./provider-verification": "./src/provider-verification.ts"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "postinstall": "node scripts/chmod-pty-spawn-helper.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/agent-host": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/assistant-data": "workspace:*",
    "@brainstrike/assistant-service": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/host-lease": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/secure-fs-native": "workspace:*",
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/windows-job-native": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@vscode/ripgrep": "catalog:",
    "effect": "catalog:",
    "jsonc-parser": "catalog:",
    "minimatch": "catalog:",
    "node-pty": "catalog:",
    "openid-client": "catalog:",
    "strip-ansi": "catalog:",
    "tree-kill": "catalog:",
    "typescript": "catalog:",
    "typescript-language-server": "catalog:",
    "vscode-jsonrpc": "catalog:",
    "vscode-languageserver-protocol": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "vitest": "catalog:"
  }
}
