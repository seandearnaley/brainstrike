{
  "name": "@brainstrike/host-capabilities",
  "version": "0.1.0",
  "description": "Node capability adapters every agent host composes: credentials, provider auth, tools, MCP and policy",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": { "brainstrike": "./bin/brainstrike.mjs", "brainstrike-host": "./bin/brainstrike.mjs" },
  "engines": { "node": ">=24.20.0 <25 || >=26.8.2 <27" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./canvas-state": {
      "types": "./dist/native-tools/canvas-state.d.ts",
      "default": "./dist/native-tools/canvas-state.js"
    },
    "./delegation": { "types": "./dist/delegation.d.ts", "default": "./dist/delegation.js" },
    "./credentials": { "types": "./dist/credentials.d.ts", "default": "./dist/credentials.js" },
    "./hooks": { "types": "./dist/hooks/index.d.ts", "default": "./dist/hooks/index.js" },
    "./windows-command-entry": "./bin/windows-command-entry.mjs",
    "./windows-command-process": {
      "types": "./dist/windows-command-process.d.ts",
      "default": "./dist/windows-command-process.js"
    },
    "./windows-command-wrapper": {
      "types": "./dist/windows-command-wrapper.d.ts",
      "default": "./dist/windows-command-wrapper.js"
    },
    "./native-tools": {
      "types": "./dist/native-tools/index.d.ts",
      "default": "./dist/native-tools/index.js"
    },
    "./platform": { "types": "./dist/platform.d.ts", "default": "./dist/platform.js" },
    "./agent-ignore-guard": {
      "types": "./dist/native-tools/agent-ignore-guard.d.ts",
      "default": "./dist/native-tools/agent-ignore-guard.js"
    },
    "./extract-url-refusal": {
      "types": "./dist/native-tools/extract-url-refusal.d.ts",
      "default": "./dist/native-tools/extract-url-refusal.js"
    },
    "./grep-search-result-contract": {
      "types": "./dist/native-tools/grep-search-result-contract.d.ts",
      "default": "./dist/native-tools/grep-search-result-contract.js"
    },
    "./workspace-file-walk": {
      "types": "./dist/native-tools/workspace-file-walk.d.ts",
      "default": "./dist/native-tools/workspace-file-walk.js"
    },
    "./workspace-path": {
      "types": "./dist/native-tools/workspace-path.d.ts",
      "default": "./dist/native-tools/workspace-path.js"
    },
    "./workspace-text-file-reader": {
      "types": "./dist/native-tools/workspace-text-file-reader.d.ts",
      "default": "./dist/native-tools/workspace-text-file-reader.js"
    },
    "./mcp/*": { "types": "./dist/mcp/*.d.ts", "default": "./dist/mcp/*.js" },
    "./openrouter-model-metadata": {
      "types": "./dist/openrouter-model-metadata.d.ts",
      "default": "./dist/openrouter-model-metadata.js"
    },
    "./provider-credentials": {
      "types": "./dist/provider-credentials.d.ts",
      "default": "./dist/provider-credentials.js"
    },
    "./provider-status": {
      "types": "./dist/provider-status.d.ts",
      "default": "./dist/provider-status.js"
    },
    "./provider-verification": {
      "types": "./dist/provider-verification.d.ts",
      "default": "./dist/provider-verification.js"
    }
  },
  "files": ["bin", "dist"],
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc -b .",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo"
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/agent-host": "workspace:*",
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/assistant-data": "workspace:*",
    "@brainstrike/assistant-service": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/host-lease": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/windows-job-native": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "effect": "catalog:",
    "jsonc-parser": "^3.3.1",
    "minimatch": "catalog:",
    "strip-ansi": "7.2.0",
    "vscode-jsonrpc": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/state-store": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
