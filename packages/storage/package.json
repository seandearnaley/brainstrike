{
  "name": "@brainstrike/storage",
  "version": "0.1.0",
  "description": "Platform-aware storage adapters for web and desktop",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b . && tsup src/index.ts --format esm,cjs --out-dir dist",
    "build:types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose & tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@brainstrike/platform-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "37.3.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
