{
  "name": "@brainstrike/storage",
  "version": "0.1.0",
  "description": "Platform-aware storage adapters for web and desktop",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc && tsup",
    "build:types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose & tsup --watch",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "dependencies": {
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "@vitest/browser-playwright": "^4.0.17",
    "electron": "39.2.7",
    "jsdom": "26.1.0",
    "playwright": "^1.57.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
