{
  "name": "@brainstrike/storage",
  "version": "0.1.0",
  "description": "Platform-aware storage adapters for web and desktop",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b . && tsup",
    "build:types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose & tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@brainstrike/types": "workspace:*",
    "zustand": "^5"
  },
  "devDependencies": {
    "@brainstrike/config": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.1.1"
  }
} 