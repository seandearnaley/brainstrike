{
  "name": "@brainstrike/storage",
  "description": "Durable renderer stores (zustand persist on localStorage) and Main's string key-value file store",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/logging": "workspace:*",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "electron": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./electron": "./src/electron.ts"
  },
  "scripts": {
    "test": "vitest run --project unit",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
