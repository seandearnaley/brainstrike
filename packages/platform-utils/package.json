{
  "name": "@brainstrike/platform-utils",
  "description": "Platform detection utilities",
  "version": "0.1.0",
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "type": "module",
  "types": "./src/index.ts"
}
