{
  "name": "@brainstrike/platform-utils",
  "version": "0.1.0",
  "description": "Platform detection utilities",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b . && tsup src/index.ts --format esm,cjs --dts --out-dir dist",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
