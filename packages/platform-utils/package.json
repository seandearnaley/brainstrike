{
  "name": "@brainstrike/platform-utils",
  "description": "Platform detection utilities",
  "version": "0.1.0",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "happy-dom": "^20.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc -b . && tsup src/index.ts --format esm,cjs --dts --out-dir dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
