{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "strictNullChecks": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ]
}
