{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "module": "ESNext",
    "target": "ESNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "apiStabilityLeak": "error",
          "experimentalApiUsage": "error",
          "unstableApiUsage": "error"
        }
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "references": [
    {
      "path": "../effect-kit"
    },
    {
      "path": "../types"
    },
    {
      "path": "../queue"
    },
    {
      "path": "../indexing-contract"
    },
    {
      "path": "../logging"
    },
    {
      "path": "../tokenization"
    },
    {
      "path": "../utils"
    }
  ]
}
