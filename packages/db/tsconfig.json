{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,

    "declarationMap": true,
    "declarationDir": "dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "module": "ESNext",
    "target": "ESNext",

    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}
