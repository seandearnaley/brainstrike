{
  "name": "@brainstrike/db",
  "version": "0.1.0",
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/text-splitter": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@electric-sql/pglite": "^0.4.4",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "jsdom": "29.0.2",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "db:export": "tsx scripts/export-migrations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:generate && pnpm db:export",
    "dev": "tsc --build --watch",
    "mutation": "npx @stryker-mutator/core run",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:coverage": "pnpm run test --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:vector": "TEST_ENABLE_VECTOR=true vitest run vector-extension.integration.test.ts search-similar-sql-path.integration.test.ts",
    "test:vector:watch": "TEST_ENABLE_VECTOR=true vitest vector-extension.integration.test.ts search-similar-sql-path.integration.test.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
