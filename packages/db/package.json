{
  "name": "@brainstrike/db",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*"
  },
  "devDependencies": {
    "@brainstrike/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc --build",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
