{
  "name": "@brainstrike/db",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/effect-kit": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/logging": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/tokenization": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-pg_textsearch": "catalog:",
    "@electric-sql/pglite-pgvector": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@stryker-mutator/api": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.10",
    "esbuild": "catalog:",
    "fake-indexeddb": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-wasm": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./browser-pglite-storage": {
      "types": "./dist/browser-pglite-storage.d.ts",
      "import": "./dist/browser-pglite-storage.js",
      "require": "./dist/browser-pglite-storage.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.js"
    },
    "./pglite-factory": {
      "types": "./dist/pglite-factory.d.ts",
      "import": "./dist/pglite-factory.js",
      "require": "./dist/pglite-factory.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prune-stale-dist.mjs && tsc --build",
    "bench:hybrid-search": "pnpm --filter @brainstrike/types --filter @brainstrike/queue --filter @brainstrike/indexing-contract --filter @brainstrike/tokenization --filter @brainstrike/utils run build && tsx scripts/benchmark-hybrid-search.ts",
    "bench:live-query-params": "tsx scripts/benchmark-live-query-params.ts",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "db:export": "tsx scripts/export-migrations.ts",
    "db:generate": "node scripts/forbid-db-generate.mjs",
    "db:generate:unsafe": "drizzle-kit generate",
    "db:migrate": "node scripts/forbid-db-generate.mjs",
    "db:migrate:unsafe": "pnpm db:generate:unsafe && pnpm db:export",
    "dev": "tsc --build --watch",
    "eval:retrieval": "pnpm --filter @brainstrike/types --filter @brainstrike/queue --filter @brainstrike/indexing-contract --filter @brainstrike/tokenization --filter @brainstrike/utils run build && tsx src/evaluation/retrieval-eval-cli.ts",
    "mutation": "stryker run",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --project unit --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:coverage:db:shard": "node ../../scripts/run-env.mjs DB_TEST_SHARD_REQUIRED=true -- vitest run --project unit --coverage --coverage.reporter=text --reporter=default --reporter=blob --reporter=@brainstrike/test-utils/vitest-lost-file-reporter",
    "test:crash-gate": "vitest run --project unit --reporter=verbose --reporter=@brainstrike/test-utils/vitest-lost-file-reporter --disableConsoleIntercept __tests__/crash-injection-gate.integration.test.ts",
    "test:pg-textsearch-durability": "node ../../scripts/run-env.mjs TEST_ENABLE_PG_TEXTSEARCH_DURABILITY=true -- vitest run --project unit --reporter=verbose --reporter=@brainstrike/test-utils/vitest-lost-file-reporter --disableConsoleIntercept __tests__/pg-textsearch-durability-gate.integration.test.ts",
    "test:vector": "TEST_ENABLE_VECTOR=true vitest run vector-extension.integration.test.ts search-similar-sql-path.integration.test.ts",
    "test:vector:watch": "TEST_ENABLE_VECTOR=true vitest vector-extension.integration.test.ts search-similar-sql-path.integration.test.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --strict"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
