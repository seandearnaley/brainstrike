{
  "name": "@brainstrike/db",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-pg_textsearch": "catalog:",
    "@electric-sql/pglite-pgvector": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@stryker-mutator/api": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "drizzle-kit": "^0.31.10",
    "esbuild": "catalog:",
    "fake-indexeddb": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vite-plugin-wasm": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./browser-pglite-storage": {
      "types": "./dist/browser-pglite-storage.d.ts",
      "import": "./dist/browser-pglite-storage.js",
      "require": "./dist/browser-pglite-storage.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "db:export": "tsx scripts/export-migrations.ts",
    "db:generate": "node scripts/forbid-db-generate.mjs",
    "db:generate:unsafe": "drizzle-kit generate",
    "db:migrate": "node scripts/forbid-db-generate.mjs",
    "db:migrate:unsafe": "pnpm db:generate:unsafe && pnpm db:export",
    "dev": "tsc --build --watch",
    "eval:retrieval": "pnpm --filter @brainstrike/types --filter @brainstrike/queue --filter @brainstrike/indexing-contract --filter @brainstrike/utils run build && tsx src/evaluation/retrieval-eval-cli.ts",
    "mutation": "npx @stryker-mutator/core run",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:coverage": "node scripts/test-lanes.mjs run all --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:coverage:db:architecture": "node scripts/coverage-lanes.mjs run architecture",
    "test:coverage:db:check-lanes": "node scripts/coverage-lanes.mjs check",
    "test:coverage:db:chunking": "node scripts/coverage-lanes.mjs run chunking",
    "test:coverage:db:migrations": "node scripts/coverage-lanes.mjs run migrations",
    "test:coverage:db:queue": "node scripts/coverage-lanes.mjs run queue",
    "test:coverage:db:repositories": "node scripts/coverage-lanes.mjs run repositories",
    "test:coverage:db:runtime": "node scripts/coverage-lanes.mjs run runtime",
    "test:coverage:db:search": "node scripts/coverage-lanes.mjs run search",
    "test:db:check-lanes": "node scripts/test-lanes.mjs check",
    "test:db:integration": "node scripts/test-lanes.mjs run integration",
    "test:db:queue": "node scripts/test-lanes.mjs run queue",
    "test:db:repository": "node scripts/test-lanes.mjs run repository",
    "test:db:schema-migration": "node scripts/test-lanes.mjs run schema-migration",
    "test:db:search": "node scripts/test-lanes.mjs run search",
    "test:pg-textsearch-durability": "node ../../scripts/run-env.mjs TEST_ENABLE_PG_TEXTSEARCH_DURABILITY=true -- vitest run --project unit --reporter=verbose --disableConsoleIntercept __tests__/pg-textsearch-durability-gate.integration.test.ts",
    "test:vector": "TEST_ENABLE_VECTOR=true vitest run vector-extension.integration.test.ts search-similar-sql-path.integration.test.ts",
    "test:vector:watch": "TEST_ENABLE_VECTOR=true vitest vector-extension.integration.test.ts search-similar-sql-path.integration.test.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
