{
  "name": "@brainstrike/mcp-test-lab",
  "description": "Deterministic MCP protocol fixtures, faults, and verification evidence for Brainstrike tests",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/mcp-tasks-extension": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/core": "catalog:",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "effect": "catalog:",
    "entities": "8.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/config": "workspace:*",
    "@brainstrike/test-utils": "workspace:*",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.12",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.20.0 <25 || >=26.8.2 <27"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./evidence": {
      "types": "./src/evidence.ts",
      "default": "./dist/evidence.js"
    },
    "./faults": {
      "types": "./src/faults.ts",
      "default": "./dist/faults.js"
    },
    "./lab": {
      "types": "./src/lab.ts",
      "default": "./dist/lab.js"
    },
    "./runner": {
      "types": "./src/runner.ts",
      "default": "./dist/runner.js"
    },
    "./scenario": {
      "types": "./src/scenario.ts",
      "default": "./dist/scenario.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "private": true,
  "scripts": {
    "build": "node ../../scripts/rimraf.mjs dist && node scripts/build.mjs && tsc --emitDeclarationOnly && node scripts/verify-built-package.mjs",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "lint": "pnpm -w lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "verify": "pnpm --filter @brainstrike/mcp-test-lab... build && node dist/runner-cli.js"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./src/index.ts"
}
