{
  "name": "@brainstrike/mcp-test-lab",
  "description": "Deterministic MCP protocol fixtures for Brainstrike tests",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/mcp-tasks-extension": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./lab": {
      "types": "./src/lab.ts",
      "default": "./dist/lab.js"
    },
    "./scenario": {
      "types": "./src/scenario.ts",
      "default": "./dist/scenario.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "private": true,
  "scripts": {
    "build": "node ../../scripts/rimraf.mjs dist && tsc && node scripts/verify-built-package.mjs",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./src/index.ts"
}
