{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "__tests__/**/*.test.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
