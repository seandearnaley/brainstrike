{
  "name": "@brainstrike/sqlite-native",
  "description": "better-sqlite3 and sqlite-vec as pinned prebuilt natives, with the packaged load path and provenance smoke",
  "version": "0.1.0",
  "dependencies": {
    "better-sqlite3": "catalog:",
    "sqlite-vec": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node test/ensure-prebuild.cjs && vitest run",
    "test:electron": "pnpm --filter @brainstrike/desktop exec xvfb-maybe electron --no-sandbox ../../packages/sqlite-native/test/electron-smoke.cjs",
    "test:packaged": "node test/packaged-smoke.cjs",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module"
}
