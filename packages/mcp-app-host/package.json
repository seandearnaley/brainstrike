{
  "name": "@brainstrike/mcp-app-host",
  "description": "Strict stable MCP Apps extension contracts for the Brainstrike host",
  "version": "0.1.0",
  "dependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/core": "catalog:",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@brainstrike/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.20.0 <25 || >=26.8.2 <27"
  },
  "exports": {
    ".": "./src/index.ts",
    "./capabilities": "./src/capabilities.ts",
    "./metadata": "./src/metadata.ts"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "pnpm -w lint",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "module"
}
