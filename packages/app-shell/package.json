{
  "name": "@brainstrike/app-shell",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -b .",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage"
  },
  "peerDependencies": {
    "zustand": "^5",
    "react": "^19.1.1"
  },
  "dependencies": {
    "@brainstrike/db": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/platform-utils": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/file-import": "workspace:*",
    "file-saver": "2.0.5",
    "jszip": "^3.10.1"
  },
  "license": "ISC",
  "devDependencies": {
    "zustand": "^5.0.7",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "2.0.7",
    "@types/node": "^24",
    "@types/react": "^19.1.10",
    "jsdom": "^27.0.0",
    "lucide-react": "^0.539.0",
    "vitest": "^3.2.4"
  }
}
