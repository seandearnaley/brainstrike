{
  "name": "@brainstrike/app-shell",
  "version": "0.1.0",
  "dependencies": {
    "@brainstrike/assistant-contract": "workspace:*",
    "@brainstrike/commands": "workspace:*",
    "@brainstrike/context-actions": "workspace:*",
    "@brainstrike/db-explorer": "workspace:*",
    "@brainstrike/embeddings": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/file-import": "workspace:*",
    "@brainstrike/file-system": "workspace:*",
    "@brainstrike/indexing-contract": "workspace:*",
    "@brainstrike/pipeline": "workspace:*",
    "@brainstrike/preferences": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/types": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/vector-management": "workspace:*",
    "@brainstrike/workspace-search": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.23.0"
  },
  "devDependencies": {
    "@brainstrike/db": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "jsdom": "29.1.1",
    "react-dom": "^19.2.7",
    "vitest": "^4.1.9",
    "zustand": "^5.0.14"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connected-prompt-manager-lazy": {
      "types": "./dist/connected-prompt-manager-lazy.d.ts",
      "import": "./dist/connected-prompt-manager-lazy.js"
    },
    "./cost-tracking": {
      "types": "./dist/cost-tracking/index.d.ts",
      "import": "./dist/cost-tracking/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "import": "./dist/diagnostics/index.js"
    },
    "./git-panel": {
      "types": "./dist/git-panel/index.d.ts",
      "import": "./dist/git-panel/index.js"
    },
    "./git-panel/availability": {
      "types": "./dist/git-panel/availability.d.ts",
      "import": "./dist/git-panel/availability.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./terminal-panel": {
      "types": "./dist/terminal-panel/index.d.ts",
      "import": "./dist/terminal-panel/index.js"
    },
    "./terminal-panel/availability": {
      "types": "./dist/terminal-panel/availability.d.ts",
      "import": "./dist/terminal-panel/availability.js"
    },
    "./root-layout-content": {
      "types": "./dist/root-layout-content.d.ts",
      "import": "./dist/root-layout-content.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/rimraf.mjs dist && tsc -b .",
    "clean": "node ../../scripts/rimraf.mjs dist .tsbuildinfo",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "lint": "pnpm run --dir=../.. lint",
    "test": "vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit --project tsconfig.typecheck.json && tsc --noEmit --project tsconfig.test.json"
  },
  "types": "dist/index.d.ts"
}
