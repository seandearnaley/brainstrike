{
  "name": "@brainstrike/app-shell",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -b .",
    "dev": "tsc --build --watch --preserveWatchOutput --verbose",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "pnpm run --dir=../.. lint",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -w test:coverage"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5"
  },
  "dependencies": {
    "@brainstrike/agent": "workspace:*",
    "@brainstrike/db": "workspace:*",
    "@brainstrike/db-explorer": "workspace:*",
    "@brainstrike/file-explorer-hooks": "workspace:*",
    "@brainstrike/file-explorer-ui": "workspace:*",
    "@brainstrike/preferences": "workspace:*",
    "@brainstrike/queue": "workspace:*",
    "@brainstrike/storage": "workspace:*",
    "@brainstrike/ui": "workspace:*",
    "@brainstrike/utils": "workspace:*",
    "@brainstrike/vector-management": "workspace:*",
    "lucide-react": "^0.555.0"
  },
  "license": "ISC",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "jsdom": "^27.2.0",
    "react-dom": "^19.2.0",
    "vitest": "^4.0.14",
    "zustand": "^5.0.9"
  }
}
