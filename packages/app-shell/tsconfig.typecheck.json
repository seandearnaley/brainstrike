{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@brainstrike/db-explorer/database-demo-panel": [
        "../db-explorer/src/database-demo-panel.tsx"
      ],
      "@brainstrike/assistant-contract": [
        "../assistant-contract/src/index.ts"
      ],
      "@brainstrike/assistant-contract/*": [
        "../assistant-contract/src/*"
      ],
      "@brainstrike/types": [
        "../types/src/index.ts"
      ],
      "@brainstrike/types/*": [
        "../types/src/*"
      ],
      "@brainstrike/text-splitter": [
        "../text-splitter/src/index.ts"
      ],
      "@brainstrike/text-splitter/*": [
        "../text-splitter/src/*"
      ],
      "@brainstrike/db": [
        "../db/src/index.ts"
      ],
      "@brainstrike/db/*": [
        "../db/src/*"
      ],
      "@brainstrike/agent": [
        "../agent/src/index.ts"
      ],
      "@brainstrike/agent/*": [
        "../agent/src/*"
      ],
      "@brainstrike/embeddings": [
        "../embeddings/src/index.ts"
      ],
      "@brainstrike/embeddings/*": [
        "../embeddings/src/*"
      ],
      "@brainstrike/file-system": [
        "../file-system/src/index.ts"
      ],
      "@brainstrike/file-system/*": [
        "../file-system/src/*"
      ],
      "@brainstrike/file-tree-worker": [
        "../file-tree-worker/src/index.ts"
      ],
      "@brainstrike/file-tree-worker/*": [
        "../file-tree-worker/src/*"
      ],
      "@brainstrike/hooks": [
        "../hooks/src/index.ts"
      ],
      "@brainstrike/hooks/*": [
        "../hooks/src/*"
      ],
      "@brainstrike/platform-utils": [
        "../platform-utils/src/index.ts"
      ],
      "@brainstrike/platform-utils/*": [
        "../platform-utils/src/*"
      ],
      "@brainstrike/preferences/*": [
        "../preferences/src/*"
      ],
      "@brainstrike/utils": [
        "../utils/src/index.ts"
      ],
      "@brainstrike/utils/crypto": [
        "../utils/src/crypto.ts"
      ],
      "@brainstrike/utils/*": [
        "../utils/src/*"
      ],
      "@brainstrike/file-explorer-hooks": [
        "../file-explorer-hooks/src/index.ts"
      ],
      "@brainstrike/file-explorer-ui": [
        "../file-explorer-ui/src/index.ts"
      ],
      "@brainstrike/file-explorer-ui/*": [
        "../file-explorer-ui/src/*"
      ],
      "@brainstrike/ui": [
        "../ui/src/index.ts"
      ],
      "@brainstrike/ui/*": [
        "../ui/src/*"
      ],
      "@brainstrike/storage": [
        "../storage/src/index.ts"
      ],
      "@brainstrike/token-cache": [
        "../token-cache/src/index.ts"
      ],
      "@brainstrike/token-cache/*": [
        "../token-cache/src/*"
      ],
      "@brainstrike/file-import": [
        "../file-import/src/index.ts"
      ],
      "@brainstrike/file-import/chunking-worker-context": [
        "../file-import/src/chunking-worker-context.tsx"
      ],
      "@brainstrike/queue": [
        "../queue/src/index.ts"
      ],
      "@brainstrike/queue/*": [
        "../queue/src/*"
      ],
      "@brainstrike/selection-rules": [
        "../selection-rules/src/index.ts"
      ],
      "@brainstrike/selection-rules/*": [
        "../selection-rules/src/*"
      ],
      "@brainstrike/workers": [
        "../workers"
      ],
      "@brainstrike/workers/*": [
        "../workers/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "../ui/src/vite-env.d.ts",
    "../file-explorer-ui/src/types/**/*.d.ts",
    "../file-import/src/types/**/*.d.ts",
    "../token-cache/src/types/**/*.d.ts",
    "../chunking-worker/src/types/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "vitest.config.*"
  ]
}
