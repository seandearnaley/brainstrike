{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node",
      "@testing-library/jest-dom"
    ],
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "incremental": false,
    "skipLibCheck": true,
    "noEmit": true,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "**/*.test.*",
    "../file-explorer-ui/src/types/**/*.d.ts",
    "../file-import/src/types/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
