{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node",
      "@testing-library/jest-dom"
    ],
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {},
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "**/*.test.*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
