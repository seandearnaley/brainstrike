{
  "extends": ["//"],
  "tasks": {
    "test": {
      // Do NOT cache: the default `vitest run` include (src/**/*.test.{ts,tsx})
      // matches app-shell's *.integration.test.ts files, which have NO skip guard
      // and construct REAL PGlite via wasmLoader.createPGlite (workspace-index
      // benchmark + collection-sync-import-large). Some are explicitly heavy
      // benchmark lanes on wall-clock timeouts — the same env-sensitive
      // WASM-PGlite-under-parallelism mechanism as db (see packages/db/turbo.json
      // invariant). Carved precautionary per the required-check rule.
      "cache": false,
      "passThroughEnv": ["CI", "COVERAGE"]
    }
  }
}
