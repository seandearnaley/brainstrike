{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@brainstrike/file-explorer-hooks": ["../file-explorer-hooks/src"],
      "@brainstrike/file-explorer-ui": ["../file-explorer-ui/src"],
      "@brainstrike/storage": ["../storage/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "vitest.config.ts"
  ],
  "references": [
    { "path": "../types" },
    { "path": "../ui" },
    { "path": "../file-explorer-hooks" },
    { "path": "../file-explorer-ui" },
    { "path": "../storage" }
  ]
}
