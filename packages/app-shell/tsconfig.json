{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "types": [
      "node"
    ],
    "paths": {
      "@brainstrike/db-explorer/database-demo-panel": [
        "../db-explorer/dist/database-demo-panel.d.ts"
      ],
      "@brainstrike/assistant-contract": [
        "../assistant-contract/dist/index.d.ts"
      ],
      "@brainstrike/assistant-contract/*": [
        "../assistant-contract/dist/*.d.ts"
      ],
      "@brainstrike/assistant-data": [
        "../assistant-data/dist/index.d.ts"
      ],
      "@brainstrike/assistant-data/cost-tracking": [
        "../assistant-data/dist/cost-tracking/index.d.ts"
      ],
      "@brainstrike/assistant-data/assistant-thread-run-reaper": [
        "../assistant-data/dist/assistant-thread-run-reaper.d.ts"
      ],
      "@brainstrike/types": [
        "../types/dist/index.d.ts"
      ],
      "@brainstrike/types/*": [
        "../types/dist/*.d.ts"
      ],
      "@brainstrike/text-splitter": [
        "../text-splitter/dist/index.d.ts"
      ],
      "@brainstrike/text-splitter/*": [
        "../text-splitter/dist/*.d.ts"
      ],
      "@brainstrike/tokenization": [
        "../tokenization/dist/index.d.ts"
      ],
      "@brainstrike/db": [
        "../db/dist/index.d.ts"
      ],
      "@brainstrike/db/*": [
        "../db/dist/*.d.ts"
      ],
      "@brainstrike/embeddings": [
        "../embeddings/dist/index.d.ts"
      ],
      "@brainstrike/embeddings/*": [
        "../embeddings/dist/*.d.ts"
      ],
      "@brainstrike/file-system": [
        "../file-system/dist/index.d.ts"
      ],
      "@brainstrike/file-system/*": [
        "../file-system/dist/*.d.ts"
      ],
      "@brainstrike/file-tree-worker": [
        "../file-tree-worker/dist/index.d.ts"
      ],
      "@brainstrike/file-tree-worker/*": [
        "../file-tree-worker/dist/*.d.ts"
      ],
      "@brainstrike/hooks": [
        "../hooks/dist/index.d.ts"
      ],
      "@brainstrike/hooks/*": [
        "../hooks/dist/*.d.ts"
      ],
      "@brainstrike/platform-utils": [
        "../platform-utils/dist/index.d.ts"
      ],
      "@brainstrike/platform-utils/*": [
        "../platform-utils/dist/*.d.ts"
      ],
      "@brainstrike/utils": [
        "../utils/dist/index.d.ts"
      ],
      "@brainstrike/utils/crypto": [
        "../utils/dist/crypto.d.ts"
      ],
      "@brainstrike/utils/*": [
        "../utils/dist/*.d.ts"
      ],
      "@brainstrike/file-explorer-hooks": [
        "../file-explorer-hooks/dist/index.d.ts"
      ],
      "@brainstrike/file-explorer/*": [
        "../file-explorer/dist/*.d.ts"
      ],
      "@brainstrike/file-explorer-ui": [
        "../file-explorer-ui/dist/index.d.ts"
      ],
      "@brainstrike/file-explorer-ui/*": [
        "../file-explorer-ui/dist/*.d.ts"
      ],
      "@brainstrike/indexing-contract": [
        "../indexing-contract/dist/index.d.ts"
      ],
      "@brainstrike/indexing-contract/*": [
        "../indexing-contract/dist/*.d.ts"
      ],
      "@brainstrike/ui": [
        "../ui/dist/index.d.ts"
      ],
      "@brainstrike/ui/*": [
        "../ui/dist/*.d.ts"
      ],
      "@brainstrike/storage": [
        "../storage/dist/index.d.ts"
      ],
      "@brainstrike/token-cache": [
        "../token-cache/dist/index.d.ts"
      ],
      "@brainstrike/token-cache/*": [
        "../token-cache/dist/*.d.ts"
      ],
      "@brainstrike/file-import": [
        "../file-import/dist/index.d.ts"
      ],
      "@brainstrike/file-import/chunking-worker-context": [
        "../file-import/dist/chunking-worker-context.d.ts"
      ],
      "@brainstrike/queue": [
        "../queue/dist/index.d.ts"
      ],
      "@brainstrike/queue/*": [
        "../queue/dist/*.d.ts"
      ],
      "@brainstrike/workers": [
        "../workers"
      ],
      "@brainstrike/workers/*": [
        "../workers/*"
      ]
    },
    "strictNullChecks": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "apiStabilityLeak": "error",
          "experimentalApiUsage": "error",
          "unstableApiUsage": "error"
        }
      }
    ]
  },
  "include": [
    "src/**/*",
    "../ui/src/vite-env.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "vitest.config.*"
  ],
  "references": [
    {
      "path": "../app-state"
    },
    {
      "path": "../assistant-contract"
    },
    {
      "path": "../assistant-data"
    },
    {
      "path": "../assistant-ui"
    },
    {
      "path": "../types"
    },
    {
      "path": "../ui"
    },
    {
      "path": "../file-explorer"
    },
    {
      "path": "../file-explorer-hooks"
    },
    {
      "path": "../file-explorer-ui"
    },
    {
      "path": "../storage"
    },
    {
      "path": "../file-import"
    },
    {
      "path": "../indexing-contract"
    },
    {
      "path": "../settings-ui"
    },
    {
      "path": "../db-explorer"
    },
    {
      "path": "../vector-management"
    },
    {
      "path": "../queue"
    },
    {
      "path": "../context-actions"
    },
    {
      "path": "../logging"
    },
    {
      "path": "../tokenization"
    },
    {
      "path": "../hooks"
    }
  ]
}
