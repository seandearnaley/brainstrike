{
  "name": "brainstrike",
  "version": "1.0.0",
  "description": "Brainstrike.ai",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "bench:chunking": "pnpm -w build --filter @brainstrike/db && node scripts/chunking-benchmark.mjs",
    "build:web": "turbo run build --filter @brainstrike/web --summarize --log-order=grouped --cache-dir=.turbo",
    "build": "turbo run build --summarize --log-order=grouped --cache-dir=.turbo",
    "check-just-errors": "pnpm check 2>&1 | grep -iE '(error|failed|✗|✖|FAIL)' | sed 's#^@brainstrike/##'",
    "check:fast": "node scripts/check.mjs --fast",
    "check:full": "node scripts/check.mjs --full",
    "check:headless": "pnpm -s run setup:headless && pnpm -s run check",
    "check": "node scripts/check.mjs",
    "clean": "turbo run clean --summarize --log-order=grouped --cache-dir=.turbo",
    "coverage:enforce": "node scripts/enforce-coverage.mjs",
    "coverage:merge": "node scripts/merge-coverage.js",
    "coverage:report": "nyc report --reporter=json --reporter=lcov --reporter=text --report-dir ./coverage",
    "deploy:preview": "vercel",
    "deploy": "vercel --prod",
    "dev": "turbo run dev",
    "format-and-lint:fix": "biome check . --write",
    "format-and-lint": "biome check .",
    "format": "biome format . --write",
    "knip": "knip",
    "lint-all": "pnpm lint && pnpm format",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint --max-warnings=50 apps/web/src packages/ui/src packages/file-explorer-ui/src packages/file-explorer-hooks/src",
    "lint": "pnpm run lint:eslint && biome check . --fix",
    "postinstall": "node scripts/postinstall.js",
    "queue": "pnpm -w build --filter @brainstrike/db && node packages/db/dist/cli/queue-cli.js",
    "setup:headless": "bash scripts/setup-headless-display.sh",
    "test:coverage:base": "pnpm -r --filter '!@brainstrike/embeddings' run test -- --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:coverage:embeddings": "pnpm --filter @brainstrike/embeddings vitest run --coverage --coverage.reporter=json --coverage.reporter=lcov --reporter=default",
    "test:coverage:split": "pnpm run test:coverage:base && pnpm run test:coverage:embeddings",
    "test:coverage": "turbo run test --force --concurrency=4 --summarize --log-order=grouped --cache-dir=.turbo -- --coverage --coverage.reporter=json --coverage.reporter=lcov --coverage.reporter=text",
    "test:vector": "pnpm --filter @brainstrike/db test:vector",
    "test:e2e:debug": "cd apps/web && pnpm run test:e2e:debug",
    "test:e2e:desktop:debug": "cd apps/desktop && pnpm run test:e2e:debug",
    "test:e2e:desktop:ui": "cd apps/desktop && pnpm run test:e2e:ui",
    "test:e2e:desktop": "cd apps/desktop && pnpm run test:e2e",
    "test:e2e:functional": "cd apps/web && pnpm run test:e2e:functional",
    "test:e2e:local-db": "LOCAL_FIRST_DB=true EMBED_QUEUE_ENABLED=true pnpm test:e2e",
    "test:e2e:perf": "cd apps/web && pnpm run test:e2e:perf",
    "test:e2e:ui": "cd apps/web && pnpm run test:e2e:ui",
    "test": "turbo run test --summarize --log-order=grouped --cache-dir=.turbo",
    "test:e2e": "turbo run test:e2e --filter='./apps/*' --concurrency=1",
    "test:fast": "pnpm -r --filter '!@brainstrike/embeddings' run test",
    "type-check": "turbo run type-check --summarize --log-order=grouped --cache-dir=.turbo",
    "vercel:build": "pnpm build:web",
    "vercel:dev": "pnpm dev --filter @brainstrike/web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.3.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/types": "^20.0.0",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "glob": "^11.0.3",
    "happy-dom": "^19.0.2",
    "knip": "^5.64.2",
    "lefthook": "^1.13.6",
    "mermaid": "^11.12.0",
    "nyc": "^17.1.0",
    "playwright": "^1.56.0",
    "tsup": "^8.5.0",
    "turbo": "2.5.8",
    "typescript": "^5.9.3",
    "vercel": "^48.2.6",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@swc/core",
      "@tailwindcss/oxide",
      "electron",
      "electron-winstaller",
      "esbuild",
      "lefthook",
      "onnxruntime-node",
      "oxc-resolver",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "react-helmet-async>react": "^19.0.0",
      "react-helmet-async>react-dom": "^19.0.0"
    }
  },
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "dist/**"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
