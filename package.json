{
	"name": "brainstrike",
	"version": "1.0.0",
	"description": "Brainstrike.ai",
	"main": "index.js",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "turbo run build --summarize --log-order=grouped",
		"build:web": "turbo run build --filter @brainstrike/web --summarize --log-order=grouped",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"format": "biome format . --write",
		"lint-all": "pnpm lint && pnpm format",
		"test": "turbo run test --summarize --log-order=grouped",
		"test:coverage": "turbo run test:coverage --summarize --log-order=grouped",
		"test:e2e": "turbo run test:e2e --filter='./apps/*' --concurrency=1",
		"test:e2e:ui": "cd apps/web && pnpm run test:e2e:ui",
		"test:e2e:debug": "cd apps/web && pnpm run test:e2e:debug",
		"test:e2e:desktop": "cd apps/desktop && pnpm run test:e2e",
		"test:e2e:desktop:ui": "cd apps/desktop && pnpm run test:e2e:ui",
		"test:e2e:desktop:debug": "cd apps/desktop && pnpm run test:e2e:debug",
		"check": "pnpm install && pnpm run lint-all && pnpm run build && pnpm run type-check && pnpm run test && pnpm run test:e2e",
		"clean": "turbo run clean --summarize --log-order=grouped",
		"type-check": "turbo run type-check --summarize --log-order=grouped",
		"knip": "knip",
		"coverage:merge": "node scripts/merge-coverage.js",
		"coverage:report": "nyc report --reporter=json --reporter=lcov --reporter=text --report-dir ./coverage",
		"deploy": "vercel --prod",
		"deploy:preview": "vercel",
		"vercel:build": "pnpm build:web",
		"vercel:dev": "pnpm dev --filter @brainstrike/web"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@commitlint/types": "^19.8.1",
		"@playwright/test": "^1.52.0",
		"@vitest/coverage-v8": "^3.2.2",
		"happy-dom": "^17.6.3",
		"knip": "^5.60.2",
		"nyc": "^17.1.0",
		"playwright": "^1.52.0",
		"tsup": "^8.5.0",
		"turbo": "^2.5.4",
		"typescript": "^5.8.3",
		"vercel": "^43.2.0",
		"vite": "^6.3.5",
		"vitest": "^3.2.3"
	},
	"packageManager": "pnpm@10.12.1",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@swc/core",
			"@tailwindcss/oxide",
			"electron",
			"electron-winstaller",
			"esbuild"
		],
		"overrides": {
			"react-helmet-async>react": "^19.0.0",
			"react-helmet-async>react-dom": "^19.0.0"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"@tanstack/react-virtual": "^3.13.9"
	}
}
