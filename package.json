{
  "name": "brainstrike",
  "description": "Brainstrike.ai",
  "version": "1.0.0",
  "author": "",
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@jacobwolf/biome-unnecessary-effect": "^0.1.1",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.6",
    "happy-dom": "^20.9.0",
    "knip": "^5.85.0",
    "lefthook": "^2.1.6",
    "mermaid": "^11.14.0",
    "nyc": "^18.0.0",
    "playwright": "^1.59.1",
    "syncpack": "^14.3.0",
    "tsup": "^8.5.1",
    "turbo": "2.9.6",
    "typescript": "^5.9.3",
    "ultracite": "7.6.0",
    "vercel": "^50.23.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [],
  "license": "ISC",
  "main": "index.js",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@jacobwolf/biome-unnecessary-effect",
      "@swc/core",
      "@tailwindcss/oxide",
      "core-js",
      "core-js-pure",
      "electron",
      "electron-winstaller",
      "esbuild",
      "lefthook",
      "onnxruntime-node",
      "oxc-resolver",
      "protobufjs",
      "puppeteer",
      "sharp"
    ],
    "overrides": {
      "react": "^19.2.4",
      "react-dom": "^19.2.4",
      "react-helmet-async>react": "^19.0.0",
      "react-helmet-async>react-dom": "^19.0.0",
      "webpack": "5.105.1"
    }
  },
  "scripts": {
    "bench:chunking": "pnpm -w build --filter @brainstrike/db && node scripts/chunking-benchmark.mjs",
    "build": "turbo run build --summarize --log-order=grouped",
    "build:web": "turbo run build --filter @brainstrike/web --summarize --log-order=grouped",
    "check": "node scripts/check.mjs",
    "check-just-errors": "pnpm check 2>&1 | grep -iE '(error|failed|✗|✖|FAIL)' | sed 's#^@brainstrike/##'",
    "check:fast": "node scripts/check.mjs --fast",
    "check:full": "node scripts/check.mjs --full",
    "check:headless": "pnpm -s run setup:headless && pnpm -s run check",
    "ci:local": "./scripts/local-ci.sh",
    "ci:prove": "node scripts/ci-proof.mjs prove",
    "ci:select": "node scripts/ci-select.mjs",
    "ci:timing-summary": "node scripts/ci-timing-summary.mjs",
    "ci:turbo-diagnostics": "node scripts/turbo-run-diagnostics.mjs",
    "ci:verify-proof": "node scripts/ci-proof.mjs verify-proof",
    "clean": "turbo run clean --summarize --log-order=grouped",
    "coverage:enforce": "node scripts/enforce-coverage.mjs",
    "coverage:merge": "node scripts/merge-coverage.js",
    "coverage:prepare-workspace": "node scripts/prepare-workspace-coverage.mjs",
    "coverage:report": "nyc report --reporter=json --reporter=lcov --reporter=text --report-dir ./coverage",
    "deps:fix": "syncpack fix",
    "deps:lint": "syncpack lint",
    "deps:update": "syncpack update",
    "deps:update:check": "syncpack update --check",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "dev": "turbo run dev",
    "docs:build": "pnpm --filter @brainstrike/docs build",
    "docs:dev": "pnpm --filter @brainstrike/docs dev",
    "docs:start": "pnpm --filter @brainstrike/docs start",
    "format": "biome format . --write",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "knip": "knip",
    "lint": "pnpm run lint:no-no-memo && pnpm run lint:e2e-destructive-tags && pnpm run lint:e2e-stateful-matrix && pnpm run lint:e2e-readiness-contracts && pnpm run lint:ci-workflow-contracts && pnpm run lint:eslint && biome check . --fix",
    "lint:ci": "pnpm run lint:no-no-memo && pnpm run lint:e2e-destructive-tags && pnpm run lint:e2e-stateful-matrix && pnpm run lint:e2e-readiness-contracts && pnpm run lint:ci-workflow-contracts && pnpm run lint:eslint && biome check .",
    "lint:e2e-destructive-tags": "node scripts/check-e2e-destructive-tags.mjs",
    "lint:e2e-readiness-contracts": "node scripts/check-e2e-readiness-contracts.mjs",
    "lint:e2e-stateful-matrix": "node scripts/check-e2e-stateful-matrix.mjs",
    "lint:ci-workflow-contracts": "node scripts/check-ci-workflow-contracts.mjs",
    "lint-all": "pnpm lint && pnpm format",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint --max-warnings=50 apps/web/src packages/ui/src packages/file-explorer-ui/src packages/file-explorer-hooks/src",
    "lint:no-no-memo": "node scripts/forbid-no-memo.mjs",
    "postinstall": "node scripts/postinstall.js",
    "prepare": "node scripts/postinstall.js",
    "profile:vitest-hotspots": "node scripts/profile-vitest-hotspots.mjs",
    "queue": "pnpm -w build --filter @brainstrike/db && node packages/db/dist/cli/queue-cli.js",
    "secrets:scan": "node scripts/secret-scan.mjs --all",
    "secrets:scan:staged": "node scripts/secret-scan.mjs --staged",
    "setup:headless": "bash scripts/setup-headless-display.sh",
    "test": "TURBO_TEST_MODE=unit turbo run test --summarize --log-order=grouped",
    "test:browser": "turbo run test:browser --summarize --log-order=grouped",
    "test:coverage": "TURBO_TEST_MODE=coverage COVERAGE=true turbo run test:coverage --concurrency=4 --summarize --log-order=grouped",
    "test:coverage:base": "TURBO_TEST_MODE=coverage COVERAGE=true pnpm -r --filter '!@brainstrike/embeddings' run test:coverage",
    "test:coverage:embeddings": "TURBO_TEST_MODE=coverage COVERAGE=true pnpm --filter @brainstrike/embeddings run test:coverage",
    "test:coverage:split": "pnpm run test:coverage:base && pnpm run test:coverage:embeddings",
    "test:e2e": "turbo run test:e2e --filter='./apps/*' --concurrency=1",
    "test:e2e:debug": "cd apps/web && pnpm run test:e2e:debug",
    "test:e2e:desktop": "cd apps/desktop && pnpm run test:e2e",
    "test:e2e:desktop:debug": "cd apps/desktop && pnpm run test:e2e:debug",
    "test:e2e:desktop:ui": "cd apps/desktop && pnpm run test:e2e:ui",
    "test:e2e:functional": "cd apps/web && pnpm run test:e2e:functional",
    "test:e2e:local-db": "LOCAL_FIRST_DB=true EMBED_QUEUE_ENABLED=true pnpm test:e2e",
    "test:e2e:perf": "cd apps/web && pnpm run test:e2e:perf",
    "test:e2e:ui": "cd apps/web && pnpm run test:e2e:ui",
    "test:fast": "pnpm -r --filter '!@brainstrike/embeddings' run test",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:vector": "pnpm --filter @brainstrike/db test:vector",
    "type-check": "turbo run type-check --summarize --log-order=grouped",
    "vercel:build": "pnpm build:web",
    "vercel:dev": "pnpm dev --filter @brainstrike/web"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
