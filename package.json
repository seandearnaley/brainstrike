{
  "name": "brainstrike",
  "description": "Brainstrike.ai",
  "version": "1.0.0",
  "author": "",
  "devDependencies": {
    "@babel/core": "catalog:",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@jacobwolf/biome-unnecessary-effect": "^0.1.1",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "catalog:",
    "@typescript/old": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "catalog:",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "catalog:",
    "happy-dom": "catalog:",
    "lefthook": "^2.2.2",
    "mermaid": "catalog:",
    "oxc-transform-react": "catalog:",
    "playwright": "catalog:",
    "turbo": "2.11.2",
    "typescript": "catalog:",
    "ultracite": "8.0.1",
    "vercel": "64.3.1",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "yauzl": "^3.4.0"
  },
  "engines": {
    "node": ">=24.20.0 <25 || >=26.8.2 <27"
  },
  "keywords": [],
  "license": "ISC",
  "main": "index.js",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "build": "node scripts/run-turbo-command.mjs --windows-concurrency=1 -- run build --summarize --log-order=grouped",
    "build:web": "node scripts/run-turbo-command.mjs -- run build --filter @brainstrike/web --summarize --log-order=grouped",
    "cassettes:proxy": "node scripts/provider-cassette-proxy.mjs",
    "cassettes:record": "node scripts/record-provider-cassette.mjs",
    "check": "pnpm -s run secrets:scan && pnpm -s run lint:ci && pnpm -s run type-check && pnpm -s run build && pnpm -s run test && pnpm -s run test:browser && pnpm -s run test:e2e:smoke",
    "check:headless": "pnpm -s run setup:headless && pnpm -s run check",
    "clean": "node scripts/run-turbo-command.mjs -- run clean --summarize --log-order=grouped",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "dev": "node scripts/run-turbo-command.mjs --mark-dev-deps-prepared -- run dev --concurrency=100",
    "eval:retrieval": "pnpm --filter @brainstrike/db run eval:retrieval",
    "format": "biome format . --write",
    "format-and-lint:fix": "biome check . --write",
    "lint": "pnpm run lint:eslint && biome check . --fix",
    "lint-all": "pnpm lint && pnpm format",
    "lint:biome": "biome check .",
    "lint:ci": "pnpm run lint:eslint && biome check .",
    "lint:eslint": "eslint --cache --cache-location node_modules/.cache/eslint/ apps/desktop/src apps/web/src packages",
    "postinstall": "node scripts/postinstall.js",
    "predev": "node scripts/ensure-desktop-dev-deps.mjs",
    "prepare": "node scripts/postinstall.js",
    "queue": "pnpm -w build --filter @brainstrike/db && node packages/db/dist/cli/queue-cli.js",
    "secrets:scan": "node scripts/secret-scan.mjs --all",
    "secrets:scan:staged": "node scripts/secret-scan.mjs --staged",
    "setup:headless": "bash scripts/setup-headless-display.sh",
    "test": "node scripts/run-env.mjs TURBO_TEST_MODE=unit TEST_TIMEOUT_MULTIPLIER=2 -- node scripts/run-turbo-command.mjs --windows-concurrency=1 -- run test --concurrency=1 --summarize --log-order=grouped && node scripts/run-env.mjs TURBO_TEST_MODE=unit TEST_TIMEOUT_MULTIPLIER=2 -- node scripts/run-turbo-command.mjs --windows-concurrency=1 -- run test:integration --concurrency=2 --summarize --log-order=grouped",
    "test:affected": "node scripts/run-env.mjs TURBO_TEST_MODE=unit TEST_TIMEOUT_MULTIPLIER=2 -- node scripts/run-turbo-command.mjs --windows-concurrency=1 -- run test --affected --concurrency=1 --summarize --log-order=grouped && node scripts/run-env.mjs TURBO_TEST_MODE=unit TEST_TIMEOUT_MULTIPLIER=2 -- node scripts/run-turbo-command.mjs --windows-concurrency=1 -- run test:integration --affected --concurrency=2 --summarize --log-order=grouped",
    "test:browser": "node scripts/run-env.mjs TEST_TIMEOUT_MULTIPLIER=2 -- node scripts/run-turbo-command.mjs -- run test:browser --concurrency=1 --summarize --log-order=grouped",
    "test:e2e": "node scripts/run-turbo-command.mjs -- run test:e2e --filter='./apps/*' --concurrency=1",
    "test:e2e:debug": "cd apps/web && pnpm run test:e2e:debug",
    "test:e2e:desktop": "cd apps/desktop && pnpm run test:e2e",
    "test:e2e:desktop:debug": "cd apps/desktop && pnpm run test:e2e:debug",
    "test:e2e:desktop:ui": "cd apps/desktop && pnpm run test:e2e:ui",
    "test:e2e:functional": "cd apps/web && pnpm run test:e2e:functional",
    "test:e2e:local-db": "node scripts/run-env.mjs LOCAL_FIRST_DB=true EMBED_QUEUE_ENABLED=true -- pnpm test:e2e",
    "test:e2e:perf": "cd apps/web && pnpm run test:e2e:perf",
    "test:e2e:smoke": "node scripts/run-env.mjs CI=true pnpm_config_ci=false -- pnpm -s --filter @brainstrike/desktop run test:e2e:lane:smoke",
    "test:e2e:ui": "cd apps/web && pnpm run test:e2e:ui",
    "test:vector": "pnpm --filter @brainstrike/db test:vector",
    "type-check": "node scripts/run-turbo-command.mjs --windows-concurrency=1 -- run type-check --summarize --log-order=grouped",
    "vercel:build": "pnpm build:web",
    "vercel:dev": "pnpm dev --filter @brainstrike/web"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/config/*"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "download"
    }
  }
}
