{
	"name": "brainstrike",
	"version": "1.0.0",
	"description": "Brainstrike.ai",
	"main": "index.js",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"format": "biome format . --write",
		"test": "turbo run test",
		"test:coverage": "turbo run test -- --coverage",
		"test:e2e": "cd apps/web && pnpm run test:e2e",
		"test:e2e:ui": "cd apps/web && pnpm run test:e2e:ui",
		"test:e2e:debug": "cd apps/web && pnpm run test:e2e:debug",
		"clean": "turbo run clean",
		"type-check": "turbo run type-check",
		"knip": "knip",
		"coverage:merge": "mkdir -p .nyc_output && find apps packages -name 'coverage-final.json' > coverage-files.txt && node -e \"const fs=require('fs');const files=fs.readFileSync('coverage-files.txt','utf8').split('\\n').filter(Boolean);const merged={};files.forEach(f=>{if(fs.existsSync(f)){const content=JSON.parse(fs.readFileSync(f,'utf8'));Object.assign(merged,content);}});fs.writeFileSync('.nyc_output/coverage.json',JSON.stringify(merged));\" && rm coverage-files.txt",
		"coverage:report": "nyc report --reporter=json --reporter=lcov --reporter=text --report-dir ./coverage"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@commitlint/types": "^19.8.0",
		"knip": "^5.50.2",
		"tsup": "^8.4.0",
		"turbo": "^2.5.0",
		"typescript": "^5.8.3",
		"nyc": "^17.1.0",
		"vitest": "^3.1.1"
	},
	"packageManager": "pnpm@10.8.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@swc/core",
			"esbuild"
		]
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"react-virtuoso": "^4.12.6"
	}
}
