{
	"name": "brainstrike",
	"version": "1.0.0",
	"description": "Brainstrike.ai",
	"main": "index.js",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"format": "biome format . --write",
		"test": "turbo run test",
		"test:coverage": "turbo run test -- --coverage",
		"test:e2e": "cd apps/web && pnpm run test:e2e",
		"test:e2e:ui": "cd apps/web && pnpm run test:e2e:ui",
		"test:e2e:debug": "cd apps/web && pnpm run test:e2e:debug",
		"clean": "turbo run clean",
		"type-check": "turbo run type-check",
		"knip": "knip",
		"coverage:merge": "turbo run coverage:merge",
		"coverage:report": "turbo run coverage:report"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@commitlint/types": "^19.8.0",
		"knip": "^5.0.0",
		"tsup": "^8.0.1",
		"turbo": "^2.5.0",
		"typescript": "^5.8.3",
		"vitest": "^3.1.1"
	},
	"packageManager": "pnpm@10.8.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild"
		]
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"react-virtuoso": "^4.12.6"
	}
}
