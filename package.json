{
	"name": "brainstrike",
	"version": "1.0.0",
	"description": "Brainstrike.ai",
	"main": "index.js",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"format": "biome format . --write",
		"lint-all": "pnpm lint && pnpm format",
		"test": "turbo run test --summarize --output-logs=new-only",
		"test:coverage": "turbo run test:coverage",
		"test:e2e": "cd apps/web && pnpm run test:e2e",
		"test:e2e:ui": "cd apps/web && pnpm run test:e2e:ui",
		"test:e2e:debug": "cd apps/web && pnpm run test:e2e:debug",
		"clean": "turbo run clean",
		"type-check": "turbo run type-check",
		"knip": "knip",
		"coverage:merge": "node scripts/merge-coverage.js",
		"coverage:report": "nyc report --reporter=json --reporter=lcov --reporter=text --report-dir ./coverage"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@commitlint/types": "^19.8.0",
		"@playwright/test": "^1.52.0",
		"@vitest/coverage-v8": "^3.1.1",
		"happy-dom": "^17.4.4",
		"knip": "^5.50.2",
		"nyc": "^17.1.0",
		"playwright": "^1.52.0",
		"tsup": "^8.4.0",
		"turbo": "^2.5.4",
		"typescript": "^5.8.3",
		"vitest": "^3.1.1"
	},
	"packageManager": "pnpm@10.10.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@swc/core",
			"@tailwindcss/oxide",
			"electron",
			"esbuild"
		]
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"@tanstack/react-virtual": "^3.13.9"
	}
}
