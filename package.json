{
  "name": "brainstrike",
  "version": "1.0.0",
  "description": "Brainstrike.ai",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --summarize --log-order=grouped --cache-dir=.turbo",
    "build:web": "turbo run build --filter @brainstrike/web --summarize --log-order=grouped --cache-dir=.turbo",
    "dev": "turbo run dev",
    "lint": "pnpm run lint:eslint && pnpm exec biome check . --fix",
    "lint:biome": "pnpm exec biome check .",
    "lint:eslint": "eslint --max-warnings=50 apps/web/src packages/ui/src packages/file-explorer-ui/src packages/file-explorer-hooks/src",
    "format": "pnpm exec biome format . --write",
    "format-and-lint": "pnpm exec biome check .",
    "format-and-lint:fix": "pnpm exec biome check . --write",
    "lint-all": "pnpm lint && pnpm format",
    "postinstall": "node scripts/postinstall.js",
    "test": "turbo run test --summarize --log-order=grouped --cache-dir=.turbo",
    "test:coverage": "turbo run test:coverage --summarize --log-order=grouped --cache-dir=.turbo",
    "test:e2e": "turbo run test:e2e --filter='./apps/*' --concurrency=1",
    "setup:headless": "bash scripts/setup-headless-display.sh",
    "test:e2e:ui": "cd apps/web && pnpm run test:e2e:ui",
    "test:e2e:debug": "cd apps/web && pnpm run test:e2e:debug",
    "test:e2e:desktop": "cd apps/desktop && pnpm run test:e2e",
    "test:e2e:desktop:ui": "cd apps/desktop && pnpm run test:e2e:ui",
    "test:e2e:desktop:debug": "cd apps/desktop && pnpm run test:e2e:debug",
    "check": "pnpm install && pnpm run lint-all && pnpm run build && pnpm run type-check && pnpm run test && pnpm run test:e2e",
    "clean": "turbo run clean --summarize --log-order=grouped --cache-dir=.turbo",
    "type-check": "turbo run type-check --summarize --log-order=grouped --cache-dir=.turbo",
    "knip": "knip",
    "coverage:merge": "node scripts/merge-coverage.js",
    "coverage:report": "nyc report --reporter=json --reporter=lcov --reporter=text --report-dir ./coverage",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "vercel:build": "pnpm build:web",
    "vercel:dev": "pnpm dev --filter @brainstrike/web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^6.0.0-rc.1",
    "@biomejs/biome": "^2.2.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "happy-dom": "^18.0.1",
    "knip": "^5.63.0",
    "lefthook": "^1.12.3",
    "nyc": "^17.1.0",
    "playwright": "^1.55.0",
    "tsup": "^8.5.0",
    "turbo": "2.5.6",
    "typescript": "^5.9.2",
    "vercel": "^46.0.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@swc/core",
      "@tailwindcss/oxide",
      "electron",
      "electron-winstaller",
      "esbuild",
      "lefthook",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "react-helmet-async>react": "^19.0.0",
      "react-helmet-async>react-dom": "^19.0.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
