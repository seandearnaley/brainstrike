# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Test reports
playwright-report/
playwright-report-merged/
test-results/
merged-tests/

# Mutation testing reports and artifacts
**/reports/mutation/
*.stryker-tmp/
.stryker-tmp/

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.flow
*.npmrc
*.yarnrc

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
# No trailing slash: a dir-only pattern lets a node_modules SYMLINK (as
# sandboxed agent runs create to borrow a sibling checkout's store) get
# committed — that happened once. This form matches file, dir, and symlink.
node_modules
# Agent-run working artifacts (delegation specs and reports) — never commit.
.codex-spec-*.md
REPORT-BST-*.md
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variables file
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Vite build files
/dist/
.vite/
# vite.config.js.timestamp-*.mjs

# Turbo
.turbo

# Storybook build output
storybook-static

# IDE files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
.idea

# System files
.DS_Store
Thumbs.db

.secrets
.vercel

# New pattern to ignore all tsup.config.bundled_*.mjs files in any directory
**/tsup.config.bundled_*.mjs

dist
apps/desktop/release/
apps/desktop/dist/
apps/desktop/electron-storage.json

# PGlite
*:memory:*
packages/db/*.db
apps/desktop/*.db
apps/web/*.db

# Storage test artifacts
packages/storage/store-*.json


# Blob report
apps/desktop/blob-report/
apps/web/blob-report/

# Performance benchmarks (generated by tests)
performance-benchmarks/
apps/web/performance-metrics/

# Desktop builder resources: the committed icon set under apps/desktop/build
# (icns/ico/pngs + SVG masters) is a deliberate input to the release pipeline,
# not a generated artifact — CI packaging needs it. Only legacy locally
# generated variants stay ignored.
apps/desktop/build/icon-light.*
apps/desktop/build/icons-light/
icons/.generated/

.codex/

.pnpm-store/
apps/desktop/e2e-artifacts/
apps/desktop/resources/python-runtime/*
!apps/desktop/resources/python-runtime/manifest.json

# Vitest browser-mode (real Chromium) run artifacts
**/.vitest-attachments/
packages/db/.vitest-reports/
packages/**/__screenshots__/
packages/mcp-test-lab/artifacts/

.claude
.impeccable/

# Per-session scratch artifacts (other Claude sessions may hold these)
.claude-scratch-*
.claude-scratch/
