{
	"name": "brainstrike-web",
	"version": "1.1.0",
	"private": true,
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"vercel-build": "NODE_ENV=production echo 'Node version:' && node --version && vite build 2>&1 | grep -v 'Module level directives cause errors when bundled, \"use client\"' && echo 'Build output:' && ls -la dist",
		"start": "vite preview",
		"serve-static": "npx serve dist",
		"vite:dev": "vite",
		"vite:build": "vite build",
		"vite:preview": "vite preview",
		"vite:serve-static": "npx serve dist",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:chromium": "playwright test --project=chromium",
		"prepare": "node -e \"if(process.env.NODE_ENV !== 'production') { import('husky').then(({default: husky}) => husky.install()).catch(() => {}) }\"",
		"test:e2e:ui": "playwright test --ui",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"type-check": "tsc --noEmit",
		"lint-type-check": "npm run lint:fix && npm run type-check",
		"rename-to-kebab": "node scripts/migrate-filenames.js",
		"lint-all": "npm run lint:fix && npm run type-check",
		"test:e2e:coverage": "playwright test --reporter=html --reporter=json",
		"coverage:merge": "cp coverage/coverage-final.json coverage/coverage.json",
		"coverage:report": "if [ -f coverage/coverage-summary.json ]; then cat coverage/coverage-summary.json; else echo 'coverage-summary.json not found, generating from coverage-final.json' && cat coverage/coverage-final.json; fi",
		"test:e2e:report": "playwright show-report",
		"test:unit": "vitest run",
		"test:integration": "vitest run \"src/**/*.integration.test.{ts,tsx}\"",
		"playwright:install": "playwright install --with-deps",
		"test:workflow": "act -P ubuntu-latest=node:22-bullseye --container-architecture linux/amd64",
		"test:workflow:release": "act push -W .github/workflows/release.yml --container-architecture linux/amd64",
		"test:workflow:test": "act pull_request -W .github/workflows/test.yml --container-architecture linux/amd64",
		"test:release": "semantic-release --dry-run",
		"test:release:debug": "semantic-release --dry-run --debug",
		"test:commit": "commitlint --from HEAD~1 --to HEAD",
		"test:commit:msg": "echo \"feat: test message\" | commitlint",
		"test:coverage:local": "vitest run --coverage --coverage-threshold=0.5",
		"test:onlyfailures": "vitest run --changed",
		"static-analysis": "npx fta-cli src",
		"knip": "npx knip --config knip.jsonc",
		"knip:production": "npx knip --production --config knip.jsonc",
		"commit:test": "scripts/test-commit.sh",
		"vitest": "vitest run",
		"vitest:watch": "vitest",
		"vitest:ui": "vitest --ui",
		"vitest:coverage": "vitest run --coverage",
		"vitest:unit": "vitest run \"src/**/__tests__/**/*.test.{ts,tsx}\" \"src/**/*.test.{ts,tsx}\"",
		"vitest:integration": "vitest run \"src/**/*.integration.test.{ts,tsx}\""
	},
	"bin": {
		"act": "./node_modules/.bin/act",
		"fta-cli": "./node_modules/.bin/fta-cli",
		"knip": "./node_modules/.bin/knip"
	},
	"dependencies": {
		"@isomorphic-git/lightning-fs": "^4.6.0",
		"@monaco-editor/react": "^4.7.0",
		"@orama/orama": "^3.1.3",
		"@radix-ui/react-accordion": "^1.2.3",
		"@radix-ui/react-checkbox": "^1.1.4",
		"@radix-ui/react-dialog": "^1.1.6",
		"@radix-ui/react-label": "^2.1.2",
		"@radix-ui/react-popover": "^1.1.6",
		"@radix-ui/react-scroll-area": "^1.2.3",
		"@radix-ui/react-select": "^2.1.6",
		"@radix-ui/react-slot": "^1.1.2",
		"@radix-ui/react-switch": "^1.1.3",
		"@radix-ui/react-tabs": "^1.1.3",
		"@radix-ui/react-toast": "^1.2.6",
		"@radix-ui/react-tooltip": "^1.1.8",
		"@types/dompurify": "^3.0.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dompurify": "^3.2.4",
		"file-saver": "^2.0.5",
		"gpt-tokenizer": "^2.9.0",
		"isomorphic-git": "^1.30.1",
		"lodash": "^4.17.21",
		"lucide-react": "^0.483.0",
		"minimatch": "^10.0.1",
		"monaco-editor": "^0.52.2",
		"playwright": "^1.50.1",
		"react": "^19",
		"react-dom": "^19",
		"tailwind-merge": "^3.0.2",
		"zustand": "^5.0.3"
	},
	"devDependencies": {
		"@babel/core": "^7.26.10",
		"@biomejs/biome": "1.9.4",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@commitlint/types": "^19.8.0",
		"@playwright/test": "^1.51.1",
		"@semantic-release/git": "^10.0.1",
		"@tailwindcss/postcss": "^4.0.15",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.2.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/file-saver": "^2.0.7",
		"@types/lodash": "^4.17.16",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/testing-library__jest-dom": "^5.14.9",
		"@vitejs/plugin-react": "^4.3.4",
		"@vitest/coverage-v8": "^3.0.9",
		"@vitest/ui": "^3.0.9",
		"autoprefixer": "^10.4.21",
		"cursor-tools": "latest",
		"glob": "^11.0.1",
		"happy-dom": "^17.4.4",
		"husky": "^9.1.7",
		"identity-obj-proxy": "^3.0.0",
		"jsdom": "^26.0.0",
		"knip": "^5.46.0",
		"postcss": "^8",
		"postcss-import": "^16.1.0",
		"postcss-load-config": "^6.0.1",
		"react-router-dom": "^7.4.1",
		"semantic-release": "^24.2.3",
		"serve": "^14.2.4",
		"tailwindcss": "^4.0.15",
		"terser": "^5.39.0",
		"ts-node": "^10.9.2",
		"typescript": "^5",
		"vite": "^6.2.3",
		"vite-plugin-node-polyfills": "^0.23.0",
		"vitest": "^3.0.9"
	},
	"release": {
		"extends": "./release.config.js"
	},
	"c8": {
		"reporter": ["html", "text", "json"],
		"all": true,
		"include": ["src/**/*.{js,jsx,ts,tsx}"],
		"exclude": [
			"src/**/*.d.ts",
			"src/**/*.stories.{js,jsx,ts,tsx}",
			"src/**/*.test.{js,jsx,ts,tsx}",
			"src/mocks/**/*",
			"src/e2e/**/*",
			"**/node_modules/**",
			"**/.next/**"
		],
		"report-dir": "./coverage",
		"clean": true,
		"skip-full": true,
		"check-coverage": true,
		"branches": 0.5,
		"functions": 0.5,
		"lines": 0.5,
		"statements": 0.5
	}
}
