{
  // Turborepo monorepo configuration for brainstrike
  "$schema": "https://v2-11-2.turborepo.dev/schema.json",
  // Opt into Turborepo 3.0's global-configuration shape while 2.x can still
  // validate the migration. Deleting this flag without moving the fields back
  // is a hard configuration error, never a silent fallback.
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "globalConfiguration": true
  },
  "global": {
    // Default for uncapped invocations (CI Build, local build/type-check); capped lanes pass their own.
    "concurrency": "40",
    // Turbo's cache key has no OS, architecture or Node version; these add them.
    "env": ["RUNNER_OS", "RUNNER_ARCH", "npm_config_user_agent"],
    // Only files every task reads. Lockfile closures and task definitions are hashed per task.
    // Rationale: README.md "Build and test configuration".
    "inputs": [
      ".github/actions/**", // Composite setup: toolchain, install, native build inputs
      ".github/workflows/**", // Runner images, installed test tools, task env
      "pnpm-workspace.yaml", // allowBuilds, overrides and install settings
      "package.json", // Root devEngines pins the Node version (native ABI)
      "packages/*/tsconfig/*.json", // Shared tsconfig preset, extended by raw path: its only hash carrier
      ".nvmrc" // Node version specification
    ]
  },
  "tasks": {
    // Transit node: no package defines `topo`. Tasks that read dependency source depend on it,
    // so an upstream edit re-hashes dependents without building anything. Never drop the edge.
    "topo": {
      "dependsOn": [
        "^topo"
      ]
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "outputLogs": "new-only"
    },
    // Tests import workspace source. A suite that needs a native add-on declares that `build`
    // edge in its package's turbo.json.
    "test": {
      "dependsOn": [
        "topo"
      ],
      "env": [
        "CI",
        "NODE_ENV",
        "TEST_TIMEOUT_MULTIPLIER",
        "TURBO_TEST_MODE"
      ],
      // Read at run time but kept out of the hash, so PR (unset) and push ("false") runs share entries.
      // NIGHTLY_TEST_RESULTS_DIR only adds a JSON report (test-utils vitest.base), so it stays out too.
      "passThroughEnv": [
        "COVERAGE",
        "NIGHTLY_TEST_RESULTS_DIR",
        "VITEST_MAX_WORKERS"
      ],
      // Written only by coverage.yml, whose `-- --coverage.enabled` argument hashes its runs apart.
      "outputs": [
        "coverage/**"
      ],
      "outputLogs": "new-only"
    },
    "test:integration": {
      "dependsOn": [
        "topo"
      ],
      // BRAINSTRIKE_FENCE_DEPS_REQUIRED turns a missing fence dependency into a failure
      // (packages/agent/src/__tests__/fixtures/fence-host-gate.ts); hashed so it never replays a skip.
      "env": [
        "BRAINSTRIKE_FENCE_DEPS_REQUIRED",
        "CI",
        "NODE_ENV",
        "TEST_TIMEOUT_MULTIPLIER",
        "TURBO_TEST_MODE"
      ],
      "passThroughEnv": [
        "COVERAGE",
        "NIGHTLY_TEST_RESULTS_DIR",
        "VITEST_MAX_WORKERS"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "type-check": {
      "dependsOn": [
        "topo"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test:browser": {
      "dependsOn": [
        "topo"
      ],
      "env": [
        "CI",
        "PLAYWRIGHT_BROWSERS_PATH",
        "TEST_TIMEOUT_MULTIPLIER"
      ],
      "outputs": [
        "__tests__/__screenshots__/**"
      ],
      "outputLogs": "full"
    },
    // The smoke lane `pnpm check` runs. Desktop's build hash carries every workspace dependency.
    "test:e2e:lane:smoke": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "BRAINSTRIKE_DESKTOP_DEV_SERVER_URL",
        "BRAINSTRIKE_E2E_*",
        "BRAINSTRIKE_OPENROUTER_API_KEY",
        "BRAINSTRIKE_PROVIDER_CASSETTE_RECORD",
        "CI",
        "OPENROUTER_BASE_URL"
      ],
      // Platform plumbing Electron needs to start; it does not change results.
      "passThroughEnv": [
        "CODEX_ENV",
        "DISPLAY",
        "ELECTRON_ENABLE_STACK_DUMPING",
        "GITHUB_ACTIONS",
        "GITHUB_RUN_ID",
        "GITHUB_RUN_NUMBER",
        "NODE_DEBUG",
        "NODE_OPTIONS",
        "RUNNER_NAME",
        "RUN_SALT",
        "TMPDIR",
        "WAYLAND_DISPLAY",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_SESSION_TYPE",
        "pnpm_config_ci"
      ],
      "outputs": [
        "test-results/**",
        "playwright-report/**",
        "blob-report/**"
      ],
      "outputLogs": "full"
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "BRAINSTRIKE_DESKTOP_DEV_SERVER_URL",
        "BRAINSTRIKE_E2E_*",
        "BRAINSTRIKE_OPENROUTER_API_KEY",
        "BRAINSTRIKE_PROVIDER_CASSETTE_RECORD",
        "CI",
        "OPENROUTER_BASE_URL"
      ],
      // Platform plumbing Electron needs to start; it does not change results.
      "passThroughEnv": [
        "CODEX_ENV",
        "DISPLAY",
        "ELECTRON_ENABLE_STACK_DUMPING",
        "GITHUB_ACTIONS",
        "GITHUB_RUN_ID",
        "GITHUB_RUN_NUMBER",
        "NODE_DEBUG",
        "NODE_OPTIONS",
        "RUNNER_NAME",
        "RUN_SALT",
        "TMPDIR",
        "WAYLAND_DISPLAY",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_SESSION_TYPE",
        "pnpm_config_ci"
      ],
      "outputs": [
        "test-results/**",
        "playwright-report/**",
        "blob-report/**"
      ],
      "outputLogs": "full"
    }
  }
}
