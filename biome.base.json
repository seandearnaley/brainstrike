        "packages/file-explorer-hooks/src/__tests__/use-file-system.test.tsx",
        "packages/file-explorer-ui/src/__tests__/file-explorer-panel.test.tsx",
        "packages/file-explorer-ui/src/__tests__/file-explorer-sidebar.test.tsx",
