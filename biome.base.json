        "packages/agent/src/mastra/agent-streaming.ts",
        "packages/assistant-data/src/__tests__/assistant-memory-repository.integration.test.ts",
        "packages/app-shell/src/__tests__/assistant-ui-panel-wrapper-runtime.test.ts",
        "packages/app-shell/src/__tests__/assistant-ui-panel-wrapper-test-support.tsx",
        "packages/app-shell/src/__tests__/assistant-ui-panel-wrapper.test.tsx",
        "packages/app-shell/src/__tests__/renderer-long-task-telemetry.test.ts",
        "packages/app-shell/src/__tests__/threads-panel.test.tsx",
        "packages/assistant-data/src/assistant-memory-repository.ts",
        "packages/app-shell/src/assistant-ui-panel-wrapper-runtime.ts",
        "packages/app-shell/src/assistant-ui-panel-wrapper.tsx",
