{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**/src/**/*.{ts,tsx,js,jsx}",
      "packages/**/src/**/*.{ts,tsx,js,jsx}",
      "**/*.config.{ts,mts}",
      "**/*.test.{ts,tsx}",
      "packages/{effect-kit,assistant-contract,agent-host}/**/*.{ts,tsx,mts,mjs}",
      "packages/agent/src/__tests__/**/*.{ts,tsx,mts,mjs}",
      "packages/token-cache/src/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/{worker-runtime,file-tree-worker}/src/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/test-utils/{src,__tests__}/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/pipeline/{src,__tests__}/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/web-state-store/src/__tests__/**/*-worker.{ts,mts,cts,mjs}",
      "packages/web-writer/src/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/assistant-service/src/__tests__/node-workspace-services*/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/host-lease/{src,__tests__}/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/host-capabilities/src/mcp/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/host-capabilities/{src/provider-auth,__tests__/credentials}/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/indexer/{src,__tests__}/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/host-capabilities/src/native-tools/**/*.{ts,tsx,mts,cts,mjs}",
      "packages/host-capabilities/__tests__/file-approval-target.test.ts",
      "apps/desktop/src/__tests__/assistant-server/**/*.{ts,tsx,mts,cts,mjs}",
      "**/e2e/**/*.{ts,tsx}",
      "!!spikes/m0-a1-qualification/original",
      "!!.muse/worktrees",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/build",
      "!apps/desktop/release",
      "!apps/desktop/resources/python-runtime",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.vite",
      "!**/.nyc_output",
      "!**/blob-report",
      "!**/.stryker-tmp",
      "!**/reports",
      "!**/*.db",
      "!**/*.json",
      "!**/*.jsonc",
      "packages/assistant-contract/src/provider-catalog.json",
      "!**/*.css",
      "!**/*.md",
      "!**/*.html",
      "!.claude",
      "!.pnpm-store",
      "!**/*.bundled_*.mjs"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 1000
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "filenameCases": ["kebab-case"]
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false
          }
        },
        "noNestedTernary": "off",
        "noParameterProperties": "off",
        "noExportedImports": "off",
        "useConsistentMemberAccessibility": "off",
        "useDefaultSwitchClause": "off",
        "noIncrementDecrement": "off",
        "useConsistentMethodSignatures": "off",
        "useDestructuring": "off",
        "useErrorCause": "off",
        "useForOf": "off",
        "useConsistentEnumValueType": "off",
        "useDomQuerySelector": "off",
        "useNamedCaptureGroup": "off",
        "useThisInClassMethods": "off"
      },
      "suspicious": {
        "noConsole": "error",
        "noEmptyBlockStatements": "off",
        "useAwait": "off",
        "noBitwiseOperators": "off",
        "noEvolvingTypes": "off",
        "noLeakedRender": "off",
        "noNestedPromises": "off",
        "noReturnAssign": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "useArraySortCompare": "off",
        "noLoopFunc": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noForEach": "off",
        "noVoid": "off",
        "noRedundantDefaultExport": "off",
        "noStaticOnlyClass": "off",
        "noUselessReturn": "off",
        "useArrayFind": "off"
      },
      "correctness": {
        "noUnusedInstantiation": "off",
        "noUndeclaredDependencies": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noBarrelFile": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    },
    "globals": [
      "React",
      "describe",
      "it",
      "test",
      "expect",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "vi",
      "jest",
      "Electron",
      "__BRAINSTRIKE_BUILD_ID__"
    ]
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**", "**/*.test.*", "**/*.stories.*"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "filenameCases": ["kebab-case"]
              }
            },
            "useNamingConvention": "off",
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noNonNullAssertedOptionalChain": "off",
            "noExplicitAny": "off",
            "noConsole": "off",
            "noMisplacedAssertion": "off"
          },
          "correctness": {
            "noUnusedVariables": "error",
            "useUniqueElementIds": "off",
            "useParseIntRadix": "error",
            "noComponentHookFactories": "off"
          },
          "complexity": {
            "useLiteralKeys": "off",
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "filenameCases": ["kebab-case"]
              }
            }
          },
          "correctness": {
            "noUnusedVariables": "error",
            "noEmptyPattern": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off",
            "noSkippedTests": "off"
          },
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "**/global.d.ts", "**/env.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off",
            "useNodejsImportProtocol": "off",
            "noNamespace": "off"
          },
          "correctness": {
            "noUnusedVariables": "warn"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/host-capabilities/src/hooks/**",
        "packages/host-capabilities/__tests__/hooks/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/**",
        "packages/ui/**",
        "packages/assistant-data/**",
        "packages/assistant-ui/**",
        "packages/file-explorer-ui/**",
        "packages/file-explorer-hooks/**",
        "packages/app-shell/**",
        "packages/app-state/**",
        "packages/settings-ui/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off",
            "useUniqueElementIds": "off",
            "noNestedComponentDefinitions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/constants/**",
        "**/use-toast.ts",
        "**/logger.ts",
        "**/setup-security.ts",
        "**/vitest.setup.ts",
        "**/use-tab-manager.ts",
        "**/migration-runner.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          },
          "suspicious": {
            "noConsole": "off"
          },
          "correctness": {
            "useHookAtTopLevel": "off"
          },
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/**",
        "packages/assistant-ui/src/**",
        "packages/file-explorer-ui/src/loading-overlay.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noParameterAssign": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/e2e/performance/**",
        "**/e2e/**/performance-*",
        "**/e2e/report-folder-summary.test.ts",
        "**/e2e/layout-persistence.test.ts",
        "**/e2e/utils/performance-config.ts",
        "**/e2e/real-world-performance.test.ts",
        "**/e2e/utils/layout-helpers.ts",
        "**/e2e/**/layout-helpers.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noAssignInExpressions": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/types/**"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/db/**",
        "packages/token-cache/**",
        "packages/assistant-contract/src/mcp-task-row-schema.ts",
        "**/ipc-handlers.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/vitest.setup.ts", "**/vitest.setup.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useReactFunctionComponents": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "scripts/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/e2e/file-explorer-selection-restore.desktop.test.ts",
        "apps/desktop/e2e/file-explorer-selection.shared.ts",
        "apps/desktop/e2e/utils/electron-helpers.mts",
        "apps/desktop/src/__tests__/assistant-server/assistant-tools-read.integration.test.ts",
        "apps/desktop/src/__tests__/assistant-server/git-service.integration.test.ts",
        "apps/desktop/src/__tests__/llm-host-manager.test.ts",
        "apps/desktop/src/__tests__/main/ipc-handlers-db.test.ts",
        "apps/desktop/src/__tests__/main/mcp-loader-comprehensive.test.ts",
        "apps/desktop/src/__tests__/renderer-host-lifecycle.test.ts",
        "apps/desktop/src/main.ts",
        "apps/desktop/src/preload.ts",
        "apps/web/e2e/file-explorer.test.ts",
        "apps/web/src/__tests__/assistant-stream-helpers.test.ts",
        "apps/web/src/app/api/assistant/__tests__/route.test.ts",
        "packages/agent/src/__tests__/agent-runtime.spec.ts",
        "packages/agent/src/__tests__/fence-escape-resistance.integration.spec.ts",
        "packages/agent/src/__tests__/mastra-memory-persistence.integration.spec.ts",
        "packages/agent/src/__tests__/mastra-streaming.spec.ts",
        "packages/agent/src/__tests__/mastra-tool-approval-chunks.spec.ts",
        "packages/agent/src/__tests__/mastra-tool-approval-suspend.integration.spec.ts",
        "packages/agent/src/__tests__/mastra-tool-execution.integration.spec.ts",
        "packages/agent/src/__tests__/mastra-tool-suspend-resume.integration.spec.ts",
        "packages/agent/src/__tests__/mcp-tool-loader.spec.ts",
