    },
    {
      "includes": [
        "packages/effect-kit/**",
        "packages/assistant-contract/src/native-tools/schemas/**",
        "packages/agent/src/tools/**",
        "packages/agent-host/src/**"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "usePromiseRejectErrors": "error"
          }
        }
      }
