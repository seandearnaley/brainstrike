        "packages/file-explorer-ui/src/__tests__/use-file-explorer-context.test.ts",
        "packages/file-explorer-ui/src/__tests__/use-file-system-context.test.ts",
        "packages/file-explorer-ui/src/__tests__/use-file-tree-context.test.ts",
        "packages/file-explorer-ui/src/__tests__/use-shared-file-content-loading.test.tsx",
        "packages/file-explorer-ui/src/indexing/use-background-token-indexer-integration.ts",
        "packages/file-explorer-ui/src/shell/file-explorer-panel.tsx",
        "packages/file-explorer-ui/src/tapestry/__tests__/minimap.test.tsx",
