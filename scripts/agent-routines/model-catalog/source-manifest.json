      },
      "catalogCompleteness": "presence-only",
      "maxObservationAgeHours": 36,
      "enabled": true,
      "required": false,
      "safeAddition": { "eligible": false }
    },
    {
      "id": "openai-models-api",
      "adapter": "openai",
      "providerId": "openai",
