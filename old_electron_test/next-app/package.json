{
  "name": "brainstrike-web",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve-static": "npx serve out",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "prepare": "husky",
    "test:e2e:ui": "playwright test --ui",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "type-check": "tsc --noEmit",
    "lint-type-check": "npm run lint:fix && npm run type-check",
    "rename-to-kebab": "node scripts/migrate-filenames.js",
    "lint-all": "npm run lint:fix && npm run type-check",
    "test:e2e:coverage": "playwright test --reporter=html --reporter=json",
    "coverage:merge": "cp coverage/coverage-final.json coverage/coverage.json",
    "coverage:report": "cat coverage/coverage-summary.json",
    "test:e2e:report": "playwright show-report",
    "test:unit": "NODE_NO_WARNINGS=1 jest \".*\\.test\\.[jt]sx?$\" --passWithNoTests",
    "test:integration": "jest \".*\\.integration\\.test\\.[jt]sx?$\" --passWithNoTests",
    "playwright:install": "playwright install --with-deps",
    "test:workflow": "act -P ubuntu-latest=node:20-bullseye --container-architecture linux/amd64",
    "test:workflow:release": "act push -W .github/workflows/release.yml --container-architecture linux/amd64",
    "test:workflow:test": "act pull_request -W .github/workflows/test.yml --container-architecture linux/amd64",
    "test:release": "semantic-release --dry-run",
    "test:release:debug": "semantic-release --dry-run --debug",
    "test:commit": "commitlint --from HEAD~1 --to HEAD",
    "test:commit:msg": "echo \"feat: test message\" | commitlint",
    "test:coverage:local": "jest --coverage --passWithNoTests --coverageThreshold=\"{}\"",
    "test:onlyfailures": "npx jest --onlyFailures --passWithNoTests",
    "static-analysis": "npx fta-cli src",
    "knip": "npx knip --config knip.jsonc",
    "knip:production": "npx knip --production --config knip.jsonc",
    "commit:test": "scripts/test-commit.sh"
  },
  "bin": {
    "act": "./node_modules/.bin/act",
    "fta-cli": "./node_modules/.bin/fta-cli",
    "knip": "./node_modules/.bin/knip"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "^4.6.0",
    "@orama/orama": "^3.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "gpt-tokenizer": "^2.9.0",
    "isomorphic-git": "^1.30.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.483.0",
    "minimatch": "^10.0.1",
    "next": "15.2.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "@playwright/test": "^1.51.1",
    "@semantic-release/git": "^10.0.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "knip": "^5.46.0",
    "postcss": "^8",
    "postcss-import": "^16.1.0",
    "postcss-load-config": "^6.0.1",
    "semantic-release": "^24.2.3",
    "serve": "^14.2.4",
    "tailwindcss": "^4.0.15",
    "typescript": "^5"
  },
  "release": {
    "extends": "./release.config.js"
  },
  "c8": {
    "reporter": [
      "html",
      "text",
      "json"
    ],
    "all": true,
    "include": [
      "src/**/*.{js,jsx,ts,tsx}"
    ],
    "exclude": [
      "src/**/*.d.ts",
      "src/**/*.stories.{js,jsx,ts,tsx}",
      "src/**/*.test.{js,jsx,ts,tsx}",
      "src/mocks/**/*",
      "src/e2e/**/*",
      "**/node_modules/**",
      "**/.next/**"
    ],
    "report-dir": "./coverage",
    "clean": true,
    "skip-full": true,
    "check-coverage": true,
    "branches": 0.5,
    "functions": 0.5,
    "lines": 0.5,
    "statements": 0.5
  },
  "packageManager": "pnpm@10.6.5"
}
