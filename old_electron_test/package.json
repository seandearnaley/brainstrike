{
  "name": "brainstrike",
  "version": "1.0.0",
  "description": "Brainstrike Desktop App",
  "main": "main/main.js",
  "scripts": {
    "dev": "npm run build:next && electron .",
    "start": "npm run build:next && electron .",
    "build:next": "cd next-app && npm run build",
    "build": "npm run build:next && electron-builder",
    "dev:next": "cd next-app && npm run dev",
    "test": "cd next-app && npm run test",
    "lint": "cd next-app && npm run lint",
    "rebuild": "npm run build:next && npm start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^35.0.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.brainstrike",
    "productName": "Brainstrike",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "next-app/out/**/*",
      "package.json"
    ],
    "extraResources": [
      "next-app/out/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "packageManager": "pnpm@9.15.3+sha512.1f79bc245a66eb0b07c5d4d83131240774642caaa86ef7d0434ab47c0d16f66b04e21e0c086eb61e62c77efc4d7f7ec071afad3796af64892fae66509173893a"
}
