diff --git a/dist/agent-BOdDHE12.cjs b/dist/agent-BOdDHE12.cjs
index 6c7efc0e0771d2ef0200d6e786480a82c4e78412..0b454ce0e55dcbf532dd18ec279f904d3e492ebd 100644
--- a/dist/agent-BOdDHE12.cjs
+++ b/dist/agent-BOdDHE12.cjs
@@ -15094,6 +15094,14 @@ var ToolSearchProcessor = class {
 	* @returns Array of matching tools with scores, sorted by relevance
 	*/
 	async searchTools(catalog, query, requestContext) {
+		// BST-1628: an exact registered ID is selection, not fuzzy retrieval.
+		// Keep the SDK's filter and context-backed activation as the authority.
+		const exactTool = this.findToolById(catalog, query);
+		if (exactTool) {
+			if (!await this.isToolAllowed(exactTool, requestContext, "search")) return [];
+			const description = catalog.descriptions.get(query) || "";
+			return [{ name: query, description: description.length > 150 ? description.slice(0, 147) + "..." : description, score: 1 }];
+		}
 		if (catalog.index.size === 0) return [];
 		const searchLimit = this.filter ? catalog.index.size : this.searchConfig.topK * 2;
 		const bm25Results = catalog.index.search(query, searchLimit, 0);
