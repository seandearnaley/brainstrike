## Test Organization & Helpers

### Page Object Pattern

```ts
// e2e/utils/file-explorer-page.ts
import { expect, type Page } from '@playwright/test';

export class FileExplorerPage {
  constructor(private page: Page) {}

  async navigateToSettings() {
    await this.page.getByRole('button', { name: /^Settings$/ }).click();
    await expect(this.page.getByRole('heading', { name: 'Settings' })).toBeVisible();
  }

  async applyFileFilter(name: 'Images' | 'Documents' | 'Code' | 'Archives') {
    await this.page.getByRole('button', { name }).click();
    await expect(this.page.getByRole('button', { name })).toHaveAttribute('data-state', 'on');
  }

  async setTheme(theme: 'Light' | 'Dark' | 'System') {
    await this.navigateToSettings();
    await this.page.getByRole('button', { name: theme }).click();
    await expect(this.page.locator('html'))[theme === 'Dark' ? 'toHaveClass' : 'not'].call(
      expect(this.page.locator('html')),
      /dark/
    );
  }
}
```

### Test Helpers

```ts
// e2e/utils/helpers.ts
import { expect, type Page } from '@playwright/test';

export async function waitForAppLoad(page: Page) {
  await expect(
  page.getByRole('button', { name: 'Context Explorer', exact: true })
    .and(page.locator('[aria-current="page"]'))
).toBeVisible();
  await expect(page.getByRole('button', { name: 'Select Root' })).toBeVisible({ timeout: 10_000 });
}

export async function setKnownThemeState(page: Page, theme: 'Light' | 'Dark' = 'Light') {
  await page.getByRole('button', { name: 'Settings' }).click();
  await page.getByRole('button', { name: theme }).click();
  await page.getByRole('button', { name: 'Context Explorer' }).click();
}

export async function verifyFileCounter(page: Page, selected: number, total = 10) {
  await expect(page.getByText(`${selected}/${total} selected`)).toBeVisible();
}
```

