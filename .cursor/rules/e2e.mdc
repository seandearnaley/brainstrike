## Playwright Configuration Example (Web)

```ts
// apps/web/playwright.config.ts
import { defineConfig, devices } from '@playwright/test';

export default defineConfig({
  testDir: './e2e',
  fullyParallel: true,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 2 : 0,
  // Keep a single worker on CI if your app/server is stateful
  workers: process.env.CI ? 1 : undefined,
  reporter: [['list'], ['html', { open: 'never' }]],
  use: {
    baseURL: process.env.PLAYWRIGHT_BASE_URL ?? 'http://localhost:3000',
    trace: 'on-first-retry',
    // Keep artifacts lean but useful:
    screenshot: 'only-on-failure',
    video: 'retain-on-failure',
    // Optional: make `getByTestId` align to your attribute:
    // testIdAttribute: 'data-testid',
  },
  projects: [
    { name: 'chromium', use: { ...devices['Desktop Chrome'] } },
  ],
  webServer: {
    // Prefer a production-like server for E2E when possible
    command: process.env.E2E_DEV ? 'pnpm dev' : 'pnpm start',
    url: 'http://localhost:3000',
    reuseExistingServer: !process.env.CI,
  },
});
```

> Use `npx playwright show-report` to view the HTML report. For interactive debugging, run **UI Mode**: `pnpm exec playwright test --ui`.

