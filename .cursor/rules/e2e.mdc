## Standard Test Patterns

### Test Setup

```ts
import { test, expect } from '@playwright/test';

test.describe('File Explorer Feature', () => {
  test.beforeEach(async ({ page }) => {
    await page.goto('/');

    // Wait for app to load - use actual elements from your app
    await expect(
  page.getByRole('button', { name: 'Context Explorer', exact: true })
    .and(page.locator('[aria-current="page"]'))
).toBeVisible();
    await expect(page.getByRole('button', { name: 'Select Root' })).toBeVisible({ timeout: 10_000 });
  });

  test('should perform file explorer action', async ({ page }) => {
    // Test implementation
  });
});
```

> Why: assertions auto-wait and are less flaky than fixed timeouts.

### Navigation Patterns

```ts
// ✅ Navigate between main app sections
await page.getByRole('button', { name: 'Context Explorer' }).click();
await page.getByRole('button', { name: 'Settings' }).click();

// ✅ File explorer specific elements
await page.getByRole('button', { name: 'Select Root' }).click();
await expect(page.getByText('0/10 selected')).toBeVisible(); // File counter pattern
await page.getByRole('button', { name: 'Download Report' }).click();
await page.getByRole('button', { name: 'Copy Report' }).click();

// ✅ Filter buttons
await page.getByRole('button', { name: 'Images' }).click();
await page.getByRole('button', { name: 'Documents' }).click();
await page.getByRole('button', { name: 'Code' }).click();
await page.getByRole('button', { name: 'Archives' }).click();
```

> Note: prefer `getByRole({ name })`; use regex `name: /^Settings$/` if you need exact name matching.

### File Explorer State Management

```ts
// ✅ File selection patterns
await page.getByRole('button', { name: 'Select Root' }).click();
await expect(page.getByText('0/10 selected')).toBeVisible();

// ✅ Filter state testing
await page.getByRole('button', { name: 'Images' }).click();
await expect(page.getByRole('button', { name: 'Images' })).toHaveAttribute('data-state', 'on');

// ✅ Zustand store state persistence across navigation
await page.getByRole('button', { name: 'Settings' }).click();
await page.getByRole('button', { name: 'Context Explorer' }).click();
await expect(page.getByText('0/10 selected')).toBeVisible(); // State persisted
```

### Timing Patterns (No fixed sleeps)

```ts
// ✅ Theme changes: assert DOM state instead of sleeping
await page.getByRole('button', { name: 'Dark' }).click();
await expect(page.locator('html')).toHaveClass(/dark/);

// ✅ File tree loading
await page.getByRole('button', { name: 'Select Root' }).click();
await expect(page.getByRole('button', { name: 'Select Root' })).toBeVisible({ timeout: 10_000 });

// ✅ Navigation state updates
await page.getByRole('button', { name: 'Settings' }).click();
await expect(page.getByRole('heading', { name: 'Settings' })).toBeVisible();
```

> Use web-first assertions; avoid `waitForTimeout`.

