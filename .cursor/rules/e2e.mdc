## Playwright Configuration Example (Desktop/Electron)

```ts
// apps/desktop/e2e/electron.spec.ts
import { test, expect, _electron as electron } from '@playwright/test';

test('launches desktop app', async () => {
  const app = await electron.launch({ args: ['.'] });
  const win = await app.firstWindow();
  await expect(win).toBeDefined();

  // Interact with the renderer window like a normal Page:
  await expect(
    win.getByRole('button', { name: 'Context Explorer', exact: true })
      .and(win.locator('[aria-current="page"]'))
  ).toBeVisible();

  await app.close();
});
```

> Electron support uses `_electron` and `ElectronApplication.firstWindow()` to control windows.

