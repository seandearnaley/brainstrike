### 8. Zustand Store Integration Testing
```typescript
// ✅ Test that Zustand store state persists across navigation
test('file explorer state persists across navigation', async ({ page }) => {
  // Set some state in file explorer
  await page.getByRole('button', { name: 'Images' }).click();
  
  // Navigate away
  await page.getByRole('button', { name: 'Settings' }).click();
  await expect(page.getByRole('heading', { name: 'Settings' })).toBeVisible();
  
  // Navigate back
  await page.getByRole('button', { name: 'Context Explorer' }).click();
  
  // Verify state persisted
  await expect(page.getByRole('button', { name: 'Images' })).toHaveAttribute('data-state', 'on');
});
```

## Brainstrike-Specific Anti-Patterns

### 1. Theme Testing Mistakes
```typescript
// ❌ Don't assume initial theme state
await expect(page.locator('html')).not.toHaveClass(/dark/); // May fail if system is dark

// ✅ Set explicit theme state first
await page.getByRole('button', { name: 'Settings' }).click();
await page.getByRole('button', { name: 'Light' }).click();
await page.waitForTimeout(100);
```

### 2. Navigation Assumptions
```typescript
// ❌ Don't assume page stays after reload
await page.reload();
await expect(page.getByRole('heading', { name: 'Settings' })).toBeVisible(); // Fails

// ✅ Know that reload goes to Context Explorer
await page.reload();
await expect(page.getByRole('heading', { name: 'Context Explorer' })).toBeVisible();
```

### 3. Text Selector Issues
```typescript
// ❌ Ambiguous text selectors (learned from theme test failures)
await page.getByText('Theme'); // Matches multiple elements

// ✅ Use exact match
await page.getByText('Theme', { exact: true });
```

## Brainstrike Test Organization

### 1. File Explorer Page Object (If Needed)
```typescript
// e2e/utils/file-explorer-page.ts
export class FileExplorerPage {
  constructor(private page: Page) {}
  
  async navigateToSettings() {
    await this.page.getByRole('button', { name: 'Settings', exact: true }).click();
    await expect(this.page.getByRole('heading', { name: 'Settings', exact: true })).toBeVisible();
  }
  
  async applyFileFilter(filterName: 'Images' | 'Documents' | 'Code' | 'Archives') {
    await this.page.getByRole('button', { name: filterName }).click();
    await expect(this.page.getByRole('button', { name: filterName })).toHaveAttribute('data-state', 'on');
  }
  
  async setTheme(theme: 'Light' | 'Dark' | 'System') {
    await this.navigateToSettings();
    await this.page.getByRole('button', { name: theme }).click();
    await this.page.waitForTimeout(100); // Theme needs time to apply
  }
}
```

### 2. Brainstrike Test Helpers
```typescript
// e2e/utils/brainstrike-helpers.ts
export async function waitForBrainstrikeAppLoad(page: Page) {
  await expect(page.getByRole('heading', { name: 'Context Explorer', exact: true })).toBeVisible();
  await expect(page.getByRole('button', { name: 'Select Root' })).toBeVisible({ timeout: 10000 });
}

export async function setKnownThemeState(page: Page, theme: 'Light' | 'Dark' = 'Light') {
  await page.getByRole('button', { name: 'Settings', exact: true }).click();
  await page.getByRole('button', { name: theme }).click();
  await page.waitForTimeout(100);
  await page.getByRole('button', { name: 'Context Explorer', exact: true }).click();
}

export async function verifyFileCounter(page: Page, selected: number, total: number = 10) {
  await expect(page.getByText(`${selected}/${total} selected`)).toBeVisible();
}
```

