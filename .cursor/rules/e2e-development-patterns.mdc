### 3. Theme System Testing (Brainstrike-Specific)
```typescript
// ✅ Theme controls in Settings page
await page.getByRole('button', { name: 'Settings', exact: true }).click();
await expect(page.getByText('Theme', { exact: true })).toBeVisible();
await page.getByRole('button', { name: 'Light' }).click();
await page.getByRole('button', { name: 'Dark' }).click();
await page.getByRole('button', { name: 'System' }).click();

// ✅ Theme toggle in navigation
const themeToggle = page.getByRole('button', { name: 'Toggle theme' });
await themeToggle.click();

// ✅ Verify theme applied to html element (brainstrike pattern)
const htmlElement = page.locator('html');
await expect(htmlElement).toHaveClass(/dark/);
await expect(htmlElement).not.toHaveClass(/dark/);
```

### 4. File Explorer State Management
```typescript
// ✅ File selection patterns
await page.getByRole('button', { name: 'Select Root' }).click();
// Wait for file tree to load
await expect(page.getByText('0/10 selected')).toBeVisible();

// ✅ Filter state testing
await page.getByRole('button', { name: 'Images' }).click();
// Verify filter is applied (button state changes)
await expect(page.getByRole('button', { name: 'Images' })).toHaveAttribute('data-state', 'on');

// ✅ File explorer store state (via Zustand)
// Test that selections persist across navigation
await page.getByRole('button', { name: 'Settings' }).click();
await page.getByRole('button', { name: 'Context Explorer' }).click();
await expect(page.getByText('0/10 selected')).toBeVisible(); // State persisted
```

### 5. Brainstrike-Specific Timing Patterns
```typescript
// ✅ Theme changes need timing (discovered pattern)
await page.getByRole('button', { name: 'Dark' }).click();
await page.waitForTimeout(100); // Theme provider needs time to update DOM
await expect(page.locator('html')).toHaveClass(/dark/);

// ✅ File tree loading
await page.getByRole('button', { name: 'Select Root' }).click();
await expect(page.getByRole('button', { name: 'Select Root' })).toBeVisible({ timeout: 10000 });

// ✅ Navigation state updates
await page.getByRole('button', { name: 'Settings' }).click();
await expect(page.getByRole('heading', { name: 'Settings', exact: true })).toBeVisible();
```

### 6. Known Brainstrike Issues & Workarounds

#### Theme Toggle Limitation
```typescript
// ❌ Theme toggle has known limitation - doesn't handle system theme well
// When theme is 'system', toggle sets to 'light' instead of detecting current state
test('theme toggle workaround', async ({ page }) => {
  // Set explicit theme state first to avoid system theme issues
  await page.getByRole('button', { name: 'Settings', exact: true }).click();
  await page.getByRole('button', { name: 'Light' }).click();
  await page.waitForTimeout(100);
  
  // Now test toggle from known state
  const themeToggle = page.getByRole('button', { name: 'Toggle theme' });
  await themeToggle.click();
  await page.waitForTimeout(100);
  await expect(page.locator('html')).toHaveClass(/dark/);
});
```

#### Page Reload Navigation Behavior
```typescript
// ✅ After reload, app always goes to Context Explorer (not Settings)
test('reload behavior', async ({ page }) => {
  await page.getByRole('button', { name: 'Settings' }).click();
  await page.reload();
  
  // Don't expect to be on Settings - app goes to Context Explorer
  await expect(page.getByRole('heading', { name: 'Context Explorer', exact: true })).toBeVisible();
});
```

