# Ignore node_modules (but pnpm workspaces will still be available)
node_modules

# Ignore test files and coverage
*.test.tsx
*.test.ts
__tests__
test-results
e2e
playwright-report
coverage

# Ignore development configurations
vitest.config.ts
.eslintrc
.eslintignore
.npmrc
.nvmrc
.env
.env.local
.env.development

# Ignore documentation
docs

# Ignore build artifacts
dist
out
build

# Ignore logs and system files
*.log
.DS_Store
.git

# Ignore specific config files that aren't needed for build
README.md

# PRESERVE THESE FOR TAILWIND CSS:
# - Do NOT ignore packages/*/src directories (needed for @source directives)
# - Do NOT ignore apps/*/src directories (needed for @source directives)
# - Do NOT ignore *.config.mts, *.config.ts files (needed for Vite/Tailwind config)

# The following patterns are intentionally NOT included to preserve Tailwind functionality:
# packages/*/src/**
# apps/*/src/**
# *.config.mts
# *.config.ts
