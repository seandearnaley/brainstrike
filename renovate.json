{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchPackagePatterns": [
        "^@radix-ui/",
        "clsx",
        "class-variance-authority",
        "lucide-react",
        "react-resizable-panels",
        "tailwind-merge"
      ],
      "groupName": "UI Component Libraries"
    },
    {
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-router-dom",
        "react-helmet-async"
      ],
      "groupName": "React Core & Router"
    },
    {
      "matchPackageNames": ["monaco-editor", "@monaco-editor/react"],
      "groupName": "Monaco Editor"
    },
    {
      "matchPackagePatterns": [
        "^@testing-library/",
        "vitest",
        "^@vitest/",
        "jsdom",
        "happy-dom",
        "@playwright/",
        "playwright",
        "identity-obj-proxy"
      ],
      "groupName": "Testing & QA"
    },
    {
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react",
        "@codecov/vite-plugin",
        "tsup",
        "terser",
        "@babel/core",
        "@swc/core",
        "ts-node",
        "@biomejs/biome",
        "husky",
        "concurrently",
        "serve",
        "knip",
        "glob"
      ],
      "groupName": "Build & Dev Tools"
    },
    {
      "matchPackageNames": ["tailwindcss", "@tailwindcss/vite"],
      "groupName": "Tailwind CSS"
    },
    {
      "matchPackageNames": [
        "electron",
        "electron-builder",
        "electron-builder-squirrel-windows"
      ],
      "groupName": "Electron Platform"
    },
    {
      "matchPackageNames": [
        "electron-store",
        "dompurify",
        "minimatch",
        "file-saver",
        "react-hotkeys-hook"
      ],
      "groupName": "Utilities & Misc"
    }
  ],
  "schedule": ["before 4am on Monday"],
  "timezone": "America/New_York",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on Monday"]
  }
}
