{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // PRODUCTION MODE (BST-2071). `pnpm knip:production` runs `knip --production`
  // (https://knip.dev/features/production-mode): it grades only what the code we
  // ship reaches, so an export, file or dependency that only a test uses is
  // reported there while the default run still credits the test.
  //   * An `entry`/`project` pattern suffixed `!` is production; an unsuffixed
  //     one is development-only and production mode drops it. A workspace with no
  //     `project` keeps knip's default `**/*.{js,…}!`, which is production.
  //   * package.json `exports`/`main`/`bin` are production entries without any
  //     config, as are the module scripts a Vite `index.html` loads.
  //   * Plugin entries (Vitest/Playwright/Node test files, setup files, configs)
  //     are development-only, and so are the files only they reach.
  //   * Production mode reads only `dependencies`, never `devDependencies`.
  // Both runs use this one file; neither replaces the other.
  "workspaces": {
    // The ROOT workspace, declared explicitly (BST-1377).
    //
    // This block has to live here, in `workspaces`, and NOT at the top level of
    // this file. Measured on knip 6.32.2: top-level `entry`/`project` are the
    // DEFAULTS INHERITED BY WORKSPACES THAT DECLARE NONE — they are not the root
    // workspace's own scope. Every workspace below declares its own `project`, so
    // the old top-level `"e2e/**/*.ts"` patterns governed nothing at all and the
    // root workspace silently fell back to knip's default `**/*`: it claimed
    // every file in the repo that no other workspace owns. knip says so itself
    // ("Remove, or move unused top-level entry to workspace config"), and
    // negating patterns from the top level provably does nothing — `!spikes/**`
    // at the top level left every spike finding in place.
    //
    // That default `**/*` is what made knip grade foreign code:
    //   * `spikes/*` are throwaway prototypes deliberately OUTSIDE the pnpm
    //     workspace, each with its own package.json AND its own npm
    //     package-lock.json (docs/superpowers/plans/2026-08-03-changeset-discovery-spike.md:
    //     "NOT part of the pnpm workspace — use npm inside it, never add it to
    //     pnpm-workspace.yaml"). Their correctly-declared deps were reported as
    //     "unlisted" only because knip checked them against THIS repo's
    //     manifests, and their un-imported prototype sources as "unused files".
    //   * `docs/` is prose plus hand-wired hook scripts a human pastes into a
    //     hooks.json by absolute path — never imported by anything.
    // Neither is root-workspace source, so neither belongs in the root scope.
    //
    // The root workspace genuinely owns only the repo-root config files. Keep
    // these patterns at depth 1 — widening to `**` reinstates the fallback.
    //
    // `project` does not bound PLUGIN entries, though: the root's Vitest and
    // Node.js test-runner plugins add `**/*.test.*` and `**/test/**` (knip 6.41),
    // which still reach the spikes' own tests and grade their imports against
    // this repo's manifests — `ai` and `zod` in
    // spikes/m0-a1-qualification/original/s-dur/test/helpers.ts are declared in
    // spikes/m0-a1-qualification/package.json. Hence the `spikes/**` ignore.
    ".": {
      "entry": ["*.{js,mjs,cjs,ts,mts,cts}"],
      "project": ["*.{js,mjs,cjs,ts,mts,cts}"],
      "ignore": ["spikes/**"],
      "ignoreDependencies": [
        // scripts/react-compiler-inventory.mjs imports transformSync directly.
        // CLI scripts are outside the root graph; keep the exception root-only.
        "oxc-transform-react"
      ]
    },
    // Every package without a block of its own (knip picks ONE config key per
    // workspace: the deepest match, and a literal key beats a glob at the same
    // depth). The project is knip's default `**/*` as production code, minus
    // the `__tests__/` fixtures and helpers only test files reach. Default mode
    // drops `!pattern!` negations, so it still grades those files. The blocks
    // below that set no `project` of their own repeat these two patterns.
    "packages/*": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!"]
    },
    // Define workspaces based on the Turborepo setup
    "apps/web": {
      "entry": [
        // Production: index.html's module script src/entry.ts, which imports
        // ./configure-browser-runtime and ./main. knip's Vite plugin reads
        // index.html and adds that script as a production entry, so it is not
        // listed (knip hints a listed copy is redundant). The old "index.html"
        // and "src/main.tsx" entries are dropped: knip has no HTML compiler,
        // and entry.ts reaches main.tsx.
        // Production: the Vercel functions (vercel.json `functions: api/**/*.ts`).
        // They import src/app/api/assistant/route.ts and status/route.ts, so
        // those two are no longer listed as entries.
        "api/**/*.ts!",
        // Statically analysed instead of loaded; see the `playwright` block below.
        "playwright.config.mts"
      ],
      // playwright.config.mts throws at import unless BRAINSTRIKE_WEB_CHROMIUM_DIR
      // names a provisioned Chromium, and a config load error makes knip exit 2
      // whatever it finds. Skip loading it (knip known-issues: override `config`)
      // and name the specs its testDir/testMatch/testIgnore select.
      "playwright": {
        "config": [],
        "entry": ["e2e/**/*.test.ts", "!e2e/**/__tests__/**"]
      },
      "project": [
        "src/**/*.{ts,tsx}!", // Source files
        "api/**/*.ts!",
        // Build and dev-server code that only vite.config.mts loads, so not
        // shipped: its plugin list (canvas-frame-plugin; csp-utils' getDevCSP)
        // and the dev/preview assistant middleware `devChatApiPlugin` imports,
        // which uses assistant-stream-helpers and web-assistant-local-boundary.
        "!src/canvas-frame-plugin.ts!",
        "!src/csp-utils.ts!",
        "!src/server/assistant-api-middleware.ts!",
        "!src/server/web-assistant-local-boundary.ts!",
        "!src/assistant-stream-helpers.ts!",
        // STAGED HOSTED WEB MODULES, kept on purpose (owner decision, 19 Oct;
        // production mode only). #3754 is "step 5B" of web chat on the shared
        // log (BST-1940): its thread host is not mounted until the browser
        // writer ships with sqlite-wasm 3.54, so nothing in production constructs
        // these four files yet. The other two are the browser writer workers
        // (packages/web-state-store and packages/web-writer blocks). knip 6.41
        // ignores the `!` suffix on `ignoreFiles` (measured: all four were still
        // reported), so each workspace negates its files from the production
        // project, the mechanism the production-mode docs give.
        "!src/web-thread-host.ts!",
        "!src/web-host-thread.tsx!"
      ],
      "ignore": [
        // Keep specific ignores relevant to this app
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "**/*.stories.{ts,tsx}",
        "src/test/**/*.{ts,tsx}",
        "src/config/server.ts"
      ],
      // Production mode reads only the `start` script, which is `vite preview`
      // of the built dist; vite is a devDependency, and Vercel serves dist
      // (vercel.json). The suffix `!` limits this to production mode.
      "ignoreBinaries": ["vite!"],
      "ignoreDependencies": [
        // Production mode only (`!`): imported only by the staged Hosted Web
        // modules (STAGED HOSTED WEB MODULES below), web-thread-host.ts and
        // web-host-thread.tsx.
        "@brainstrike/host-conversation!",
        "@brainstrike/web-writer!",
        // Imported by src/app/globals.css via @import; CSS imports are not followed
        // by this workspace's TS/TSX project glob (knip 6.32.2).
        "@brainstrike/mcp-app-host-ui",
        // PGlite is the app's database engine. It is reached ONLY through
        // vite.config.mts — `optimizeDeps.include` prebundles it and a resolve
        // alias swaps its nodefs build for the OPFS one — never through an
        // import in src/. Those are bare strings in a config object, so no knip
        // config can attribute them: same class as the prebundles below.
        "@electric-sql/pglite",
        "@electric-sql/pglite-pgvector",
        "@fontsource-variable/geist", // Imported via CSS @import in globals.css
        "@fontsource-variable/geist-mono", // Imported via CSS @import in globals.css
        "@tailwindcss/typography", // Loaded via Tailwind v4 `@plugin` directive in src/app/globals.css (knip does not parse CSS)
        // App-owned prebundles for lazy assistant/database surfaces declared in build-utils optimizeDeps helpers
        "@assistant-ui/react",
        "@assistant-ui/react-streamdown",
        "@radix-ui/react-accordion",
        "@radix-ui/react-checkbox",
        "@radix-ui/react-dialog",
        "@radix-ui/react-scroll-area",
        "@radix-ui/react-tabs",
        "@radix-ui/react-toast",
        "@shikijs/langs",
        "@shikijs/themes",
        "idb",
        "jszip",
        "minimatch",
        "react-hotkeys-hook",
        "react-resizable-panels",
        "react-shiki",
        "remark-gfm",
        "shiki",
        "tiktoken",
        "xxhash-wasm"
      ],
      "typescript": {
        // Only add if you need to specify a non-default tsconfig location
        "config": "tsconfig.json"
      }
    },
    "apps/desktop": {
      // Production entries (`!`) are the esbuild entries in
      // scripts/build-main-config.mjs (MAIN_PROCESS_ENTRY_POINTS, plus the
      // agent-host platform and windows-command builds). Each ships as its own
      // dist/*.js that Electron, utilityProcess.fork or worker_threads loads BY
      // FILE NAME, so nothing in the module graph imports it. The renderer,
      // index.html's module script src/renderer/main.tsx, is a production entry
      // through knip's Vite plugin; its listed copy was redundant (knip hinted
      // so) and is dropped.
      "entry": [
        "src/main-bootstrap.ts!", // dist/main.js, package.json "main"
        "src/main.ts!", // Electron main process (dist/main-runtime.js)
        "src/desktop-bootstrap-runtime.ts!",
        "src/desktop-database-location.ts!",
        "src/desktop-env.ts!",
        "src/desktop-shutdown-state.ts!",
        "src/diagnostics/main-log-transport.ts!",
        "src/parser-host-entry.ts!",
        "src/agent-host-platform-entry.ts!", // AGENT_HOST_PLATFORM_BUILD_OPTIONS
        "src/preload.ts!", // Electron preload script
        "src/hidden-preload.ts!",
        // Freeze-watchdog worker_threads target. A REAL esbuild entry
        // (scripts/build-main-config.mjs MAIN_PROCESS_ENTRY_POINTS), shipped as
        // the flat `dist/main-watchdog-worker.js` that apps/desktop/package.json
        // unpacks beside app.asar and src/diagnostics/main-watchdog-path.ts
        // resolves by FILE NAME — it is deliberately never imported, so nothing
        // in the module graph reaches it. The build config that names it lives
        // under apps/desktop/scripts/, which the root `scripts/**/*` ignore hides
        // from knip. Contract: docs/agents/platform-contracts.md:1284.
        "src/diagnostics/main-watchdog-worker.ts!",
        // Official MCP conformance child-process entry. Like the watchdog, this
        // is a real build-main-config entry invoked by file name from the root
        // driver rather than imported by the desktop module graph.
        "src/official-conformance-client-entry.ts!",
        // Utility-process targets, also MAIN_PROCESS_ENTRY_POINTS; each is forked
        // by its built file name, never imported. The forking module:
        "src/agent-egress-entry.ts!", // src/browser/agent-browsing-route.ts
        "src/agent-host-entry.ts!", // src/host-lease-manager.ts
        "src/host-lease-entry.ts!", // src/host-lease-manager.ts
        "src/indexer-host-entry.ts!", // src/indexer-host-manager.ts
        "src/sqlite-query-host-entry.ts!", // src/sqlite-query-host-manager.ts
        // The Windows command wrapper, built by build-main-config.mjs's own
        // windows-command build and launched by file name from
        // src/assistant-server/run-skill-script-tool.ts.
        "src/windows-command-entry.ts!"
      ],
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      // Production mode reads only the `start` script, which runs the built app
      // with the electron devDependency; electron-builder packages the shipped
      // app. The suffix `!` limits this to production mode.
      "ignoreBinaries": ["electron!"],
      "ignoreDependencies": [
        // logs-page-content.test.tsx imports the real virtualizer inside its mock.
        // This workspace's production graph excludes tests; keep ownership local.
        "@tanstack/react-virtual",
        "electron-builder-squirrel-windows", // Required peer dependency for electron-builder Windows builds
        // Resolved at run time by src/assistant-server/lsp-diagnostics.ts through
        // `resolveLspModule` (a createRequire(...).resolve knip cannot follow) and
        // unpacked from app.asar by package.json `asarUnpack`.
        "typescript-language-server",
        // resolveBundledTsserverPath resolves this from the TypeScript compatibility
        // wrapper's scope. Build-config tests pin its runtime dependency and asar unpacking.
        "@typescript/old",
        // e2e/mcp-apps-production-lifecycle.desktop.test.ts resolves it from this
        // app with createRequire(import.meta.url).resolve, which knip cannot follow.
        "@modelcontextprotocol/ext-apps",
        "@vitest/coverage-v8", // Only used in vitest.config.mts, not imported in source code
        "@tailwindcss/typography", // Loaded via Tailwind v4 `@plugin` directive in src/renderer/styles.css (knip does not parse CSS)
        "xvfb-maybe", // Script binary in test:e2e* (invoked through scripts/run-env.mjs, which knip cannot resolve) + desktop-e2e.yml
        // Loaded through an INDIRECTED require in
        // scripts/start-agent-devtools-session.mjs: `initializeWindowsJob(platform,
        // load = require)` then `load('@brainstrike/windows-job-native')`. knip
        // resolves literal import/require specifiers only, never a require passed
        // as a parameter — and that file sits under the root `scripts/**/*` ignore
        // regardless. Same class as xvfb-maybe above.
        "@brainstrike/windows-job-native",
        // BST-1920: listed so electron-builder packages it, with better-sqlite3 and
        // sqlite-vec, into app.asar for the packaged provenance smoke
        // (packages/sqlite-native/test/packaged-smoke.cjs). Nothing imports it
        // until the indexer host lands; drop this entry with its first import.
        "@brainstrike/sqlite-native",
        "@fontsource-variable/geist", // Imported via CSS @import in renderer/styles.css
        "@fontsource-variable/geist-mono", // Imported via CSS @import in renderer/styles.css
        // App-owned prebundles for lazy assistant/database surfaces declared in build-utils optimizeDeps helpers
        "@assistant-ui/react",
        "@assistant-ui/react-streamdown",
        "@radix-ui/react-accordion",
        "@radix-ui/react-checkbox",
        "@radix-ui/react-dialog",
        "@radix-ui/react-scroll-area",
        "@radix-ui/react-tabs",
        "@radix-ui/react-toast",
        "@shikijs/langs",
        "@shikijs/themes",
        "idb",
        "jszip",
        "minimatch",
        "react-hotkeys-hook",
        "react-resizable-panels",
        "react-shiki",
        "remark-gfm",
        "shiki",
        "tiktoken",
        "xxhash-wasm"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "**/*.stories.{ts,tsx}"
      ],
      "ignoreDependencies": [
        // See packages/db: consumed as the relative source path
        // `../config/src/vitest-browser.ts` from vitest.config.mts, which knip
        // resolves to a file rather than to the package name.
        "@brainstrike/config"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/assistant-ui": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "**/*.stories.{ts,tsx}"
      ],
      "ignoreDependencies": [
        // Configuration/test-only imports are outside this project's production glob.
        "@brainstrike/config",
        "@brainstrike/context-actions",
        "react-shiki"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/agent-host": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!"],
      "entry": [
        // Worker thread: src/host-state-index.ts starts the built file with
        // `new Worker(new URL('host-state-index-worker.js', PACKAGE_DIST))`.
        "src/host-state-index-worker.ts",
        // The Windows `--platform` module the integration suites hand the CLI by
        // path (a platform-conditional knip cannot follow); it imports the
        // children platform.
        "__tests__/fixtures/process-platform-cooperative.mjs",
        // Recorders run by hand (`node <file> [output.json]`) to regenerate the
        // committed host-log fixtures the agent-host, assistant-ui and desktop
        // suites read.
        "__tests__/fixtures/record-*-log.mjs"
      ]
    },
    "packages/sqlite-query": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!"],
      "entry": [
        // The Node query host: src/process.ts forks the built file with
        // `new URL(transport === 'node' ? './query-host.js' : ..., import.meta.url)`,
        // a conditional knip cannot follow.
        "src/query-host.ts",
        // Index builders the integration suites and test/run-integration.mjs run by path.
        "src/__tests__/fixtures/build-*.mjs"
      ]
    },
    "packages/canonical-ingestion": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!"],
      // See packages/db: vitest.config.mts imports `../config/src/vitest-browser.ts`.
      "ignoreDependencies": ["@brainstrike/config"]
    },
    "packages/web-state-store": {
      "project": [
        "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
        "!**/__tests__/**!",
        // Staged Hosted Web module; see STAGED HOSTED WEB MODULES in apps/web.
        "!src/web-state-worker.ts!"
      ],
      // See packages/db: vitest.config.mts imports `../config/src/vitest-browser.ts`.
      "ignoreDependencies": ["@brainstrike/config"]
    },
    "packages/host-lease": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!"],
      // Loaded as `execArgv: ['--import', 'tsx']` by the processes the integration
      // suites fork, never imported. Same class as packages/state-store.
      "ignoreDependencies": ["tsx"]
    },
    "packages/host-capabilities": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!"],
      // Recorders run by hand (`node <file>`) to regenerate the committed
      // test-utils fixtures committed-host-hook-blocked.json and
      // committed-host-hooks-skipped.json, which agent-host, assistant-ui and
      // desktop suites read.
      "entry": ["__tests__/fixtures/record-*-log.mjs"]
    },
    "packages/indexer": {
      // scripts/build-process-entries.mjs is the package `build` step, not shipped code.
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!", "!scripts/**!"],
      // scoped-electron.integration.test.ts launches the Electron main fixture by
      // path; it starts the utility fixture with `utilityProcess.fork(path)`.
      "entry": [
        "__tests__/fixtures/scoped-electron-main.cjs",
        "__tests__/fixtures/scoped-electron-utility.cjs"
      ]
    },
    "packages/web-writer": {
      "project": [
        "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
        "!**/__tests__/**!",
        // Staged Hosted Web module; see STAGED HOSTED WEB MODULES in apps/web.
        "!src/web-writer-worker.ts!"
      ],
      // vitest.config.mts's worker-realm plugin prepends an import of this file,
      // by resolved path, to every worker module under test.
      "entry": ["src/__tests__/fixtures/vitest-worker-realm.ts"],
      // See packages/db: vitest.config.mts imports `../config/src/vitest-browser.ts`.
      "ignoreDependencies": ["@brainstrike/config"]
    },
    "packages/agent-evals": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!"],
      // The eval corpus, not package source. src/task.ts loads tasks/<id>/ as
      // data and src/sandbox.ts copies repo/ into a sandbox workspace, then
      // verify/ into <workspace>/.verify/, so a verifier's `../src/x.ts`
      // resolves inside the sandbox — some targets are files the agent must
      // create. tsconfig.json and vitest.config.mts exclude tasks/ likewise.
      "ignore": ["tasks/**"]
    },
    "packages/assistant-service": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!"],
      // Child processes the integration suites spawn by path
      // (`path.join(import.meta.dirname, 'fixtures/<file>')`); each imports
      // fixture-result.mjs.
      "entry": [
        "src/__tests__/fixtures/node-native-text-services.mjs",
        "src/__tests__/fixtures/node-workspace-native-child.mjs",
        "src/__tests__/fixtures/node-workspace-root-identity-child.mjs"
      ]
    },
    "packages/assistant-data": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/hooks": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/utils": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/types": {
      "project": ["src/**/*.ts!"],
      "ignore": [],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/config": {
      // Development entries (no `!`): Playwright and Vitest configs load them.
      "entry": [
        "src/playwright-environment.ts",
        "src/vitest-browser.ts"
      ],
      "project": ["**/*.{js,json,ts}!"],
      "ignore": [],
      "ignoreDependencies": ["playwright"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/app-shell": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // Used only in tests; app-shell excludes tests from knip project paths
        "@brainstrike/db",
        // No direct source import, but vitest.config.mts:118 aliases it to __mocks__/embeddings.ts so
        // transitive imports of the heavy embeddings runtime stay mocked in app-shell tests
        "@brainstrike/embeddings",
        // threads-panel and changed-files-tree tests vi.mock it; without app-shell's
        // own copy the mock misses @brainstrike/ui TreeTable's import (4 tests fail).
        "@tanstack/react-virtual"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-explorer": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-explorer-hooks": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-explorer-ui": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // Test-only virtualizer mock; excluded from the production source graph.
        "@tanstack/react-virtual",
        // Some suites opt into jsdom via file-level annotation
        "jsdom"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-system": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/storage": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // See packages/db: consumed as the relative source path
        // `../config/src/vitest-browser.ts` from vitest.config.mts, which knip
        // resolves to a file rather than to the package name.
        "@brainstrike/config"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/embedding-worker": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // See packages/db: consumed as the relative source path
        // `../config/src/vitest-browser.ts` from vitest.config.mts, which knip
        // resolves to a file rather than to the package name.
        "@brainstrike/config"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    // Native node-gyp addons. Their only consumer of `node-addon-api` is
    // binding.gyp — `<!@(node -p "require('node-addon-api').include")` — and knip
    // does not parse gyp files, so no entry/project glob can reach it.
    "packages/secure-fs-native": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!"],
      "ignoreDependencies": ["node-addon-api"]
    },
    "packages/windows-job-native": {
      // scripts/install.cjs is the `install` lifecycle step (`node-gyp rebuild`), not shipped code.
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!", "!scripts/**!"],
      "ignoreDependencies": ["node-addon-api"]
    },
    "packages/state-store": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "!**/__tests__/**!"],
      // Child processes the suites spawn by path (`node --import tsx <file>`,
      // `node <file>.mjs`): writers that are SIGKILLed, lock holders and racing
      // contenders, a read-only reader, the kernel-sync run and its attribution.
      // knip cannot follow a path handed to `spawn`, so they are entries.
      "entry": ["__tests__/fixtures/*.ts", "__tests__/kill/*.{ts,mjs}", "__tests__/kernel-sync/*.{ts,mjs}"],
      // Loaded as `--import tsx` in those spawned processes, never imported.
      "ignoreDependencies": ["tsx"],
      // The Linux tracer of the opt-in kernel-sync suite, found at run time.
      "ignoreBinaries": ["strace"]
    },
    "packages/app-state": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/settings-ui": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/test-utils": {
      // Development entries (no `!`): test configs and suites load them.
      "entry": [
        "src/test-timeouts.ts", // Used by vitest configs across the monorepo
        "src/playwright/failure-artifacts.ts",
        "src/vitest.setup.ts"
      ],
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "ignoreDependencies": [
        // Used via dynamic require in render-with-providers.tsx
        "@testing-library/react",
        // Optional peer used only for the playwright test helpers export
        "@playwright/test"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/workers": {
      "entry": ["file-content-worker.ts!"],
      "project": ["*.{ts,tsx}!"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/embeddings": {
      "entry": [
        // Explicit entrypoints including CLI
        "src/index.ts!",
        "src/cli/embed-code.ts!"
      ],
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "**/__benchmarks__/**",
        "**/*.bench.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-import": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // React is a peer dependency for the hooks/components; knip treats it as optional
        "react"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/db": {
      "entry": [
        // Development entry (no `!`): the root `pnpm queue` script runs it, and
        // production mode honours only a package's `start` script.
        "src/cli/queue-cli.ts" // CLI entry point used via pnpm queue script
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        // Development tooling that lives in src/ but does not ship. Production
        // mode only; default mode still grades these files.
        // - The `eval:retrieval` CLI (src/evaluation/retrieval-eval-cli.ts) and
        //   the runners and golden sets it shares with the search-*-eval and
        //   retrieval-* tests.
        "!src/evaluation/**!",
        // - The db:schema:catalog, db:schema:ddl and db:schema:dump scripts, and
        //   current-schema-catalog.integration.test.ts.
        "!src/schema-snapshot/introspect.ts!",
        // - `bench:hybrid-search` (scripts/benchmark-hybrid-search.ts) and the two
        //   benchmark tests; docs/performance/hybrid-search-benchmarks.md.
        "!src/search/hybrid-search-benchmark.ts!",
        "!src/search/pglite-hybrid-search-benchmark.ts!",
        // - QUALIFIED_PG_TEXTSEARCH_VERSION, which the pg-textsearch durability
        //   gate and current-schema-catalog integration tests pin. Moving it into
        //   __tests__/ would add an unchecked test file, which the test-program
        //   debt guard (scripts/test-program-debt.json) refuses.
        "!src/pg-textsearch-compatibility.ts!"
      ],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "ignoreDependencies": [
        "esbuild", // Pulled indirectly by vite-plugin-wasm / vitest tooling in this workspace
        // Consumed by vitest.config.mts as `../config/src/vitest-browser.ts` — a
        // RELATIVE path into the sibling workspace's SOURCE, deliberately, so the
        // test lane needs no built dist of @brainstrike/config. knip resolves that
        // to a file, not to the package name, so it cannot credit the declaration.
        // The declaration still states the real workspace dependency; do not drop it.
        "@brainstrike/config"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/platform-utils": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/mcp-test-lab": {
      // verify:mcp -> scripts/run-mcp-verification.mjs -> package verify invokes this built CLI by path.
      "entry": ["src/runner-cli.ts!", "__tests__/**/*.test.ts"],
      "project": [
        "src/**/*.ts!",
        "__tests__/**/*.test.ts"
      ],
      "ignoreDependencies": [
        // Exact-pinned official runner provenance. The bounded conformance lane
        // consumes its CLI/package entry rather than importing it from src/.
        "@modelcontextprotocol/conformance"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/effect-kit": {
      "project": ["src/**/*.ts!"],
      "ignore": ["**/__tests__/**", "**/*.test.ts"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/context-actions": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/workspace-search": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // Test-only virtualizer mock; excluded from the production source graph.
        "@tanstack/react-virtual",
        // vitest.config.mts:10 loads ../test-utils/src/vitest.setup.ts; the dep pins that workspace version
        "@brainstrike/test-utils"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/chunking-worker": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        // Manually-run benchmark harnesses, documented reproducers in docs/bench-chunking-*.md
        "bench/**"
      ],
      "ignoreDependencies": [
        // Bundled via tsup.config.ts noExternal; wasm subpath declared in src/types/wasm.d.ts
        "tiktoken"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-tree-worker": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        // Real Vite renderer entry: both app vite configs alias @brainstrike/file-tree-worker to this
        // file (apps/web + apps/desktop vite.config.mts) — knip cannot follow the alias
        "src/vite.ts"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/agent": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignoreDependencies": [
        // Hosted bundling inlines workspace logging/tokenization. Their native
        // loaders remain external and resolve from agent, not their source owner.
        // verify-hosted-web-bundle loads that real artifact; manifest tests pin ownership.
        "pino",
        "tiktoken"
      ],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "script.js" // Mock MCP server script for tests
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/token-cache": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // jsdom is provided by Vitest for environment: 'jsdom' in vitest.config.mts
        "jsdom",
        // react is an optional peerDependency that IS used by the hooks - Knip flags it incorrectly
        "react",
        // Bundled inline via tsup.config.ts noExternal (reached through the @brainstrike/utils graph)
        "@brainstrike/text-splitter",
        // Bundled via tsup noExternal; wasm subpath declared in src/types/wasm.d.ts, loaded dynamically
        "tiktoken"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    }
  },
  // NOTE: no top-level `entry`/`project` here on purpose — see the `"."`
  // workspace block above for why the root scope must be declared there.
  // Global ignores applicable across all workspaces
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.turbo/**",
    "**/*.d.ts",
    // react-doctor auto-discovers doctor.config.ts by convention (`pnpm run react-doctor` + react-doctor.yml)
    "doctor.config.ts",
    // Ignore Playwright merge config - used by CI workflows via shell commands
    "playwright-merge.config.js",
    // Ignore all scripts - utility scripts run directly, not imported
    "scripts/**/*",
    // Ignore entire .claude directory - hooks, scripts, and skills are executed via CLI, not imported
    ".claude/**/*",
    // Browser-targeted Vite aliases for Node builtins are consumed indirectly via build-utils helpers
    "packages/build-utils/src/browser-node-stubs/child-process.ts",
    "packages/build-utils/src/browser-node-stubs/os.ts",
    "packages/build-utils/src/browser-node-stubs/worker-threads.ts"
  ],
  // Keep existing global settings
  "ignoreBinaries": [
    "sed", // System binary used in package.json scripts
    "unset" // Shell builtin used in desktop e2e convenience scripts
  ],
  "ignoreDependencies": [
    // These might need re-evaluation after running Knip
    "@babel/core",
    "identity-obj-proxy", // Likely used for test mocking
    "tailwindcss", // Likely used via PostCSS, might be flagged
    "@commitlint/cli", // Used with commitlint.config.ts but no hooks yet
    "@vitejs/plugin-react", // Only used in Vite config
    "babel-plugin-react-compiler", // Resolved indirectly by reactCompilerPreset in Vite config
    "@mermaid-js/mermaid-cli", // Used in .claude/skills/mermaid-diagrams/scripts/validate-mermaid.mjs
    "yauzl", // Satisfies @puppeteer/browsers' optional yauzl peer (reached only via @mermaid-js/mermaid-cli -> puppeteer) so Chrome extraction without `unzip` doesn't fall back to the hoisted yauzl@2.10.0, whose read streams never close (thejoshwolfe/yauzl#169)
    "mermaid", // Used in .claude/skills/mermaid-diagrams/scripts/ (validate-mermaid.mjs and test-one-diagram.mjs)
    "@jacobwolf/biome-unnecessary-effect", // Biome plugin used in biome.json for React useEffect linting
    "react-doctor", // CI/lint tool run via `pnpm run react-doctor` + the react-doctor.yml workflow, never imported
    // The Effect language-service tsconfig plugin NAME, not a package: knip's
    // TypeScript plugin reads every `compilerOptions.plugins[].name` as a
    // dependency, but the pinned `@effect/tsgo` binary embeds the service and
    // reads this entry by name (its README "Plugin Options"); nothing installs
    // or imports a package of this name. scripts/__tests__/effect-boundary-contract.test.mjs
    // asserts every Effect consumer declares `@effect/tsgo` and resolves the plugin.
    "@effect/language-service"
  ],
  "ignoreExportsUsedInFile": true,
  // Unused exports and exported types are graded by PRODUCTION mode only (BST-2071).
  // The default run credits every test import, so an export only a test uses
  // looks alive there; `knip:production` re-includes both types with `--include`,
  // and the liveness probe proves it reports a test-only export.
  //
  // These were `rules: { exports: "off", types: "off" }` "due to false positives"
  // (knip 6 split type-only exports into `types` at the 6.24 -> 6.32 bump). A rule
  // that is "off" drops the issue type in every mode, and no CLI flag can
  // re-include it; an `exclude` filter is overridden by `--include`.
  "exclude": ["exports", "types"],
  "rules": {
    "duplicates": "off" // Keep user's rule setting
  }
}
