{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    // Define workspaces based on the Turborepo setup
    "apps/web": {
      "entry": [
        "index.html", // Entry for the web app
        "src/main.tsx", // Main entry point
        "vite.config.mts", // Vite config for web app
        "vitest.setup.ts",
        "playwright.config.ts",
        "src/test/**/*.{ts,tsx}",
        "src/config/server.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}", // Source files
        "tests/**/*.{ts,tsx}" // App-specific tests (if any separate from src)
      ],
      "ignore": [
        // Keep specific ignores relevant to this app
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "**/*.stories.{ts,tsx}",
        "src/test/**/*.{ts,tsx}",
        "src/config/server.ts"
      ],
      "ignoreDependencies": [],
      "typescript": {
        // Only add if you need to specify a non-default tsconfig location
        "config": "tsconfig.json"
      }
    },
    "packages/ui": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "**/*.stories.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/hooks": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/utils": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/types": {
      "project": ["src/**/*.ts"],
      "ignore": [],
      "ignoreDependencies": [
        // Implicitly used by test/build runners?
        "@swc/core"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/config": {
      "project": ["**/*.{js,json,ts}"],
      "ignore": [],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/app-shell": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-explorer": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-explorer-hooks": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-explorer-ui": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-system": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/storage": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/server-config": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/test-utils": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/fonts": {
      "entry": [
        "src/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [],
      "typescript": {
        "config": "tsconfig.json"
      }
    }
  },
  // Root level entries and projects, e.g., for tests/configs not tied to a specific workspace
  "entry": [
    "e2e/**/*.ts", // Keep root E2E as requested for now
    "vitest.workspace.ts" // Add the vitest workspace file as an entry point
  ],
  "project": [
    "e2e/**/*.ts" // Keep root E2E project files
  ],
  // Global ignores applicable across all workspaces
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.turbo/**",
    "**/*.d.ts",
    // Ignore husky hook file
    ".husky/commit-msg.js"
    // Removed specific file ignores from here as they are moved to apps/web workspace ignore
  ],
  // Keep existing global settings
  "ignoreBinaries": [
  ],
  "ignoreDependencies": [
    // These might need re-evaluation after running Knip
    "@monaco-editor/react",
    "monaco-editor",
    "dompurify",
    "@babel/core",
    "@types/testing-library__jest-dom", // Likely used by root or app vitest.setup.ts
    "glob",
    "husky",
    "identity-obj-proxy", // Likely used for test mocking
    "tailwindcss", // Likely used via PostCSS, might be flagged
    "ts-node", // Likely used for scripts/configs
    "@commitlint/cli", // Used with commitlint.config.ts but no hooks yet
    "@vitejs/plugin-react", // Only used in Vite config
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off" // Keep user's rule setting
  }
} 
