{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    // The ROOT workspace, declared explicitly (BST-1377).
    //
    // This block has to live here, in `workspaces`, and NOT at the top level of
    // this file. Measured on knip 6.32.2: top-level `entry`/`project` are the
    // DEFAULTS INHERITED BY WORKSPACES THAT DECLARE NONE — they are not the root
    // workspace's own scope. Every workspace below declares its own `project`, so
    // the old top-level `"e2e/**/*.ts"` patterns governed nothing at all and the
    // root workspace silently fell back to knip's default `**/*`: it claimed
    // every file in the repo that no other workspace owns. knip says so itself
    // ("Remove, or move unused top-level entry to workspace config"), and
    // negating patterns from the top level provably does nothing — `!spikes/**`
    // at the top level left every spike finding in place.
    //
    // That default `**/*` is what made knip grade foreign code:
    //   * `spikes/*` are throwaway prototypes deliberately OUTSIDE the pnpm
    //     workspace, each with its own package.json AND its own npm
    //     package-lock.json (docs/superpowers/plans/2026-08-03-changeset-discovery-spike.md:
    //     "NOT part of the pnpm workspace — use npm inside it, never add it to
    //     pnpm-workspace.yaml"). Their correctly-declared deps were reported as
    //     "unlisted" only because knip checked them against THIS repo's
    //     manifests, and their un-imported prototype sources as "unused files".
    //   * `docs/` is prose plus hand-wired hook scripts a human pastes into a
    //     hooks.json by absolute path — never imported by anything.
    // Neither is root-workspace source, so neither belongs in the root scope.
    //
    // The root workspace genuinely owns only the repo-root config files. Keep
    // these patterns at depth 1 — widening to `**` reinstates the fallback.
    ".": {
      "entry": ["*.{js,mjs,cjs,ts,mts,cts}"],
      "project": ["*.{js,mjs,cjs,ts,mts,cts}"],
      "ignoreDependencies": [
        // scripts/react-compiler-inventory.mjs imports transformSync directly.
        // CLI scripts are outside the root graph; keep the exception root-only.
        "oxc-transform-react"
      ]
    },
    // Define workspaces based on the Turborepo setup
    "apps/web": {
      "entry": [
        "index.html", // Entry for the web app
        "src/main.tsx", // Main entry point
        "src/app/api/assistant/route.ts", // Assistant API route
        "src/app/api/assistant/status/route.ts" // Assistant status API route
      ],
      "project": [
        "src/**/*.{ts,tsx}" // Source files
      ],
      "ignore": [
        // Keep specific ignores relevant to this app
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "**/*.stories.{ts,tsx}",
        "src/test/**/*.{ts,tsx}",
        "src/config/server.ts"
      ],
      "ignoreDependencies": [
        // Imported by src/app/globals.css via @import; CSS imports are not followed
        // by this workspace's TS/TSX project glob (knip 6.32.2).
        "@brainstrike/mcp-app-host-ui",
        // PGlite is the app's database engine. It is reached ONLY through
        // vite.config.mts — `optimizeDeps.include` prebundles it and a resolve
        // alias swaps its nodefs build for the OPFS one — never through an
        // import in src/. Those are bare strings in a config object, so no knip
        // config can attribute them: same class as the prebundles below.
        "@electric-sql/pglite",
        "@electric-sql/pglite-pgvector",
        "@fontsource-variable/geist", // Imported via CSS @import in globals.css
        "@fontsource-variable/geist-mono", // Imported via CSS @import in globals.css
        "@tailwindcss/typography", // Loaded via Tailwind v4 `@plugin` directive in src/app/globals.css (knip does not parse CSS)
        // App-owned prebundles for lazy assistant/database surfaces declared in build-utils optimizeDeps helpers
        "@assistant-ui/react",
        "@assistant-ui/react-markdown",
        "@assistant-ui/styles",
        "@radix-ui/react-accordion",
        "@radix-ui/react-checkbox",
        "@radix-ui/react-dialog",
        "@radix-ui/react-scroll-area",
        "@radix-ui/react-tabs",
        "@radix-ui/react-toast",
        "@shikijs/langs",
        "@shikijs/themes",
        "idb",
        "jszip",
        "minimatch",
        "react-hotkeys-hook",
        "react-resizable-panels",
        "react-shiki",
        "remark-gfm",
        "shiki",
        "tiktoken",
        "xxhash-wasm"
      ],
      "typescript": {
        // Only add if you need to specify a non-default tsconfig location
        "config": "tsconfig.json"
      }
    },
    "apps/desktop": {
      "entry": [
        "src/main.ts", // Electron main process
        "src/preload.ts", // Electron preload script
        "src/renderer/main.tsx", // Renderer entry point
        // Freeze-watchdog worker_threads target. A REAL esbuild entry
        // (scripts/build-main-config.mjs MAIN_PROCESS_ENTRY_POINTS), shipped as
        // the flat `dist/main-watchdog-worker.js` that apps/desktop/package.json
        // unpacks beside app.asar and src/diagnostics/main-watchdog-path.ts
        // resolves by FILE NAME — it is deliberately never imported, so nothing
        // in the module graph reaches it. The build config that names it lives
        // under apps/desktop/scripts/, which the root `scripts/**/*` ignore hides
        // from knip. Contract: docs/agents/platform-contracts.md:1284.
        "src/diagnostics/main-watchdog-worker.ts",
        // Official MCP conformance child-process entry. Like the watchdog, this
        // is a real build-main-config entry invoked by file name from the root
        // driver rather than imported by the desktop module graph.
        "src/official-conformance-client-entry.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        "electron-builder-squirrel-windows", // Required peer dependency for electron-builder Windows builds
        "@effect/language-service", // Effect language-service plugin name, not a package; see packages/effect-kit
        "@vitest/coverage-v8", // Only used in vitest.config.mts, not imported in source code
        "@tailwindcss/typography", // Loaded via Tailwind v4 `@plugin` directive in src/renderer/styles.css (knip does not parse CSS)
        "xvfb-maybe", // Script binary in test:e2e* (invoked through scripts/run-env.mjs, which knip cannot resolve) + desktop-e2e.yml
        // Loaded through an INDIRECTED require in
        // scripts/start-agent-devtools-session.mjs: `initializeWindowsJob(platform,
        // load = require)` then `load('@brainstrike/windows-job-native')`. knip
        // resolves literal import/require specifiers only, never a require passed
        // as a parameter — and that file sits under the root `scripts/**/*` ignore
        // regardless. Same class as xvfb-maybe above.
        "@brainstrike/windows-job-native",
        // BST-1920: listed so electron-builder packages it, with better-sqlite3 and
        // sqlite-vec, into app.asar for the packaged provenance smoke
        // (packages/sqlite-native/test/packaged-smoke.cjs). Nothing imports it
        // until the indexer host lands; drop this entry with its first import.
        "@brainstrike/sqlite-native",
        "@fontsource-variable/geist", // Imported via CSS @import in renderer/styles.css
        "@fontsource-variable/geist-mono", // Imported via CSS @import in renderer/styles.css
        // App-owned prebundles for lazy assistant/database surfaces declared in build-utils optimizeDeps helpers
        "@assistant-ui/react",
        "@assistant-ui/react-markdown",
        "@assistant-ui/styles",
        "@radix-ui/react-accordion",
        "@radix-ui/react-checkbox",
        "@radix-ui/react-dialog",
        "@radix-ui/react-scroll-area",
        "@radix-ui/react-tabs",
        "@radix-ui/react-toast",
        "@shikijs/langs",
        "@shikijs/themes",
        "idb",
        "jszip",
        "minimatch",
        "react-hotkeys-hook",
        "react-resizable-panels",
        "react-shiki",
        "remark-gfm",
        "shiki",
        "tiktoken",
        "xxhash-wasm"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "**/*.stories.{ts,tsx}"
      ],
      "ignoreDependencies": [
        // See packages/db: consumed as the relative source path
        // `../config/src/vitest-browser.ts` from vitest.config.mts, which knip
        // resolves to a file rather than to the package name.
        "@brainstrike/config"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/assistant-ui": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "**/*.stories.{ts,tsx}"
      ],
      "ignoreDependencies": [
        // Configuration/test-only imports are outside this project's production glob.
        "@brainstrike/config",
        "@brainstrike/context-actions",
        "react-shiki"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/assistant-contract": {
      "ignoreDependencies": [
        // Effect language-service plugin name, not a package; see packages/effect-kit.
        "@effect/language-service"
      ]
    },
    "packages/assistant-data": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/hooks": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/utils": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/types": {
      "project": ["src/**/*.ts"],
      "ignore": [],
      "ignoreDependencies": [
        // Implicitly used by test/build runners?
        "@swc/core"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/config": {
      "entry": [
        "src/playwright-environment.ts",
        "src/vitest-browser.ts"
      ],
      "project": ["**/*.{js,json,ts}"],
      "ignore": [],
      "ignoreDependencies": ["playwright"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/app-shell": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // Used only in tests; app-shell excludes tests from knip project paths
        "@brainstrike/db",
        // No direct source import, but vitest.config.mts:118 aliases it to __mocks__/embeddings.ts so
        // transitive imports of the heavy embeddings runtime stay mocked in app-shell tests
        "@brainstrike/embeddings"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-explorer": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-explorer-hooks": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-explorer-ui": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // Some suites opt into jsdom via file-level annotation
        "jsdom"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-system": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/storage": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // See packages/db: consumed as the relative source path
        // `../config/src/vitest-browser.ts` from vitest.config.mts, which knip
        // resolves to a file rather than to the package name.
        "@brainstrike/config"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/embedding-worker": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // See packages/db: consumed as the relative source path
        // `../config/src/vitest-browser.ts` from vitest.config.mts, which knip
        // resolves to a file rather than to the package name.
        "@brainstrike/config"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    // Native node-gyp addons. Their only consumer of `node-addon-api` is
    // binding.gyp — `<!@(node -p "require('node-addon-api').include")` — and knip
    // does not parse gyp files, so no entry/project glob can reach it.
    "packages/secure-fs-native": {
      "ignoreDependencies": ["node-addon-api"]
    },
    "packages/windows-job-native": {
      "ignoreDependencies": ["node-addon-api"]
    },
    "packages/state-store": {
      // Child processes the suites spawn by path (`node --import tsx <file>`,
      // `node <file>.mjs`): writers that are SIGKILLed, lock holders and racing
      // contenders, a read-only reader, the kernel-sync run and its attribution.
      // knip cannot follow a path handed to `spawn`, so they are entries.
      "entry": ["__tests__/fixtures/*.ts", "__tests__/kill/*.{ts,mjs}", "__tests__/kernel-sync/*.{ts,mjs}"],
      // Loaded as `--import tsx` in those spawned processes, never imported.
      "ignoreDependencies": ["tsx"],
      // The Linux tracer of the opt-in kernel-sync suite, found at run time.
      "ignoreBinaries": ["strace"]
    },
    "packages/app-state": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/settings-ui": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/test-utils": {
      "entry": [
        "src/test-timeouts.ts", // Used by vitest configs across the monorepo
        "src/playwright/failure-artifacts.ts",
        "src/vitest.setup.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "ignoreDependencies": [
        // Used via dynamic require in render-with-providers.tsx
        "@testing-library/react",
        // Optional peer used only for the playwright test helpers export
        "@playwright/test"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/workers": {
      "entry": ["file-content-worker.ts"],
      "project": ["*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/embeddings": {
      "entry": [
        // Explicit entrypoints including CLI
        "src/index.ts",
        "src/cli/embed-code.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "**/__benchmarks__/**",
        "**/*.bench.{ts,tsx}"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-import": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // React is a peer dependency for the hooks/components; knip treats it as optional
        "react"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/db": {
      "entry": [
        "src/cli/queue-cli.ts" // CLI entry point used via pnpm queue script
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "vitest.mutation.config.ts", // Used by Stryker mutation testing
        "stryker.config.js" // Mutation testing config
      ],
      "ignoreDependencies": [
        "esbuild", // Pulled indirectly by vite-plugin-wasm / vitest tooling in this workspace
        // Consumed by vitest.config.mts as `../config/src/vitest-browser.ts` — a
        // RELATIVE path into the sibling workspace's SOURCE, deliberately, so the
        // test lane needs no built dist of @brainstrike/config. knip resolves that
        // to a file, not to the package name, so it cannot credit the declaration.
        // The declaration still states the real workspace dependency; do not drop it.
        "@brainstrike/config",
        // Effect language-service plugin name, not a package; see packages/effect-kit.
        "@effect/language-service"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/platform-utils": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/mcp-test-lab": {
      "entry": ["__tests__/**/*.test.ts"],
      "project": [
        "src/**/*.ts",
        "__tests__/**/*.test.ts"
      ],
      "ignoreDependencies": [
        // Exact-pinned official runner provenance. The bounded conformance lane
        // consumes its CLI/package entry rather than importing it from src/.
        "@modelcontextprotocol/conformance"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/effect-kit": {
      "project": ["src/**/*.ts"],
      "ignore": ["**/__tests__/**", "**/*.test.ts"],
      "ignoreDependencies": [
        // The Effect language-service tsconfig plugin NAME, not a package: the
        // pinned `@effect/tsgo` binary resolves it in its dedicated diagnostics
        // mode (docs/agents/effect-boundary.md § "Effect diagnostics"). Every
        // Effect package carries the same entry.
        "@effect/language-service"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/context-actions": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/workspace-search": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // vitest.config.mts:10 loads ../test-utils/src/vitest.setup.ts; the dep pins that workspace version
        "@brainstrike/test-utils"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/chunking-worker": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        // Manually-run benchmark harnesses, documented reproducers in docs/bench-chunking-*.md
        "bench/**"
      ],
      "ignoreDependencies": [
        // Bundled via tsup.config.ts noExternal; wasm subpath declared in src/types/wasm.d.ts
        "tiktoken",
        // Effect language-service plugin name, not a package; see packages/effect-kit.
        "@effect/language-service"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/file-tree-worker": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        // Real Vite renderer entry: both app vite configs alias @brainstrike/file-tree-worker to this
        // file (apps/web + apps/desktop vite.config.mts) — knip cannot follow the alias
        "src/vite.ts"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/agent": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        // Hosted bundling inlines workspace logging/tokenization. Their native
        // loaders remain external and resolve from agent, not their source owner.
        // verify-hosted-web-bundle loads that real artifact; manifest tests pin ownership.
        "pino",
        "tiktoken"
      ],
      "ignore": [
        "**/__tests__/**",
        "**/*.test.{ts,tsx}",
        "script.js" // Mock MCP server script for tests
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    },
    "packages/token-cache": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["**/__tests__/**", "**/*.test.{ts,tsx}"],
      "ignoreDependencies": [
        // jsdom is provided by Vitest for environment: 'jsdom' in vitest.config.mts
        "jsdom",
        // react is an optional peerDependency that IS used by the hooks - Knip flags it incorrectly
        "react",
        // Bundled inline via tsup.config.ts noExternal (reached through the @brainstrike/utils graph)
        "@brainstrike/text-splitter",
        // Bundled via tsup noExternal; wasm subpath declared in src/types/wasm.d.ts, loaded dynamically
        "tiktoken"
      ],
      "typescript": {
        "config": "tsconfig.json"
      }
    }
  },
  // NOTE: no top-level `entry`/`project` here on purpose — see the `"."`
  // workspace block above for why the root scope must be declared there.
  // Global ignores applicable across all workspaces
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.turbo/**",
    "**/*.d.ts",
    // react-doctor auto-discovers doctor.config.ts by convention (`pnpm run react-doctor` + react-doctor.yml)
    "doctor.config.ts",
    // Ignore Playwright merge config - used by CI workflows via shell commands
    "playwright-merge.config.js",
    // Ignore all scripts - utility scripts run directly, not imported
    "scripts/**/*",
    // Ignore entire .claude directory - hooks, scripts, and skills are executed via CLI, not imported
    ".claude/**/*",
    // Browser-targeted Vite aliases for Node builtins are consumed indirectly via build-utils helpers
    "packages/build-utils/src/browser-node-stubs/child-process.ts",
    "packages/build-utils/src/browser-node-stubs/os.ts",
    "packages/build-utils/src/browser-node-stubs/worker-threads.ts"
  ],
  // Keep existing global settings
  "ignoreBinaries": [
    "sed", // System binary used in package.json scripts
    "unset" // Shell builtin used in desktop e2e convenience scripts
  ],
  "ignoreDependencies": [
    // These might need re-evaluation after running Knip
    "dompurify",
    "@babel/core",
    "identity-obj-proxy", // Likely used for test mocking
    "tailwindcss", // Likely used via PostCSS, might be flagged
    "@commitlint/cli", // Used with commitlint.config.ts but no hooks yet
    "@vitejs/plugin-react", // Only used in Vite config
    "babel-plugin-react-compiler", // Resolved indirectly by reactCompilerPreset in Vite config
    // NOTE (BST-1273, knip 6.32.2): the original justification — "used for JSDoc type
    // annotations in stryker.config.js" — is obsolete. knip's Stryker plugin resolves that use
    // natively, so any package carrying an `import('@stryker-mutator/api/core')` JSDoc tag is
    // NOT flagged without this entry.
    // UPDATED (Stryker mutation-lane unbreak): that PR added the tag to file-explorer-hooks,
    // hooks, test-utils and utils, so this entry now masks exactly ONE package — file-explorer
    // declares the dep and never references it. Measured by dropping the entry: the sole
    // finding is `@stryker-mutator/api packages/file-explorer/package.json`. Deleting THAT
    // declaration is the actual fix; do NOT delete the others, whose tags need the dep.
    // Also measured: this entry filters unlisted-import findings too, so it would hide a tag
    // added without a declaration — keep tag and declaration together.
    "@stryker-mutator/api",
    "@mermaid-js/mermaid-cli", // Used in .claude/skills/mermaid-diagrams/scripts/validate-mermaid.mjs
    "mermaid", // Used in .claude/skills/mermaid-diagrams/scripts/ (validate-mermaid.mjs and test-one-diagram.mjs)
    "@tanstack/react-table", // Used in packages/settings-ui for LogViewerCard table component
    "@tanstack/react-virtual", // Used in packages/settings-ui for row virtualization
    "@jacobwolf/biome-unnecessary-effect", // Biome plugin used in biome.json for React useEffect linting
    "react-doctor" // CI/lint tool run via `pnpm run react-doctor` + the react-doctor.yml workflow, never imported
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off", // Keep user's rule setting
    "exports": "off", // Disable export checking for now due to false positives
    // knip 6 splits type-only exports out of `exports` into their own `types` rule, so the
    // 6.24 -> 6.32 bump surfaced 34 "unused exported types" that `exports: off` used to cover.
    // They are the same false-positive class (public barrel re-exports consumed across package
    // boundaries), so this tracks the existing `exports` decision rather than making a new one.
    "types": "off"
  }
}
